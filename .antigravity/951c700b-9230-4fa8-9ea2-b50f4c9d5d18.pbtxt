    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  Mail,\n  Sparkles,\n  CheckCircle2,\n  AlertCircle,\n  Clock,\n  Send,\n  Building,\n  ChevronRight,\n  RefreshCw,\n  FileText,\n  Plus\n} from \'lucide-react\';\nimport { EmailEvent } from \'../types\';\n\ninterface EmailMonitorViewProps {\n  emails: EmailEvent[];\n  onSimulateEmail: (type: \'interview\' | \'rejection\' | \'offer\' | \'screening\', company?: string) => Promise<void>;\n  onProcessRawEmail: (raw: { sender: string; recipient: string; subject: string; body: string }) => Promise<void>;\n  onOpenApplication?: (appId: string) => void;\n}\n\nexport const EmailMonitorView: React.FC<EmailMonitorViewProps> = ({\n  emails,\n  onSimulateEmail,\n  onProcessRawEmail,\n  onOpenApplication,\n}) => {\n  const [selectedEmail, setSelectedEmail] = useState<EmailEvent | null>(\n    emails.length > 0 ? emails[0] : null\n  );\n  const [isSimulating, setIsSimulating] = useState(false);\n  const [showRawTester, setShowRawTester] = useState(false);\n  const [rawSender, setRawSender] = useState(\'recruiting@stripe.com\');\n  const [rawSubject, setRawSubject] = useState(\'Next steps for Senior Backend Engineer role\');\n  const [rawBody, setRawBody] = useState(\n    \'Hi Alex,\\n\\nWe were really impressed with your application and would like to schedule a 45-minute technical screen with our backend team.\\n\\nPlease pick a slot here: https://calendly.com/stripe-eng/alex\\n\\nBest,\\nStripe Recruiting\'\n  );\n\n  const handleSimulate = async (type: \'interview\' | \'rejection\' | \'offer\' | \'screening\') => {\n    setIsSimulating(true);\n    try {\n      await onSimulateEmail(type);\n    } finally {\n      setIsSimulating(false);\n    }\n  };\n\n  const handleProcessRaw = async () => {\n    setIsSimulating(true);\n    try {\n      await onProcessRawEmail({\n        sender: rawSender,\n        recipient: \'alex.morgan.dev@example.com\',\n        subject: rawSubject,\n        body: rawBody,\n      });\n      setShowRawTester(false);\n    } finally {\n      setIsSimulating(false);\n    }\n  };\n\n  return (\n    <div className=\"space-y-6 animate-in fade-in duration-300\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <Mail className=\"w-5 h-5 text-indigo-400\" />\n            <h1 className=\"text-xl sm:text-2xl font-bold text-white tracking-tight\">\n              Recruiter Email Monitor & Classifier\n            </h1>\n          </div>\n          <p className=\"text-xs text-slate-400 mt-0.5\">\n            Monitors incoming recruiter emails with Gemini classification and automatically syncs application stages.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2 flex-wrap\">\n          <button\n            onClick={() => setShowRawTester(!showRawTester)}\n            className=\"flex items-center gap-1.5 px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold transition-colors\"\n          >\n            <Plus className=\"w-3.5 h-3.5\" />\n            <span>Test Custom Email</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Simulator Quick Action Banner */}\n      <div className=\"p-4 rounded-xl bg-slate-900 border border-slate-800 space-y-2\">\n        <div className=\"flex items-center justify-between\">\n          <span className=\"text-xs font-bold text-slate-300 flex items-center gap-1.5\">\n            <Sparkles className=\"w-3.5 h-3.5 text-indigo-400\" />\n            Simulate Recruiter Inbound Email Event\n          </span>\n          <span className=\"text-[11px] text-slate-500\">Triggers AI classification & pipeline status sync</span>\n        </div>\n\n        <div className=\"flex items-center gap-2.5 flex-wrap pt-1\">\n          <button\n            id=\"simulate-interview-email-btn\"\n            onClick={() => handleSimulate(\'interview\')}\n            disabled={isSimulating}\n            className=\"px-3 py-1.5 rounded-lg bg-purple-950/60 hover:bg-purple-900/60 text-purple-300 border border-purple-800/60 text-xs font-semibold flex items-center gap-1.5 transition-colors disabled:opacity-50\"\n          >\n            <Sparkles className=\"w-3.5 h-3.5\" />\n            <span>Simulate Interview Invitation</span>\n          </button>\n\n          <button\n            id=\"simulate-offer-email-btn\"\n            onClick={() => handleSimulate(\'offer\')}\n            disabled={isSimulating}\n            className=\"px-3 py-1.5 rounded-lg bg-emerald-950/60 hover:bg-emerald-900/60 text-emerald-300 border border-emerald-800/60 text-xs font-semibold flex items-center gap-1.5 transition-colors disabled:opacity-50\"\n          >\n            <CheckCircle2 className=\"w-3.5 h-3.5\" />\n            <span>Simulate Job Offer</span>\n          </button>\n\n          <button\n            id=\"simulate-rejection-email-btn\"\n            onClick={() => handleSimulate(\'rejection\')}\n            disabled={isSimulating}\n            className=\"px-3 py-1.5 rounded-lg bg-rose-950/60 hover:bg-rose-900/60 text-rose-300 border border-rose-800/60 text-xs font-semibold flex items-center gap-1.5 transition-colors disabled:opacity-50\"\n          >\n            <Clock className=\"w-3.5 h-3.5\" />\n            <span>Simulate Rejection Notice</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Raw Email Test Modal / Drawer */}\n      {showRawTester && (\n        <div className=\"p-5 rounded-2xl bg-slate-900 border border-indigo-500/30 space-y-3\">\n          <div className=\"flex items-center justify-between\">\n            <h3 className=\"text-sm font-bold text-white\">Parse Custom Inbound Email</h3>\n            <button\n              onClick={() => setShowRawTester(false)}\n              className=\"text-xs text-slate-400 hover:text-white\"\n            >\n              Cancel\n            </button>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n            <div>\n              <label className=\"text-xs text-slate-400 block mb-1\">Sender Email</label>\n              <input\n                type=\"text\"\n                value={rawSender}\n                onChange={(e) => setRawSender(e.target.value)}\n                className=\"w-full text-xs text-slate-200 bg-slate-950 border border-slate-700 rounded-lg p-2 focus:outline-none focus:border-indigo-500\"\n              />\n            </div>\n            <div>\n              <label className=\"text-xs text-slate-400 block mb-1\">Subject</label>\n              <input\n                type=\"text\"\n                value={rawSubject}\n                onChange={(e) => setRawSubject(e.target.value)}\n                className=\"w-full text-xs text-slate-200 bg-slate-950 border border-slate-700 rounded-lg p-2 focus:outline-none focus:border-indigo-500\"\n              />\n            </div>\n          </div>\n\n          <div>\n            <label className=\"text-xs text-slate-400 block mb-1\">Email Body Content</label>\n            <textarea\n              rows={4}\n              value={rawBody}\n              onChange={(e) => setRawBody(e.target.value)}\n              className=\"w-full text-xs text-slate-200 bg-slate-950 border border-slate-700 rounded-lg p-2.5 focus:outline-none focus:border-indigo-500 font-sans\"\n            />\n          </div>\n\n          <button\n            onClick={handleProcessRaw}\n            disabled={isSimulating}\n            className=\"px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-md transition-all\"\n          >\n            Classify & Sync Application\n          </button>\n        </div>\n      )}\n\n      {/* Main 2-Column Split: Inbox Stream + Email Detail View */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        {/* Email Inbox List */}\n        <div className=\"space-y-3\">\n          <h3 className=\"text-xs font-bold text-slate-400 uppercase tracking-wider\">\n            Inbound Messages ({emails.length})\n          </h3>\n\n          <div className=\"space-y-2.5 max-h-[65vh] overflow-y-auto\">\n            {emails.length === 0 ? (\n              <div className=\"p-8 text-center text-slate-500 text-xs bg-slate-900 rounded-xl border border-slate-800\">\n                No recruiter emails detected yet.\n              </div>\n            ) : (\n              emails.map((em) => {\n                const isSelected = selectedEmail?.id === em.id;\n                return (\n                  <div\n                    key={em.id}\n                    onClick={() => setSelectedEmail(em)}\n                    className={`p-3.5 rounded-xl border cursor-pointer transition-all space-y-1.5 ${\n                      isSelected\n                        ? \'bg-indigo-950/30 border-indigo-500 shadow-md\'\n                        : \'bg-slate-900 border-slate-800 hover:border-slate-700\'\n                    }`}\n                  >\n                    <div className=\"flex items-center justify-between\">\n                      <span className=\"font-bold text-xs text-white\">{em.detectedCompany || em.sender}</span>\n                      <span\n                        className={`text-[10px] font-bold px-1.5 py-0.5 rounded ${\n                          em.classification === \'INTERVIEW\'\n                            ? \'bg-purple-500/20 text-purple-300\'\n                            : em.classification === \'OFFER\'\n                            ? \'bg-emerald-500/20 text-emerald-300\'\n                            : em.classification === \'REJECTION\'\n                            ? \'bg-rose-500/20 text-rose-300\'\n                            : \'bg-slate-800 text-slate-400\'\n                        }`}\n                      >\n                        {em.classification}\n                      </span>\n                    </div>\n                    <p className=\"text-xs text-slate-300 font-semibold line-clamp-1\">{em.subject}</p>\n                    <p className=\"text-[11px] text-slate-400 line-clamp-2\">{em.snippet}</p>\n                    <span className=\"text-[10px] text-slate-500 block pt-1\">\n                      {new Date(em.receivedAt).toLocaleString([], {\n                        month: \'short\',\n                        day: \'numeric\',\n                        hour: \'2-digit\',\n                        minute: \'2-digit\',\n                      })}\n                    </span>\n                  </div>\n                );\n              })\n            )}\n          </div>\n        </div>\n\n        {/* Email Detail Inspection */}\n        <div className=\"lg:col-span-2 space-y-4\">\n          {selectedEmail ? (\n            <div className=\"p-6 rounded-2xl bg-slate-900 border border-slate-800 space-y-4 shadow-sm\">\n              {/* Header */}\n              <div className=\"border-b border-slate-800 pb-4 space-y-2\">\n                <div className=\"flex items-start justify-between gap-2\">\n                  <h2 className=\"text-base font-bold text-white\">{selectedEmail.subject}</h2>\n                  <span\n                    className={`text-xs font-bold px-2.5 py-1 rounded-full ${\n                      selectedEmail.classification === \'INTERVIEW\'\n                        ? \'bg-purple-500/20 text-purple-300 border border-purple-500/30\'\n                        : selectedEmail.classification === \'OFFER\'\n                        ? \'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30\'\n                        : selectedEmail.classification === \'REJECTION\'\n                        ? \'bg-rose-500/20 text-rose-300 border border-rose-500/30\'\n                        : \'bg-slate-800 text-slate-300\'\n                    }`}\n                  >\n                    {selectedEmail.classification} (\n                    {Math.round(selectedEmail.confidenceScore * 100)}% confidence)\n                  </span>\n                </div>\n\n                <div className=\"text-xs text-slate-400 flex items-center gap-3 flex-wrap\">\n                  <span>\n                    <strong>From:</strong> {selectedEmail.sender}\n                  </span>\n                  <span>\342\200\242</span>\n                  <span>\n                    <strong>Company:</strong> {selectedEmail.detectedCompany}\n                  </span>\n                  <span>\342\200\242</span>\n                  <span>{new Date(selectedEmail.receivedAt).toLocaleString()}</span>\n                </div>\n              </div>\n\n              {/* AI Classification Insights */}\n              <div className=\"p-3.5 rounded-xl bg-indigo-950/20 border border-indigo-500/20 space-y-1.5 text-xs\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"font-bold text-indigo-300 flex items-center gap-1\">\n                    <Sparkles className=\"w-3.5 h-3.5\" />\n                    AI Action Recommendation:\n                  </span>\n                  {selectedEmail.matchedApplicationId && onOpenApplication && (\n                    <button\n                      onClick={() => onOpenApplication(selectedEmail.matchedApplicationId!)}\n                      className=\"text-indigo-400 hover:underline font-semibold flex items-center gap-1\"\n                    >\n                      <span>View Application</span>\n                      <ChevronRight className=\"w-3 h-3\" />\n                    </button>\n                  )}\n                </div>\n                <p className=\"text-slate-300\">{selectedEmail.actionTaken}</p>\n              </div>\n\n              {/* Full Email Body */}\n              <div className=\"bg-slate-950 rounded-xl p-4 border border-slate-800 font-sans text-xs text-slate-200 leading-relaxed whitespace-pre-wrap\">\n                {selectedEmail.fullBody || selectedEmail.snippet}\n              </div>\n            </div>\n          ) : (\n            <div className=\"p-12 text-center text-slate-500 text-xs bg-slate-900 rounded-2xl border border-slate-800\">\n              Select an email on the left to review details and classification telemetry.\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
