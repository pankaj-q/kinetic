        replacement_content: "  static async notifyRejectionDetected(company: string, role: string) {\n    const title = `Application Update: ${company}`;\n    const text = `*Application Update*\n\n*Company:* ${company}\n*Role:* ${role}\n*Status:* REJECTED\n\nYour pipeline has been synchronized.`;\n\n    return this.sendTelegramNotification(text, \'rejection_detected\', title, {\n      company,\n    });\n  }\n\n  /**\n   * Dispatches the 10:00 AM Morning Job Search & Application Digest with at least 5 jobs applied\n   */\n  static async sendMorningJobReport(appliedApps: PreparedApplication[], totalJobsScanned: number) {\n    const emailConfig = db.getEmailDispatchConfig();\n    const title = `\360\237\214\205 10:00 AM Morning Job Search & Application Digest`;\n    \n    let jobsListText = \'\';\n    if (appliedApps.length === 0) {\n      jobsListText = \'No eligible jobs met the threshold this morning. Agent will rescan on the next cycle.\';\n    } else {\n      jobsListText = appliedApps\n        .map(\n          (app, i) =>\n            `*${i + 1}. ${app.company}* \342\200\224 ${app.jobTitle}\\n   \342\255\220 *Match Score:* ${app.matchScore}%\\n   \360\237\223\215 *Status:* ${app.status}\\n   \360\237\224\227 [Apply Link](${app.applicationUrl})`\n        )\n        .join(\'\\n\\n\');\n    }\n\n    const text = `\360\237\214\205 *10:00 AM MORNING JOB REPORT* \360\237\232\200\n\n\360\237\216\257 *${appliedApps.length} Job Applications Processed & Submitted:*\n\n${jobsListText}\n\n\342\224\201\342\224\201\342\224\201\342\224\201\342\224\201\342\224\201\342\224\201\342\224\201\342\224\201\342\224\201\342\224\201\342\224\201\342\224\201\342\224\201\342\224\201\342\224\201\342\224\201\342\224\201\342\224\201\342\224\201\n\360\237\223\212 *Total Listings Scanned:* ${totalJobsScanned}\n\360\237\223\247 *Morning Email Digest:* Sent to \\`${emailConfig.recipientEmail}\\`\n\342\217\260 *Next Daily Routine:* Tomorrow at 10:00 AM`;\n\n    return this.sendTelegramNotification(text, \'submission_success\', title, {\n      count: appliedApps.length,\n    });\n  }\n}"
