    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  Briefcase,\n  Search,\n  Filter,\n  Flame,\n  Building,\n  MapPin,\n  DollarSign,\n  Sparkles,\n  ExternalLink,\n  ChevronRight,\n  RefreshCw,\n  FileText,\n  CheckCircle2,\n  AlertCircle,\n  Clock,\n  Layers\n} from \'lucide-react\';\nimport { Job, JobMatch, PreparedApplication } from \'../types\';\n\ninterface JobsViewProps {\n  jobs: (Job & { match?: JobMatch; applicationId?: string; applicationStatus?: string })[];\n  onSearchIngest: (query?: string, sources?: string[]) => Promise<void>;\n  onMatchJob: (jobId: string) => Promise<void>;\n  onMatchAll: () => Promise<void>;\n  onPrepareApplication: (jobId: string) => Promise<void>;\n  onOpenApplication: (appId: string) => void;\n  onGenerateCoverLetter: (jobId: string) => void;\n}\n\nexport const JobsView: React.FC<JobsViewProps> = ({\n  jobs,\n  onSearchIngest,\n  onMatchJob,\n  onMatchAll,\n  onPrepareApplication,\n  onOpenApplication,\n  onGenerateCoverLetter,\n}) => {\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [selectedSource, setSelectedSource] = useState<string>(\'all\');\n  const [remoteOnly, setRemoteOnly] = useState(false);\n  const [minScore, setMinScore] = useState<number>(0);\n  const [selectedJobForDetails, setSelectedJobForDetails] = useState<Job | null>(null);\n  const [isIngesting, setIsIngesting] = useState(false);\n  const [isMatchingAll, setIsMatchingAll] = useState(false);\n\n  const filteredJobs = jobs.filter((job) => {\n    const matchesQuery =\n      job.title.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      job.company.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      job.skillsRequired.some((s) => s.toLowerCase().includes(searchQuery.toLowerCase()));\n    const matchesSource = selectedSource === \'all\' || job.source === selectedSource;\n    const matchesRemote = !remoteOnly || job.remote;\n    const matchesScore = (job.match?.score || 0) >= minScore;\n    return matchesQuery && matchesSource && matchesRemote && matchesScore;\n  });\n\n  const handleSearchIngest = async () => {\n    setIsIngesting(true);\n    try {\n      await onSearchIngest(searchQuery || undefined);\n    } finally {\n      setIsIngesting(false);\n    }\n  };\n\n  const handleMatchAll = async () => {\n    setIsMatchingAll(true);\n    try {\n      await onMatchAll();\n    } finally {\n      setIsMatchingAll(false);\n    }\n  };\n\n  return (\n    <div className=\"space-y-6 animate-in fade-in duration-300\">\n      {/* Top Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <Briefcase className=\"w-5 h-5 text-indigo-400\" />\n            <h1 className=\"text-xl sm:text-2xl font-bold text-white tracking-tight\">\n              Job Search & Match Engine\n            </h1>\n          </div>\n          <p className=\"text-xs text-slate-400 mt-0.5\">\n            Deduplicated jobs aggregated across Greenhouse, Lever, RemoteOK, and LinkedIn.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2.5 flex-wrap\">\n          <button\n            id=\"match-all-jobs-btn\"\n            onClick={handleMatchAll}\n            disabled={isMatchingAll}\n            className=\"flex items-center gap-1.5 px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 text-xs font-semibold transition-colors disabled:opacity-50\"\n          >\n            <Sparkles className={`w-3.5 h-3.5 ${isMatchingAll ? \'animate-spin\' : \'text-indigo-400\'}`} />\n            <span>{isMatchingAll ? \'Evaluating Matches...\' : \'Run Match Engine for All\'}</span>\n          </button>\n\n          <button\n            id=\"crawl-ingest-jobs-btn\"\n            onClick={handleSearchIngest}\n            disabled={isIngesting}\n            className=\"flex items-center gap-1.5 px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-md shadow-indigo-600/20 transition-all hover:scale-[1.02] active:scale-95 disabled:opacity-50\"\n          >\n            <RefreshCw className={`w-3.5 h-3.5 ${isIngesting ? \'animate-spin\' : \'\'}`} />\n            <span>{isIngesting ? \'Ingesting Jobs...\' : \'Search & Ingest Live Jobs\'}</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Filter & Search Bar */}\n      <div className=\"p-4 rounded-xl bg-slate-900 border border-slate-800 space-y-3\">\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3\">\n          {/* Keyword search */}\n          <div className=\"relative\">\n            <Search className=\"w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400\" />\n            <input\n              type=\"text\"\n              placeholder=\"Search title, company, skill...\"\n              value={searchQuery}\n              onChange={(e) => setSearchQuery(e.target.value)}\n              className=\"w-full pl-8 pr-3 py-2 rounded-lg bg-slate-950 border border-slate-700 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-indigo-500\"\n            />\n          </div>\n\n          {/* Source filter */}\n          <div>\n            <select\n              value={selectedSource}\n              onChange={(e) => setSelectedSource(e.target.value)}\n              className=\"w-full py-2 px-3 rounded-lg bg-slate-950 border border-slate-700 text-xs text-slate-200 focus:outline-none focus:border-indigo-500\"\n            >\n              <option value=\"all\">All Job Sources</option>\n              <option value=\"Greenhouse\">Greenhouse</option>\n              <option value=\"Lever\">Lever</option>\n              <option value=\"RemoteOK\">RemoteOK</option>\n              <option value=\"LinkedIn\">LinkedIn</option>\n            </select>\n          </div>\n\n          {/* Min Match Score */}\n          <div>\n            <select\n              value={minScore}\n              onChange={(e) => setMinScore(Number(e.target.value))}\n              className=\"w-full py-2 px-3 rounded-lg bg-slate-950 border border-slate-700 text-xs text-slate-200 focus:outline-none focus:border-indigo-500\"\n            >\n              <option value={0}>All Match Scores</option>\n              <option value={85}>\360\237\224\245 Strong Match (85%+)</option>\n              <option value={75}>\360\237\221\215 Good Match (75%+)</option>\n              <option value={60}>\360\237\224\216 Possible Match (60%+)</option>\n            </select>\n          </div>\n\n          {/* Remote Toggle */}\n          <div className=\"flex items-center justify-between px-3 py-2 rounded-lg bg-slate-950 border border-slate-700\">\n            <span className=\"text-xs text-slate-300 font-medium\">Remote Only</span>\n            <input\n              type=\"checkbox\"\n              checked={remoteOnly}\n              onChange={(e) => setRemoteOnly(e.target.checked)}\n              className=\"w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500 bg-slate-900 border-slate-700\"\n            />\n          </div>\n        </div>\n      </div>\n\n      {/* Jobs Grid List */}\n      <div className=\"space-y-3.5\">\n        {filteredJobs.length === 0 ? (\n          <div className=\"p-12 text-center bg-slate-900/60 rounded-2xl border border-slate-800 space-y-3\">\n            <Briefcase className=\"w-8 h-8 text-slate-600 mx-auto\" />\n            <h3 className=\"text-sm font-bold text-slate-300\">No jobs match your filter criteria</h3>\n            <p className=\"text-xs text-slate-500\">\n              Try adjusting your search keywords, lowering the match threshold, or clicking \"Search & Ingest Live Jobs\".\n            </p>\n          </div>\n        ) : (\n          filteredJobs.map((job) => {\n            const match = job.match;\n            const score = match?.score;\n            const hasApp = !!job.applicationId;\n\n            return (\n              <div\n                key={job.id}\n                className=\"p-5 rounded-2xl bg-slate-900 border border-slate-800 hover:border-slate-700 transition-all space-y-4 shadow-sm\"\n              >\n                <div className=\"flex flex-col lg:flex-row lg:items-start justify-between gap-4\">\n                  <div className=\"space-y-1.5 flex-1\">\n                    <div className=\"flex items-center gap-2.5 flex-wrap\">\n                      <h2 className=\"text-base font-bold text-white hover:text-indigo-300 transition-colors\">\n                        {job.title}\n                      </h2>\n                      <span className=\"px-2 py-0.5 rounded text-[10px] font-bold bg-slate-800 text-slate-300 border border-slate-700\">\n                        {job.source}\n                      </span>\n                      {job.remote && (\n                        <span className=\"px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-950/60 text-emerald-300 border border-emerald-800/60\">\n                          Remote\n                        </span>\n                      )}\n                    </div>\n\n                    <div className=\"flex items-center gap-3.5 text-xs text-slate-400 flex-wrap\">\n                      <span className=\"flex items-center gap-1\">\n                        <Building className=\"w-3.5 h-3.5 text-slate-500\" />\n                        <strong className=\"text-slate-200\">{job.company}</strong>\n                      </span>\n                      <span className=\"flex items-center gap-1\">\n                        <MapPin className=\"w-3.5 h-3.5 text-slate-500\" />\n                        {job.location}\n                      </span>\n                      {job.salary && (\n                        <span className=\"flex items-center gap-1 text-emerald-400 font-semibold\">\n                          <DollarSign className=\"w-3.5 h-3.5\" />\n                          ${(job.salary.min || 130000).toLocaleString()} - $\n                          {(job.salary.max || 170000).toLocaleString()}\n                        </span>\n                      )}\n                      <span className=\"text-[11px] text-slate-500\">\n                        Posted {new Date(job.postedAt).toLocaleDateString()}\n                      </span>\n                    </div>\n                  </div>\n\n                  {/* Match Score & Action */}\n                  <div className=\"flex items-center gap-3 self-start\">\n                    {score !== undefined ? (\n                      <div\n                        className={`px-3 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1.5 ${\n                          score >= 90\n                            ? \'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40\'\n                            : score >= 75\n                            ? \'bg-indigo-500/20 text-indigo-300 border border-indigo-500/40\'\n                            : score >= 60\n                            ? \'bg-amber-500/20 text-amber-300 border border-amber-500/40\'\n                            : \'bg-slate-800 text-slate-400\'\n                        }`}\n                      >\n                        <Flame className=\"w-4 h-4\" />\n                        <span>{score}% Match</span>\n                      </div>\n                    ) : (\n                      <button\n                        onClick={() => onMatchJob(job.id)}\n                        className=\"flex items-center gap-1 px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold transition-colors\"\n                      >\n                        <Sparkles className=\"w-3.5 h-3.5 text-indigo-400\" />\n                        <span>Calculate Match</span>\n                      </button>\n                    )}\n                  </div>\n                </div>\n\n                {/* Match Reasoning & Breakdown */}\n                {match && (\n                  <div className=\"bg-slate-950/60 rounded-xl p-3.5 border border-slate-800 space-y-2\">\n                    <p className=\"text-xs text-slate-300 leading-relaxed\">\n                      <span className=\"font-semibold text-indigo-300\">AI Match Evaluation: </span>\n                      {match.reason}\n                    </p>\n\n                    <div className=\"flex items-center gap-4 text-xs flex-wrap pt-1 border-t border-slate-800/80\">\n                      {match.matchingSkills.length > 0 && (\n                        <div className=\"flex items-center gap-1.5 flex-wrap\">\n                          <span className=\"text-[11px] font-bold text-emerald-400\">Matching:</span>\n                          {match.matchingSkills.map((s, i) => (\n                            <span\n                              key={i}\n                              className=\"px-2 py-0.5 rounded text-[10px] font-medium bg-emerald-500/10 text-emerald-300 border border-emerald-500/20\"\n                            >\n                              \342\234\223 {s}\n                            </span>\n                          ))}\n                        </div>\n                      )}\n\n                      {match.missingSkills.length > 0 && (\n                        <div className=\"flex items-center gap-1.5 flex-wrap\">\n                          <span className=\"text-[11px] font-bold text-amber-400\">Gaps:</span>\n                          {match.missingSkills.map((s, i) => (\n                            <span\n                              key={i}\n                              className=\"px-2 py-0.5 rounded text-[10px] font-medium bg-amber-500/10 text-amber-300 border border-amber-500/20\"\n                            >\n                              \342\226\263 {s}\n                            </span>\n                          ))}\n                        </div>\n                      )}\n                    </div>\n                  </div>\n                )}\n\n                {/* Bottom Actions */}\n                <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-2 border-t border-slate-800\">\n                  <div className=\"flex items-center gap-2 flex-wrap\">\n                    <span className=\"text-[11px] text-slate-500 font-semibold\">Tech Stack:</span>\n                    {job.skillsRequired.map((s, i) => (\n                      <span\n                        key={i}\n                        className=\"px-2 py-0.5 rounded text-[11px] bg-slate-800 text-slate-300 border border-slate-700/80\"\n                      >\n                        {s}\n                      </span>\n                    ))}\n                  </div>\n\n                  <div className=\"flex items-center gap-2\">\n                    <button\n                      onClick={() => onGenerateCoverLetter(job.id)}\n                      className=\"flex items-center gap-1 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold transition-colors\"\n                    >\n                      <FileText className=\"w-3.5 h-3.5 text-indigo-400\" />\n                      <span>Custom Cover Letter</span>\n                    </button>\n\n                    {hasApp ? (\n                      <button\n                        onClick={() => onOpenApplication(job.applicationId!)}\n                        className=\"flex items-center gap-1 px-3 py-1.5 rounded-lg bg-indigo-950 text-indigo-300 border border-indigo-800 text-xs font-semibold hover:bg-indigo-900 transition-colors\"\n                      >\n                        <span>View Application ({job.applicationStatus?.replace(/_/g, \' \')})</span>\n                        <ChevronRight className=\"w-3.5 h-3.5\" />\n                      </button>\n                    ) : (\n                      <button\n                        id={`job-prepare-btn-${job.id}`}\n                        onClick={() => onPrepareApplication(job.id)}\n                        className=\"flex items-center gap-1.5 px-4 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-sm transition-all\"\n                      >\n                        <Sparkles className=\"w-3.5 h-3.5\" />\n                        <span>Prepare Application</span>\n                      </button>\n                    )}\n                  </div>\n                </div>\n              </div>\n            );\n          })\n        )}\n      </div>\n    </div>\n  );\n};\n"
    }
