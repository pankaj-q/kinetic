    replacement_infos {
      original_chunk {
        target_content: "  const handleSearchIngestJobs = async (query?: string, sources?: string[]) => {\n    try {\n      await fetch(\'/api/jobs/search\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ query, sources }),\n      });\n      await fetchData();\n    } catch (err) {\n      console.error(\'Error searching jobs:\', err);\n    }\n  };"
        replacement_content: "  const handleSearchIngestJobs = async (query?: string, sources?: string[]) => {\n    try {\n      await fetch(\'/api/jobs/search\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ query, sources }),\n      });\n      await fetchData();\n    } catch (err) {\n      console.error(\'Error searching jobs:\', err);\n    }\n  };\n\n  const handleIngestCustomJob = async (data: { url?: string; rawText?: string }) => {\n    try {\n      const res = await fetch(\'/api/jobs/ingest-custom\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify(data),\n      });\n      if (res.ok) {\n        await fetchData();\n      }\n    } catch (err) {\n      console.error(\'Error ingesting custom job:\', err);\n    }\n  };"
      }
      num_matches: 1
    }
  }
