  file_change {
    absolute_path_uri: "file:///src/components/DashboardView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport {\n  Briefcase,\n  Flame,\n  FileCheck,\n  CheckCircle2,\n  Clock,\n  Sparkles,\n  TrendingUp,\n  ArrowRight,\n  Bot,\n  Play,\n  Send,\n  Building,\n  MapPin,\n  DollarSign,\n  AlertCircle,\n  ExternalLink,\n  ChevronRight,\n  RefreshCw\n} from \'lucide-react\';\nimport { DashboardStats, Job, JobMatch, PreparedApplication, TelegramConfig } from \'../types\';\n\ninterface DashboardViewProps {\n  stats: DashboardStats;\n  jobs: (Job & { match?: JobMatch; applicationId?: string; applicationStatus?: string })[];\n  applications: PreparedApplication[];\n  telegramConfig: TelegramConfig;\n  onNavigateTab: (tab: string) => void;\n  onOpenApplication: (appId: string) => void;\n  onPrepareApplication: (jobId: string) => void;\n  onTriggerAgent: (goal?: string) => void;\n  isAgentRunning: boolean;\n  onRefreshData: () => void;\n}\n\nexport const DashboardView: React.FC<DashboardViewProps> = ({\n  stats,\n  jobs,\n  applications,\n  telegramConfig,\n  onNavigateTab,\n  onOpenApplication,\n  onPrepareApplication,\n  onTriggerAgent,\n  isAgentRunning,\n  onRefreshData,\n}) => {\n  const waitingApprovalApps = applications.filter((a) => a.status === \'WAITING_FOR_APPROVAL\');\n  const interviewApps = applications.filter((a) => a.status === \'INTERVIEW\');\n  const highMatchJobs = jobs.filter((j) => (j.match?.score || 0) >= 85).slice(0, 4);\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-300\">\n      {/* Top Banner: Quick Agent Trigger & Autonomous Engine */}\n      <div className=\"relative overflow-hidden rounded-2xl bg-gradient-to-r from-slate-900 via-indigo-950/80 to-slate-900 border border-indigo-500/20 p-6 sm:p-8 shadow-xl\">\n        <div className=\"absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none\" />\n        <div className=\"relative z-10 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6\">\n          <div className=\"max-w-2xl space-y-2\">\n            <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/30 text-indigo-300 text-xs font-semibold\">\n              <Sparkles className=\"w-3.5 h-3.5\" />\n              <span>Autonomous Job Assistant Powered by Gemini 3.7</span>\n            </div>\n            <h1 className=\"text-2xl sm:text-3xl font-extrabold text-white tracking-tight\">\n              AI Job Search, Matching & Application Engine\n            </h1>\n            <p className=\"text-slate-300 text-sm leading-relaxed\">\n              Continuously discovers deduplicated jobs, calculates deep technical match scores, generates bespoke\n              truthful cover letters, and prepares applications with Human-In-The-Loop approval.\n            </p>\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-3 w-full lg:w-auto\">\n            <button\n              id=\"dashboard-launch-agent-btn\"\n              onClick={() => onNavigateTab(\'agent\')}\n              disabled={isAgentRunning}\n              className=\"flex-1 sm:flex-none flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm shadow-lg shadow-indigo-600/30 transition-all hover:scale-[1.02] active:scale-95 disabled:opacity-50\"\n            >\n              <Bot className=\"w-4 h-4\" />\n              <span>{isAgentRunning ? \'Agent Loop Running...\' : \'Open Agent Console\'}</span>\n              <ArrowRight className=\"w-4 h-4\" />\n            </button>\n\n            <button\n              onClick={onRefreshData}\n              className=\"p-3 rounded-xl bg-slate-800/80 hover:bg-slate-800 border border-slate-700 text-slate-300 hover:text-white transition-colors\"\n              title=\"Refresh Dashboard Data\"\n            >\n              <RefreshCw className=\"w-4 h-4\" />\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* KPI Cards Grid */}\n      <div className=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3.5 sm:gap-4\">\n        {/* New Matches */}\n        <div\n          onClick={() => onNavigateTab(\'jobs\')}\n          className=\"p-4 rounded-xl bg-slate-900/90 border border-slate-800 hover:border-slate-700 cursor-pointer transition-all hover:-translate-y-0.5 shadow-sm\"\n        >\n          <div className=\"flex items-center justify-between text-slate-400 mb-2\">\n            <span className=\"text-xs font-semibold\">New Matches</span>\n            <Flame className=\"w-4 h-4 text-amber-400\" />\n          </div>\n          <div className=\"text-2xl font-bold text-white tracking-tight\">{stats.newMatchesCount}</div>\n          <p className=\"text-[11px] text-amber-400 font-medium mt-1\">\n            {stats.strongMatchesCount} strong (85%+)\n          </p>\n        </div>\n\n        {/* Waiting Approval */}\n        <div\n          onClick={() => onNavigateTab(\'applications\')}\n          className=\"p-4 rounded-xl bg-slate-900/90 border border-amber-500/30 hover:border-amber-500/50 cursor-pointer transition-all hover:-translate-y-0.5 shadow-sm bg-gradient-to-b from-amber-500/5 to-transparent\"\n        >\n          <div className=\"flex items-center justify-between text-slate-400 mb-2\">\n            <span className=\"text-xs font-semibold text-amber-300\">Need Approval</span>\n            <Clock className=\"w-4 h-4 text-amber-400\" />\n          </div>\n          <div className=\"text-2xl font-bold text-amber-400 tracking-tight\">{stats.waitingApprovalCount}</div>\n          <p className=\"text-[11px] text-slate-400 font-medium mt-1\">Human-in-the-loop</p>\n        </div>\n\n        {/* Total Applications */}\n        <div\n          onClick={() => onNavigateTab(\'applications\')}\n          className=\"p-4 rounded-xl bg-slate-900/90 border border-slate-800 hover:border-slate-700 cursor-pointer transition-all hover:-translate-y-0.5 shadow-sm\"\n        >\n          <div className=\"flex items-center justify-between text-slate-400 mb-2\">\n            <span className=\"text-xs font-semibold\">Total Applied</span>\n            <FileCheck className=\"w-4 h-4 text-blue-400\" />\n          </div>\n          <div className=\"text-2xl font-bold text-white tracking-tight\">{stats.appliedCount}</div>\n          <p className=\"text-[11px] text-slate-400 font-medium mt-1\">{stats.totalApplications} in pipeline</p>\n        </div>\n\n        {/* Interviews */}\n        <div\n          onClick={() => onNavigateTab(\'applications\')}\n          className=\"p-4 rounded-xl bg-slate-900/90 border border-purple-500/30 hover:border-purple-500/50 cursor-pointer transition-all hover:-translate-y-0.5 shadow-sm bg-gradient-to-b from-purple-500/5 to-transparent\"\n        >\n          <div className=\"flex items-center justify-between text-slate-400 mb-2\">\n            <span className=\"text-xs font-semibold text-purple-300\">Interviews</span>\n            <Sparkles className=\"w-4 h-4 text-purple-400\" />\n          </div>\n          <div className=\"text-2xl font-bold text-purple-400 tracking-tight\">{stats.interviewCount}</div>\n          <p className=\"text-[11px] text-purple-300/80 font-medium mt-1\">Recruiter rounds</p>\n        </div>\n\n        {/* Offers */}\n        <div\n          onClick={() => onNavigateTab(\'applications\')}\n          className=\"p-4 rounded-xl bg-slate-900/90 border border-emerald-500/30 hover:border-emerald-500/50 cursor-pointer transition-all hover:-translate-y-0.5 shadow-sm bg-gradient-to-b from-emerald-500/5 to-transparent\"\n        >\n          <div className=\"flex items-center justify-between text-slate-400 mb-2\">\n            <span className=\"text-xs font-semibold text-emerald-300\">Offers</span>\n            <CheckCircle2 className=\"w-4 h-4 text-emerald-400\" />\n          </div>\n          <div className=\"text-2xl font-bold text-emerald-400 tracking-tight\">{stats.offersCount}</div>\n          <p className=\"text-[11px] text-emerald-300/80 font-medium mt-1\">Offers received</p>\n        </div>\n\n        {/* Avg Match Score */}\n        <div\n          onClick={() => onNavigateTab(\'jobs\')}\n          className=\"p-4 rounded-xl bg-slate-900/90 border border-slate-800 hover:border-slate-700 cursor-pointer transition-all hover:-translate-y-0.5 shadow-sm\"\n        >\n          <div className=\"flex items-center justify-between text-slate-400 mb-2\">\n            <span className=\"text-xs font-semibold\">Avg Match</span>\n            <TrendingUp className=\"w-4 h-4 text-indigo-400\" />\n          </div>\n          <div className=\"text-2xl font-bold text-white tracking-tight\">{stats.averageMatchScore}%</div>\n          <p className=\"text-[11px] text-indigo-300 font-medium mt-1\">Gemini AI fit</p>\n        </div>\n      </div>\n\n      {/* Human-in-the-Loop Action Center: Applications Awaiting User Approval */}\n      {waitingApprovalApps.length > 0 && (\n        <div className=\"rounded-2xl bg-amber-950/20 border border-amber-500/30 p-5 sm:p-6 space-y-4\">\n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2\">\n            <div className=\"flex items-center gap-2.5\">\n              <div className=\"w-8 h-8 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center\">\n                <AlertCircle className=\"w-4 h-4\" />\n              </div>\n              <div>\n                <h2 className=\"text-base font-bold text-white\">\n                  Applications Ready for Review ({waitingApprovalApps.length})\n                </h2>\n                <p className=\"text-xs text-amber-300/80\">\n                  The agent prepared answers and tailored cover letters. Review and click Approve to submit.\n                </p>\n              </div>\n            </div>\n\n            <button\n              onClick={() => onNavigateTab(\'applications\')}\n              className=\"text-xs font-semibold text-amber-400 hover:text-amber-300 flex items-center gap-1 self-start sm:self-auto\"\n            >\n              <span>View All Applications</span>\n              <ChevronRight className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3.5\">\n            {waitingApprovalApps.map((app) => (\n              <div\n                key={app.id}\n                className=\"p-4 rounded-xl bg-slate-900/90 border border-amber-500/30 hover:border-amber-500/60 transition-all flex flex-col justify-between space-y-3\"\n              >\n                <div>\n                  <div className=\"flex items-start justify-between gap-2\">\n                    <div>\n                      <h3 className=\"font-bold text-sm text-white\">{app.jobTitle}</h3>\n                      <p className=\"text-xs text-slate-400 flex items-center gap-1.5 mt-0.5\">\n                        <Building className=\"w-3 h-3 text-slate-500\" />\n                        <span>{app.company}</span>\n                      </p>\n                    </div>\n                    <span className=\"px-2 py-0.5 rounded-full text-xs font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40\">\n                      {app.matchScore}% Match\n                    </span>\n                  </div>\n\n                  <p className=\"text-xs text-slate-300 mt-2.5 line-clamp-2 bg-slate-950/60 p-2.5 rounded-lg border border-slate-800/80 font-mono text-[11px]\">\n                    \"{app.coverLetterContent?.slice(0, 160)}...\"\n                  </p>\n                </div>\n\n                <div className=\"flex items-center justify-between pt-2 border-t border-slate-800\">\n                  <div className=\"flex items-center gap-2 text-[11px] text-slate-400\">\n                    <span>{app.formFields.length} Form Fields Filled</span>\n                  </div>\n                  <button\n                    id={`approve-app-btn-${app.id}`}\n                    onClick={() => onOpenApplication(app.id)}\n                    className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-md shadow-amber-500/20 transition-transform active:scale-95\"\n                  >\n                    <span>Review & Approve</span>\n                    <ArrowRight className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      )}\n\n      {/* Main 2-Column Split: Top Matched Jobs + Pipeline Status */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        {/* Left 2 Cols: High Match Jobs */}\n        <div className=\"lg:col-span-2 space-y-4\">\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center gap-2\">\n              <Flame className=\"w-5 h-5 text-amber-400\" />\n              <h2 className=\"text-lg font-bold text-white\">Top High-Match Job Opportunities</h2>\n            </div>\n            <button\n              onClick={() => onNavigateTab(\'jobs\')}\n              className=\"text-xs font-semibold text-indigo-400 hover:text-indigo-300 flex items-center gap-1\"\n            >\n              <span>Explore All ({jobs.length})</span>\n              <ChevronRight className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n\n          <div className=\"space-y-3\">\n            {highMatchJobs.map((job) => {\n              const score = job.match?.score || 85;\n              const hasApp = !!job.applicationId;\n              return (\n                <div\n                  key={job.id}\n                  className=\"p-4 rounded-xl bg-slate-900 border border-slate-800 hover:border-slate-700 transition-all space-y-3\"\n                >\n                  <div className=\"flex flex-col sm:flex-row sm:items-start justify-between gap-2\">\n                    <div>\n                      <div className=\"flex items-center gap-2 flex-wrap\">\n                        <h3 className=\"font-bold text-sm text-white hover:text-indigo-300 transition-colors\">\n                          {job.title}\n                        </h3>\n                        <span className=\"px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-800 text-slate-300 border border-slate-700\">\n                          {job.source}\n                        </span>\n                      </div>\n                      <div className=\"flex items-center gap-3 text-xs text-slate-400 mt-1 flex-wrap\">\n                        <span className=\"flex items-center gap-1\">\n                          <Building className=\"w-3 h-3 text-slate-500\" />\n                          {job.company}\n                        </span>\n                        <span className=\"flex items-center gap-1\">\n                          <MapPin className=\"w-3 h-3 text-slate-500\" />\n                          {job.location}\n                        </span>\n                        {job.salary && (\n                          <span className=\"flex items-center gap-1 text-emerald-400 font-medium\">\n                            <DollarSign className=\"w-3 h-3\" />\n                            ${(job.salary.min || 130000).toLocaleString()} - $\n                            {(job.salary.max || 170000).toLocaleString()}\n                          </span>\n                        )}\n                      </div>\n                    </div>\n\n                    <div className=\"flex items-center gap-2 self-start\">\n                      <div\n                        className={`px-2.5 py-1 rounded-lg text-xs font-bold flex items-center gap-1 ${\n                          score >= 90\n                            ? \'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40\'\n                            : score >= 75\n                            ? \'bg-indigo-500/20 text-indigo-300 border border-indigo-500/40\'\n                            : \'bg-slate-800 text-slate-300\'\n                        }`}\n                      >\n                        <Flame className=\"w-3.5 h-3.5\" />\n                        <span>{score}% Match</span>\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* AI Reason snippet */}\n                  {job.match?.reason && (\n                    <p className=\"text-xs text-slate-300 leading-relaxed bg-slate-950/60 p-2.5 rounded-lg border border-slate-800/80\">\n                      <span className=\"font-semibold text-indigo-300\">Why you match: </span>\n                      {job.match.reason}\n                    </p>\n                  )}\n\n                  {/* Required Skills tags */}\n                  <div className=\"flex items-center justify-between flex-wrap gap-2 pt-2 border-t border-slate-800/80\">\n                    <div className=\"flex items-center gap-1.5 flex-wrap\">\n                      {job.skillsRequired.slice(0, 4).map((skill, i) => (\n                        <span\n                          key={i}\n                          className=\"px-2 py-0.5 rounded text-[11px] font-medium bg-slate-800/80 text-slate-300 border border-slate-700/60\"\n                        >\n                          {skill}\n                        </span>\n                      ))}\n                    </div>\n\n                    <div className=\"flex items-center gap-2\">\n                      {hasApp ? (\n                        <button\n                          onClick={() => onOpenApplication(job.applicationId!)}\n                          className=\"flex items-center gap-1 px-3 py-1.5 rounded-lg bg-indigo-950 text-indigo-300 border border-indigo-800 text-xs font-semibold hover:bg-indigo-900 transition-colors\"\n                        >\n                          <span>View Application</span>\n                          <ChevronRight className=\"w-3 h-3\" />\n                        </button>\n                      ) : (\n                        <button\n                          id={`quick-prepare-job-${job.id}`}\n                          onClick={() => onPrepareApplication(job.id)}\n                          className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold shadow-sm transition-all\"\n                        >\n                          <Sparkles className=\"w-3.5 h-3.5\" />\n                          <span>Prepare Application</span>\n                        </button>\n                      )}\n                    </div>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n\n        {/* Right Col: Active Interviews & Recent Agent Timeline */}\n        <div className=\"space-y-6\">\n          {/* Active Interviews widget */}\n          <div className=\"p-5 rounded-2xl bg-slate-900 border border-slate-800 space-y-4\">\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-2\">\n                <Sparkles className=\"w-4 h-4 text-purple-400\" />\n                <h3 className=\"font-bold text-sm text-white\">Active Interviews ({interviewApps.length})</h3>\n              </div>\n              <span className=\"px-2 py-0.5 rounded text-[10px] font-bold bg-purple-500/20 text-purple-300 border border-purple-500/30\">\n                Scheduled\n              </span>\n            </div>\n\n            {interviewApps.length === 0 ? (\n              <p className=\"text-xs text-slate-400 py-3 text-center\">\n                No active interviews currently detected. As recruiter invitations arrive in email, they will sync here.\n              </p>\n            ) : (\n              <div className=\"space-y-2.5\">\n                {interviewApps.map((app) => (\n                  <div\n                    key={app.id}\n                    onClick={() => onOpenApplication(app.id)}\n                    className=\"p-3 rounded-xl bg-purple-950/20 border border-purple-500/30 hover:border-purple-500/60 cursor-pointer transition-colors space-y-1\"\n                  >\n                    <div className=\"flex items-center justify-between\">\n                      <span className=\"text-xs font-bold text-white\">{app.company}</span>\n                      <span className=\"text-[10px] text-purple-300 font-semibold\">Technical Round</span>\n                    </div>\n                    <p className=\"text-xs text-slate-300\">{app.jobTitle}</p>\n                    {app.interviewDate && (\n                      <p className=\"text-[11px] text-purple-300 flex items-center gap-1 pt-1 font-mono\">\n                        <Clock className=\"w-3 h-3\" />\n                        {new Date(app.interviewDate).toLocaleDateString()}\n                      </p>\n                    )}\n                  </div>\n                ))}\n              </div>\n            )}\n          </div>\n\n          {/* Real-Time Activity Feed */}\n          <div className=\"p-5 rounded-2xl bg-slate-900 border border-slate-800 space-y-4\">\n            <div className=\"flex items-center justify-between\">\n              <h3 className=\"font-bold text-sm text-white\">System Activity & Audit Log</h3>\n              <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-ping\" />\n            </div>\n\n            <div className=\"space-y-3 max-h-72 overflow-y-auto\">\n              {stats.recentActivity.map((item) => (\n                <div key={item.id} className=\"flex items-start gap-2.5 text-xs\">\n                  <div className=\"w-1.5 h-1.5 rounded-full bg-indigo-400 mt-1.5 flex-shrink-0\" />\n                  <div className=\"flex-1\">\n                    <p className=\"text-slate-200 leading-snug\">{item.message}</p>\n                    <span className=\"text-[10px] text-slate-500\">\n                      {new Date(item.time).toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' })}\n                    </span>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
