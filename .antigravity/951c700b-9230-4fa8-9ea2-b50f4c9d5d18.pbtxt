eline run:\', err);\n      return {\n        status: \'failed\',\n        timestamp: new Date().toISOString(),\n      };\n    } finally {\n      this.isRunning = false;\n    }\n  }\n\n  static stopScheduler() {\n    if (this.timer) {\n      clearInterval(this.timer);\n      this.timer = null;\n    }\n  }\n}\n"
