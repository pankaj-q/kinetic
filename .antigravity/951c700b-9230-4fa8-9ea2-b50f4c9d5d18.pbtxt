    instruction: "Add copy buttons and quick clipboard utilities to ApplicationApprovalModal.tsx"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport {\n  X,\n  CheckCircle2,\n  AlertCircle,\n  Building,\n  MapPin,\n  Flame,\n  FileText,\n  Sparkles,\n  Edit3,\n  ExternalLink,\n  ShieldCheck,\n  Send,\n  Loader2,\n  Lock\n} from \'lucide-react\';\nimport { PreparedApplication, ApplicationFormField } from \'../types\';\nimport confetti from \'canvas-confetti\';\n\ninterface ApplicationApprovalModalProps {\n  application: PreparedApplication | null;\n  onClose: () => void;\n  onApprove: (appId: string, editedFields: ApplicationFormField[], editedCoverLetter: string) => Promise<void>;\n  onUpdateStatus?: (appId: string, status: any) => void;\n}\n\nexport const ApplicationApprovalModal: React.FC<ApplicationApprovalModalProps> = ({\n  application,\n  onClose,\n  onApprove,\n  onUpdateStatus,\n}) => {\n  if (!application) return null;\n\n  const [formFields, setFormFields] = useState<ApplicationFormField[]>(application.formFields || []);\n  const [coverLetter, setCoverLetter] = useState<string>(application.coverLetterContent || \'\');\n  const [activeTab, setActiveTab] = useState<\'fields\' | \'cover_letter\' | \'history\'>(\'fields\');\n  const [isSubmitting, setIsSubmitting] = useState(false);\n  const [isSuccess, setIsSuccess] = useState(application.status === \'APPLIED\');\n\n  const handleFieldChange = (fieldId: string, value: string | boolean) => {\n    setFormFields((prev) =>\n      prev.map((f) => (f.fieldId === fieldId ? { ...f, value } : f))\n    );\n  };\n\n  const handleApproveSubmit = async () => {\n    setIsSubmitting(true);\n    try {\n      await onApprove(application.id, formFields, coverLetter);\n      setIsSuccess(true);\n      try {\n        confetti({\n          particleCount: 80,\n          spread: 70,\n          origin: { y: 0.6 },\n        });\n      } catch (e) {}\n    } catch (err) {\n      console.error(err);\n    } finally {\n      setIsSubmitting(false);\n    }\n  };\n\n  const isWaitingApproval = application.status === \'WAITING_FOR_APPROVAL\';\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-in fade-in duration-200\">\n      <div className=\"relative w-full max-w-4xl max-h-[90vh] bg-slate-900 border border-slate-700 rounded-2xl shadow-2xl flex flex-col overflow-hidden\">\n        {/* Header */}\n        <div className=\"px-6 py-4 border-b border-slate-800 flex items-center justify-between bg-slate-950/60\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-indigo-600/20 border border-indigo-500/30 flex items-center justify-center text-indigo-400\">\n              <Building className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h2 className=\"text-lg font-bold text-white tracking-tight\">{application.jobTitle}</h2>\n                <span\n                  className={`px-2 py-0.5 rounded-full text-xs font-bold ${\n                    application.matchScore >= 90\n                      ? \'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40\'\n                      : \'bg-indigo-500/20 text-indigo-300 border border-indigo-500/40\'\n                  }`}\n                >\n                  <Flame className=\"w-3 h-3 inline mr-1\" />\n                  {application.matchScore}% Match\n                </span>\n              </div>\n              <p className=\"text-xs text-slate-400 flex items-center gap-2 mt-0.5\">\n                <span className=\"font-semibold text-slate-300\">{application.company}</span>\n                <span>\342\200\242</span>\n                <a\n                  href={application.applicationUrl}\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"text-indigo-400 hover:underline flex items-center gap-1\"\n                >\n                  <span>Job Portal</span>\n                  <ExternalLink className=\"w-3 h-3\" />\n                </a>\n              </p>\n            </div>\n          </div>\n\n          <button\n            onClick={onClose}\n            className=\"p-2 rounded-lg bg-slate-800 text-slate-400 hover:text-white hover:bg-slate-700 transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Human-in-the-Loop Safety Banner */}\n        {isWaitingApproval && (\n          <div className=\"px-6 py-2.5 bg-amber-500/10 border-b border-amber-500/20 flex items-center justify-between text-xs text-amber-300\">\n            <div className=\"flex items-center gap-2\">\n              <ShieldCheck className=\"w-4 h-4 text-amber-400\" />\n              <span>\n                <strong>Human Approval Required:</strong> Review auto-filled application responses and cover letter\n                before final submission.\n              </span>\n            </div>\n            <span className=\"text-[11px] font-mono text-amber-400/80\">Human-In-The-Loop Active</span>\n          </div>\n        )}\n\n        {/* Tab Navigation */}\n        <div className=\"flex items-center gap-2 px-6 border-b border-slate-800 bg-slate-900/50\">\n          <button\n            onClick={() => setActiveTab(\'fields\')}\n            className={`py-3 px-3 border-b-2 text-xs font-semibold flex items-center gap-1.5 transition-colors ${\n              activeTab === \'fields\'\n                ? \'border-indigo-500 text-indigo-300\'\n                : \'border-transparent text-slate-400 hover:text-slate-200\'\n            }`}\n          >\n            <Edit3 className=\"w-3.5 h-3.5\" />\n            <span>Form Fields & Custom Q&A ({formFields.length})</span>\n          </button>\n          <button\n            onClick={() => setActiveTab(\'cover_letter\')}\n            className={`py-3 px-3 border-b-2 text-xs font-semibold flex items-center gap-1.5 transition-colors ${\n              activeTab === \'cover_letter\'\n                ? \'border-indigo-500 text-indigo-300\'\n                : \'border-transparent text-slate-400 hover:text-slate-200\'\n            }`}\n          >\n            <FileText className=\"w-3.5 h-3.5\" />\n            <span>Tailored Cover Letter</span>\n          </button>\n          <button\n            onClick={() => setActiveTab(\'history\')}\n            className={`py-3 px-3 border-b-2 text-xs font-semibold flex items-center gap-1.5 transition-colors ${\n              activeTab === \'history\'\n                ? \'border-indigo-500 text-indigo-300\'\n                : \'border-transparent text-slate-400 hover:text-slate-200\'\n            }`}\n          >\n            <Sparkles className=\"w-3.5 h-3.5\" />\n            <span>Lifecycle & Audit Trail ({application.historyLogs.length})</span>\n          </button>\n        </div>\n\n        {/* Body Content */}\n        <div className=\"flex-1 overflow-y-auto p-6 space-y-6\">\n          {activeTab === \'fields\' && (\n            <div className=\"space-y-4\">\n              <div className=\"flex items-center justify-between\">\n                <h3 className=\"text-sm font-bold text-slate-200\">Application Form Inputs</h3>\n                <span className=\"text-xs text-slate-400\">All fields editable before submission</span>\n              </div>\n\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                {formFields.map((field) => (\n                  <div\n                    key={field.fieldId}\n                    className={`p-3.5 rounded-xl border transition-all ${\n                      field.type === \'textarea\' ? \'md:col-span-2\' : \'\'\n                    } ${\n                      field.isAiGenerated\n                        ? \'bg-indigo-950/20 border-indigo-500/30\'\n                        : \'bg-slate-950/60 border-slate-800\'\n                    }`}\n                  >\n                    <div className=\"flex items-center justify-between mb-1.5\">\n                      <label className=\"text-xs font-bold text-slate-300 flex items-center gap-1.5\">\n                        <span>{field.label}</span>\n                        {field.required && <span className=\"text-rose-400\">*</span>}\n                      </label>\n                      {field.isAiGenerated && (\n                        <span className=\"px-1.5 py-0.5 rounded text-[10px] font-semibold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 flex items-center gap-1\">\n                          <Sparkles className=\"w-2.5 h-2.5\" />\n                          AI Synthesized\n                        </span>\n                      )}\n                    </div>\n\n                    {field.type === \'textarea\' ? (\n                      <textarea\n                        rows={3}\n                        value={String(field.value)}\n                        onChange={(e) => handleFieldChange(field.fieldId, e.target.value)}\n                        className=\"w-full text-xs text-slate-100 bg-slate-900 border border-slate-700 rounded-lg p-2.5 focus:outline-none focus:border-indigo-500 font-sans leading-relaxed\"\n                      />\n                    ) : (\n                      <input\n                        type=\"text\"\n                        value={String(field.value)}\n                        onChange={(e) => handleFieldChange(field.fieldId, e.target.value)}\n                        className=\"w-full text-xs text-slate-100 bg-slate-900 border border-slate-700 rounded-lg p-2.5 focus:outline-none focus:border-indigo-500\"\n                      />\n                    )}\n\n                    {field.reasoning && (\n                      <p className=\"text-[11px] text-slate-400 mt-1.5 italic\">\n                        Evidence basis: {field.reasoning}\n                      </p>\n                    )}\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n\n          {activeTab === \'cover_letter\' && (\n            <div className=\"space-y-3\">\n              <div className=\"flex items-center justify-between\">\n                <div>\n                  <h3 className=\"text-sm font-bold text-slate-200\">Customized Cover Letter</h3>\n                  <p className=\"text-xs text-slate-400\">\n                    Truthfully tailored for {application.company}. Cites verified projects only.\n                  </p>\n                </div>\n                <span className=\"text-xs text-indigo-400 font-mono\">\n                  Attached: {application.resumeVersion}\n                </span>\n              </div>\n\n              <textarea\n                rows={12}\n                value={coverLetter}\n                onChange={(e) => setCoverLetter(e.target.value)}\n                className=\"w-full text-xs text-slate-100 bg-slate-950 border border-slate-700 rounded-xl p-4 focus:outline-none focus:border-indigo-500 font-mono leading-relaxed\"\n              />\n            </div>\n          )}\n\n          {activeTab === \'history\' && (\n            <div className=\"space-y-4\">\n              <h3 className=\"text-sm font-bold text-slate-200\">Application Lifecycle Events</h3>\n              <div className=\"space-y-3\">\n                {application.historyLogs.map((log, idx) => (\n                  <div\n                    key={idx}\n                    className=\"p-3 rounded-xl bg-slate-950 border border-slate-800 flex items-start gap-3 text-xs\"\n                  >\n                    <div className=\"w-2 h-2 rounded-full bg-indigo-400 mt-1.5 flex-shrink-0\" />\n                    <div className=\"flex-1\">\n                      <div className=\"flex items-center justify-between\">\n                        <span className=\"font-bold text-slate-200\">{log.status}</span>\n                        <span className=\"text-[10px] text-slate-500\">\n                          {new Date(log.timestamp).toLocaleString()}\n                        </span>\n                      </div>\n                      <p className=\"text-slate-400 mt-1\">{log.note}</p>\n                      <span className=\"text-[10px] text-slate-500 uppercase tracking-widest font-semibold mt-1 inline-block\">\n                        Source: {log.source}\n                      </span>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n        </div>\n\n        {/* Footer Actions */}\n        <div className=\"px-6 py-4 border-t border-slate-800 bg-slate-950/80 flex items-center justify-between\">\n          <div className=\"flex items-center gap-2 text-xs text-slate-400\">\n            <span>Status:</span>\n            <span\n              className={`font-bold px-2 py-0.5 rounded text-[11px] ${\n                application.status === \'APPLIED\'\n                  ? \'bg-emerald-500/20 text-emerald-300\'\n                  : application.status === \'INTERVIEW\'\n                  ? \'bg-purple-500/20 text-purple-300\'\n                  : \'bg-amber-500/20 text-amber-300\'\n              }`}\n            >\n              {application.status.replace(/_/g, \' \')}\n            </span>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            <button\n              onClick={onClose}\n              className=\"px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold transition-colors\"\n            >\n              Close\n            </button>\n\n            {isWaitingApproval ? (\n              <button\n                id=\"modal-approve-and-submit-btn\"\n                onClick={handleApproveSubmit}\n                disabled={isSubmitting}\n                className=\"flex items-center gap-2 px-5 py-2 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold text-xs shadow-lg shadow-emerald-600/30 transition-all hover:scale-[1.02] active:scale-95 disabled:opacity-50\"\n              >\n                {isSubmitting ? (\n                  <Loader2 className=\"w-4 h-4 animate-spin\" />\n                ) : (\n                  <CheckCircle2 className=\"w-4 h-4\" />\n                )}\n                <span>{isSubmitting ? \'Submitting Application...\' : \'Approve & Submit Application\'}</span>\n              </button>\n            ) : (\n              <div className=\"flex items-center gap-2\">\n                {onUpdateStatus && (\n                  <select\n                    value={application.status}\n                    onChange={(e) => onUpdateStatus(application.id, e.target.value)}\n                    className=\"text-xs bg-slate-900 border border-slate-700 text-slate-200 rounded-lg px-3 py-1.5 focus:outline-none\"\n                  >\n                    <option value=\"APPLIED\">APPLIED</option>\n                    <option value=\"SCREENING\">SCREENING</option>\n                    <option value=\"INTERVIEW\">INTERVIEW</option>\n                    <option value=\"OFFER\">OFFER</option>\n                    <option value=\"REJECTED\">REJECTED</option>\n                    <option value=\"WITHDRAWN\">WITHDRAWN</option>\n                  </select>\n                )}\n                <span className=\"text-xs text-emerald-400 font-semibold flex items-center gap-1\">\n                  <CheckCircle2 className=\"w-4 h-4\" />\n                  Submitted\n                </span>\n              </div>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
        replacement_content: "import React, { useState } from \'react\';\nimport {\n  X,\n  CheckCircle2,\n  AlertCircle,\n  Building,\n  MapPin,\n  Flame,\n  FileText,\n  Sparkles,\n  Edit3,\n  ExternalLink,\n  ShieldCheck,\n  Send,\n  Loader2,\n  Lock,\n  Copy,\n  Check\n} from \'lucide-react\';\nimport { PreparedApplication, ApplicationFormField } from \'../types\';\nimport confetti from \'canvas-confetti\';\n\ninterface ApplicationApprovalModalProps {\n  application: PreparedApplication | null;\n  onClose: () => void;\n  onApprove: (appId: string, editedFields: ApplicationFormField[], editedCoverLetter: string) => Promise<void>;\n  onUpdateStatus?: (appId: string, status: any) => void;\n}\n\nexport const ApplicationApprovalModal: React.FC<ApplicationApprovalModalProps> = ({\n  application,\n  onClose,\n  onApprove,\n  onUpdateStatus,\n}) => {\n  if (!application) return null;\n\n  const [formFields, setFormFields] = useState<ApplicationFormField[]>(application.formFields || []);\n  const [coverLetter, setCoverLetter] = useState<string>(application.coverLetterContent || \'\');\n  const [activeTab, setActiveTab] = useState<\'fields\' | \'cover_letter\' | \'history\'>(\'fields\');\n  const [isSubmitting, setIsSubmitting] = useState(false);\n  const [isSuccess, setIsSuccess] = useState(application.status === \'APPLIED\');\n  const [copiedFieldId, setCopiedFieldId] = useState<string | null>(null);\n  const [copiedCoverLetter, setCopiedCoverLetter] = useState(false);\n  const [copiedAllFields, setCopiedAllFields] = useState(false);\n\n  const handleFieldChange = (fieldId: string, value: string | boolean) => {\n    setFormFields((prev) =>\n      prev.map((f) => (f.fieldId === fieldId ? { ...f, value } : f))\n    );\n  };\n\n  const copyFieldText = (fieldId: string, text: string) => {\n    navigator.clipboard.writeText(text);\n    setCopiedFieldId(fieldId);\n    setTimeout(() => setCopiedFieldId(null), 2000);\n  };\n\n  const copyAllFieldsText = () => {\n    const summary = formFields\n      .map((f) => `Q: ${f.label}\\nA: ${String(f.value)}`)\n      .join(\'\\n\\n\');\n    navigator.clipboard.writeText(summary);\n    setCopiedAllFields(true);\n    setTimeout(() => setCopiedAllFields(false), 2000);\n  };\n\n  const copyCoverLetterText = () => {\n    navigator.clipboard.writeText(coverLetter);\n    setCopiedCoverLetter(true);\n    setTimeout(() => setCopiedCoverLetter(false), 2000);\n  };\n\n  const handleApproveSubmit = async () => {\n    setIsSubmitting(true);\n    try {\n      await onApprove(application.id, formFields, coverLetter);\n      setIsSuccess(true);\n      try {\n        confetti({\n          particleCount: 80,\n          spread: 70,\n          origin: { y: 0.6 },\n        });\n      } catch (e) {}\n    } catch (err) {\n      console.error(err);\n    } finally {\n      setIsSubmitting(false);\n    }\n  };\n\n  const isWaitingApproval = application.status === \'WAITING_FOR_APPROVAL\';\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-in fade-in duration-200\">\n      <div className=\"relative w-full max-w-4xl max-h-[90vh] bg-slate-900 border border-slate-700 rounded-2xl shadow-2xl flex flex-col overflow-hidden\">\n        {/* Header */}\n        <div className=\"px-6 py-4 border-b border-slate-800 flex items-center justify-between bg-slate-950/60\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-indigo-600/20 border border-indigo-500/30 flex items-center justify-center text-indigo-400\">\n              <Building className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h2 className=\"text-lg font-bold text-white tracking-tight\">{application.jobTitle}</h2>\n                <span\n                  className={`px-2 py-0.5 rounded-full text-xs font-bold ${\n                    application.matchScore >= 90\n                      ? \'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40\'\n                      : \'bg-indigo-500/20 text-indigo-300 border border-indigo-500/40\'\n                  }`}\n                >\n                  <Flame className=\"w-3 h-3 inline mr-1\" />\n                  {application.matchScore}% Match\n                </span>\n              </div>\n              <p className=\"text-xs text-slate-400 flex items-center gap-2 mt-0.5\">\n                <span className=\"font-semibold text-slate-300\">{application.company}</span>\n                <span>\342\200\242</span>\n                {application.applicationUrl && application.applicationUrl !== \'#\' && (\n                  <a\n                    href={application.applicationUrl}\n                    target=\"_blank\"\n                    rel=\"noopener noreferrer\"\n                    className=\"text-indigo-400 hover:underline flex items-center gap-1 font-semibold\"\n                  >\n                    <span>Open Company Portal</span>\n                    <ExternalLink className=\"w-3 h-3\" />\n                  </a>\n                )}\n              </p>\n            </div>\n          </div>\n\n          <button\n            onClick={onClose}\n            className=\"p-2 rounded-lg bg-slate-800 text-slate-400 hover:text-white hover:bg-slate-700 transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Human-in-the-Loop Safety Banner */}\n        {isWaitingApproval && (\n          <div className=\"px-6 py-2.5 bg-amber-500/10 border-b border-amber-500/20 flex items-center justify-between text-xs text-amber-300\">\n            <div className=\"flex items-center gap-2\">\n              <ShieldCheck className=\"w-4 h-4 text-amber-400\" />\n              <span>\n                <strong>Human Approval Required:</strong> Review auto-filled application responses and cover letter\n                before final submission.\n              </span>\n            </div>\n            <span className=\"text-[11px] font-mono text-amber-400/80\">Human-In-The-Loop Active</span>\n          </div>\n        )}\n\n        {/* Tab Navigation */}\n        <div className=\"flex items-center justify-between px-6 border-b border-slate-800 bg-slate-900/50\">\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={() => setActiveTab(\'fields\')}\n              className={`py-3 px-3 border-b-2 text-xs font-semibold flex items-center gap-1.5 transition-colors ${\n                activeTab === \'fields\'\n                  ? \'border-indigo-500 text-indigo-300\'\n                  : \'border-transparent text-slate-400 hover:text-slate-200\'\n              }`}\n            >\n              <Edit3 className=\"w-3.5 h-3.5\" />\n              <span>Form Fields & Custom Q&A ({formFields.length})</span>\n            </button>\n            <button\n              onClick={() => setActiveTab(\'cover_letter\')}\n              className={`py-3 px-3 border-b-2 text-xs font-semibold flex items-center gap-1.5 transition-colors ${\n                activeTab === \'cover_letter\'\n                  ? \'border-indigo-500 text-indigo-300\'\n                  : \'border-transparent text-slate-400 hover:text-slate-200\'\n              }`}\n            >\n              <FileText className=\"w-3.5 h-3.5\" />\n              <span>Tailored Cover Letter</span>\n            </button>\n            <button\n              onClick={() => setActiveTab(\'history\')}\n              className={`py-3 px-3 border-b-2 text-xs font-semibold flex items-center gap-1.5 transition-colors ${\n                activeTab === \'history\'\n                  ? \'border-indigo-500 text-indigo-300\'\n                  : \'border-transparent text-slate-400 hover:text-slate-200\'\n              }`}\n            >\n              <Sparkles className=\"w-3.5 h-3.5\" />\n              <span>Audit Trail ({application.historyLogs.length})</span>\n            </button>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            {activeTab === \'fields\' && (\n              <button\n                onClick={copyAllFieldsText}\n                className=\"flex items-center gap-1 px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-[11px] font-semibold transition-colors\"\n              >\n                {copiedAllFields ? <Check className=\"w-3 h-3 text-emerald-400\" /> : <Copy className=\"w-3 h-3 text-indigo-400\" />}\n                <span>{copiedAllFields ? \'Copied All\' : \'Copy All Q&A\'}</span>\n              </button>\n            )}\n            {activeTab === \'cover_letter\' && (\n              <button\n                onClick={copyCoverLetterText}\n                className=\"flex items-center gap-1 px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-[11px] font-semibold transition-colors\"\n              >\n                {copiedCoverLetter ? <Check className=\"w-3 h-3 text-emerald-400\" /> : <Copy className=\"w-3 h-3 text-indigo-400\" />}\n                <span>{copiedCoverLetter ? \'Copied Letter\' : \'Copy Cover Letter\'}</span>\n              </button>\n            )}\n          </div>\n        </div>\n\n        {/* Body Content */}\n        <div className=\"flex-1 overflow-y-auto p-6 space-y-6\">\n          {activeTab === \'fields\' && (\n            <div className=\"space-y-4\">\n              <div className=\"flex items-center justify-between\">\n                <h3 className=\"text-sm font-bold text-slate-200\">Application Form Inputs</h3>\n                <span className=\"text-xs text-slate-400\">All fields editable & quick-copyable</span>\n              </div>\n\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                {formFields.map((field) => (\n                  <div\n                    key={field.fieldId}\n                    className={`p-3.5 rounded-xl border transition-all ${\n                      field.type === \'textarea\' ? \'md:col-span-2\' : \'\'\n                    } ${\n                      field.isAiGenerated\n                        ? \'bg-indigo-950/20 border-indigo-500/30\'\n                        : \'bg-slate-950/60 border-slate-800\'\n                    }`}\n                  >\n                    <div className=\"flex items-center justify-between mb-1.5\">\n                      <label className=\"text-xs font-bold text-slate-300 flex items-center gap-1.5\">\n                        <span>{field.label}</span>\n                        {field.required && <span className=\"text-rose-400\">*</span>}\n                      </label>\n                      <div className=\"flex items-center gap-2\">\n                        {field.isAiGenerated && (\n                          <span className=\"px-1.5 py-0.5 rounded text-[10px] font-semibold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 flex items-center gap-1\">\n                            <Sparkles className=\"w-2.5 h-2.5\" />\n                            AI Synthesized\n                          </span>\n                        )}\n                        <button\n                          type=\"button\"\n                          onClick={() => copyFieldText(field.fieldId, String(field.value))}\n                          className=\"text-slate-400 hover:text-white p-1 rounded hover:bg-slate-800 transition-colors\"\n                          title=\"Copy value\"\n                        >\n                          {copiedFieldId === field.fieldId ? (\n                            <Check className=\"w-3 h-3 text-emerald-400\" />\n                          ) : (\n                            <Copy className=\"w-3 h-3\" />\n                          )}\n                        </button>\n                      </div>\n                    </div>\n\n                    {field.type === \'textarea\' ? (\n                      <textarea\n                        rows={3}\n                        value={String(field.value)}\n                        onChange={(e) => handleFieldChange(field.fieldId, e.target.value)}\n                        className=\"w-full text-xs text-slate-100 bg-slate-900 border border-slate-700 rounded-lg p-2.5 focus:outline-none focus:border-indigo-500 font-sans leading-relaxed\"\n                      />\n                    ) : (\n                      <input\n                        type=\"text\"\n                        value={String(field.value)}\n                        onChange={(e) => handleFieldChange(field.fieldId, e.target.value)}\n                        className=\"w-full text-xs text-slate-100 bg-slate-900 border border-slate-700 rounded-lg p-2.5 focus:outline-none focus:border-indigo-500\"\n                      />\n                    )}\n\n                    {field.reasoning && (\n                      <p className=\"text-[11px] text-slate-400 mt-1.5 italic\">\n                        Evidence basis: {field.reasoning}\n                      </p>\n                    )}\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n\n          {activeTab === \'cover_letter\' && (\n            <div className=\"space-y-3\">\n              <div className=\"flex items-center justify-between\">\n                <div>\n                  <h3 className=\"text-sm font-bold text-slate-200\">Customized Cover Letter</h3>\n                  <p className=\"text-xs text-slate-400\">\n                    Truthfully tailored for {application.company}. Cites verified projects only.\n                  </p>\n                </div>\n                <span className=\"text-xs text-indigo-400 font-mono\">\n                  Attached: {application.resumeVersion}\n                </span>\n              </div>\n\n              <textarea\n                rows={12}\n                value={coverLetter}\n                onChange={(e) => setCoverLetter(e.target.value)}\n                className=\"w-full text-xs text-slate-100 bg-slate-950 border border-slate-700 rounded-xl p-4 focus:outline-none focus:border-indigo-500 font-mono leading-relaxed\"\n              />\n            </div>\n          )}\n\n          {activeTab === \'history\' && (\n            <div className=\"space-y-4\">\n              <h3 className=\"text-sm font-bold text-slate-200\">Application Lifecycle Events</h3>\n              <div className=\"space-y-3\">\n                {application.historyLogs.map((log, idx) => (\n                  <div\n                    key={idx}\n                    className=\"p-3 rounded-xl bg-slate-950 border border-slate-800 flex items-start gap-3 text-xs\"\n                  >\n                    <div className=\"w-2 h-2 rounded-full bg-indigo-400 mt-1.5 flex-shrink-0\" />\n                    <div className=\"flex-1\">\n                      <div className=\"flex items-center justify-between\">\n                        <span className=\"font-bold text-slate-200\">{log.status}</span>\n                        <span className=\"text-[10px] text-slate-500\">\n                          {new Date(log.timestamp).toLocaleString()}\n                        </span>\n                      </div>\n                      <p className=\"text-slate-400 mt-1\">{log.note}</p>\n                      <span className=\"text-[10px] text-slate-500 uppercase tracking-widest font-semibold mt-1 inline-block\">\n                        Source: {log.source}\n                      </span>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n        </div>\n\n        {/* Footer Actions */}\n        <div className=\"px-6 py-4 border-t border-slate-800 bg-slate-950/80 flex items-center justify-between\">\n          <div className=\"flex items-center gap-2 text-xs text-slate-400\">\n            <span>Status:</span>\n            <span\n              className={`font-bold px-2 py-0.5 rounded text-[11px] ${\n                application.status === \'APPLIED\'\n                  ? \'bg-emerald-500/20 text-emerald-300\'\n                  : application.status === \'INTERVIEW\'\n                  ? \'bg-purple-500/20 text-purple-300\'\n                  : \'bg-amber-500/20 text-amber-300\'\n              }`}\n            >\n              {application.status.replace(/_/g, \' \')}\n            </span>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            <button\n              onClick={onClose}\n              className=\"px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold transition-colors\"\n            >\n              Close\n            </button>\n\n            {isWaitingApproval ? (\n              <button\n                id=\"modal-approve-and-submit-btn\"\n                onClick={handleApproveSubmit}\n                disabled={isSubmitting}\n                className=\"flex items-center gap-2 px-5 py-2 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold text-xs shadow-lg shadow-emerald-600/30 transition-all hover:scale-[1.02] active:scale-95 disabled:opacity-50\"\n              >\n                {isSubmitting ? (\n                  <Loader2 className=\"w-4 h-4 animate-spin\" />\n                ) : (\n                  <CheckCircle2 className=\"w-4 h-4\" />\n                )}\n                <span>{isSubmitting ? \'Submitting Application...\' : \'Approve & Submit Application\'}</span>\n              </button>\n            ) : (\n              <div className=\"flex items-center gap-2\">\n                {onUpdateStatus && (\n                  <select\n                    value={application.status}\n                    onChange={(e) => onUpdateStatus(application.id, e.target.value)}\n                    className=\"text-xs bg-slate-900 border border-slate-700 text-slate-200 rounded-lg px-3 py-1.5 focus:outline-none\"\n                  >\n                    <option value=\"APPLIED\">APPLIED</option>\n                    <option value=\"SCREENING\">SCREENING</option>\n                    <option value=\"INTERVIEW\">INTERVIEW</option>\n                    <option value=\"OFFER\">OFFER</option>\n                    <option value=\"REJECTED\">REJECTED</option>\n                    <option value=\"WITHDRAWN\">WITHDRAWN</option>\n                  </select>\n                )}\n                <span className=\"text-xs text-emerald-400 font-semibold flex items-center gap-1\">\n                  <CheckCircle2 className=\"w-4 h-4\" />\n                  Submitted\n                </span>\n              </div>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
