    instruction: "Add file upload and export actions in ProfileView.tsx"
    replacement_infos {
      original_chunk {
        target_content: "        <div className=\"flex items-center gap-3\">\n          {saveSuccess && (\n            <span className=\"text-xs font-semibold text-emerald-400 flex items-center gap-1\">\n              <CheckCircle2 className=\"w-4 h-4\" />\n              Saved successfully\n            </span>\n          )}\n          <button\n            id=\"save-profile-btn\"\n            onClick={handleSave}\n            disabled={isSaving}\n            className=\"flex items-center gap-1.5 px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-md shadow-indigo-600/20 transition-all hover:scale-[1.02] active:scale-95 disabled:opacity-50\"\n          >\n            {isSaving ? <Loader2 className=\"w-3.5 h-3.5 animate-spin\" /> : <Save className=\"w-3.5 h-3.5\" />}\n            <span>{isSaving ? \'Saving Profile...\' : \'Save Profile Changes\'}</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Resume AI Parser Box */}\n      <div className=\"p-5 rounded-2xl bg-gradient-to-r from-slate-900 via-indigo-950/40 to-slate-900 border border-indigo-500/20 space-y-4\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <Sparkles className=\"w-4 h-4 text-indigo-400\" />\n            <h2 className=\"text-sm font-bold text-white\">AI Resume Extraction Engine</h2>\n          </div>\n          <span className=\"text-[11px] text-indigo-300\">Gemini 3.7 Structured Parser</span>\n        </div>\n\n        <p className=\"text-xs text-slate-300\">\n          Paste your raw resume text below. The AI will automatically extract work history, metrics, tech stack skills,\n          and career timelines into structured candidate fields.\n        </p>\n\n        <textarea\n          rows={3}\n          value={resumeText}\n          onChange={(e) => setResumeText(e.target.value)}\n          placeholder=\"Paste raw resume or LinkedIn text here (e.g. Alex Morgan, Senior Backend Engineer, 7+ years in Go/Node.js, AWS, Postgres, Kafka...)\"\n          className=\"w-full text-xs text-slate-200 bg-slate-950/80 border border-slate-700 rounded-xl p-3 focus:outline-none focus:border-indigo-500 font-mono\"\n        />\n\n        <div className=\"flex items-center justify-between\">\n          <span className=\"text-[11px] text-slate-500\">Extracts skills, titles, metrics, and experience automatically</span>\n          <button\n            onClick={handleParse}\n            disabled={isParsing || !resumeText.trim()}\n            className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold transition-colors disabled:opacity-50\"\n          >\n            {isParsing ? <Loader2 className=\"w-3.5 h-3.5 animate-spin\" /> : <Sparkles className=\"w-3.5 h-3.5\" />}\n            <span>{isParsing ? \'Parsing Resume...\' : \'Parse & Update Profile\'}</span>\n          </button>\n        </div>\n      </div>"
        replacement_content: "        <div className=\"flex items-center gap-3\">\n          {saveSuccess && (\n            <span className=\"text-xs font-semibold text-emerald-400 flex items-center gap-1\">\n              <CheckCircle2 className=\"w-4 h-4\" />\n              Saved successfully\n            </span>\n          )}\n          <button\n            onClick={handleExportProfile}\n            className=\"flex items-center gap-1.5 px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 text-xs font-semibold transition-colors\"\n          >\n            <Download className=\"w-3.5 h-3.5 text-indigo-400\" />\n            <span>Export JSON</span>\n          </button>\n          <button\n            id=\"save-profile-btn\"\n            onClick={handleSave}\n            disabled={isSaving}\n            className=\"flex items-center gap-1.5 px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-md shadow-indigo-600/20 transition-all hover:scale-[1.02] active:scale-95 disabled:opacity-50\"\n          >\n            {isSaving ? <Loader2 className=\"w-3.5 h-3.5 animate-spin\" /> : <Save className=\"w-3.5 h-3.5\" />}\n            <span>{isSaving ? \'Saving Profile...\' : \'Save Profile Changes\'}</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Resume AI Parser Box */}\n      <div className=\"p-5 rounded-2xl bg-gradient-to-r from-slate-900 via-indigo-950/40 to-slate-900 border border-indigo-500/20 space-y-4\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <Sparkles className=\"w-4 h-4 text-indigo-400\" />\n            <h2 className=\"text-sm font-bold text-white\">AI Resume Extraction Engine</h2>\n          </div>\n          <span className=\"text-[11px] text-indigo-300\">Gemini 3.7 Structured Parser</span>\n        </div>\n\n        <p className=\"text-xs text-slate-300\">\n          Upload a resume file (.txt, .md, .json) or paste your raw text below. The AI will automatically extract work history, metrics, tech stack skills,\n          and career timelines into structured candidate fields.\n        </p>\n\n        <textarea\n          rows={3}\n          value={resumeText}\n          onChange={(e) => setResumeText(e.target.value)}\n          placeholder=\"Paste raw resume or LinkedIn text here (e.g. Alex Morgan, Senior Backend Engineer, 7+ years in Go/Node.js, AWS, Postgres, Kafka...)\"\n          className=\"w-full text-xs text-slate-200 bg-slate-950/80 border border-slate-700 rounded-xl p-3 focus:outline-none focus:border-indigo-500 font-mono\"\n        />\n\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div className=\"flex items-center gap-2\">\n            <input\n              type=\"file\"\n              ref={fileInputRef}\n              onChange={handleFileUpload}\n              accept=\".txt,.md,.json,.pdf,.doc,.docx\"\n              className=\"hidden\"\n            />\n            <button\n              type=\"button\"\n              onClick={() => fileInputRef.current?.click()}\n              className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold transition-colors\"\n            >\n              <Upload className=\"w-3.5 h-3.5 text-indigo-400\" />\n              <span>Upload Resume File</span>\n            </button>\n            <span className=\"text-[11px] text-slate-500\">Supports .txt, .md, .json</span>\n          </div>\n\n          <button\n            onClick={handleParse}\n            disabled={isParsing || !resumeText.trim()}\n            className=\"flex items-center justify-center gap-1.5 px-4 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold transition-colors disabled:opacity-50\"\n          >\n            {isParsing ? <Loader2 className=\"w-3.5 h-3.5 animate-spin\" /> : <Sparkles className=\"w-3.5 h-3.5\" />}\n            <span>{isParsing ? \'Parsing Resume...\' : \'Parse & Update Profile\'}</span>\n          </button>\n        </div>\n      </div>"
      }
      num_matches: 1
    }
  }
}
