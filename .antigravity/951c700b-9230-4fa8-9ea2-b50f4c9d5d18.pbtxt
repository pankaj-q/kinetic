  file_change {
    absolute_path_uri: "file:///src/components/Navbar.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  Briefcase,\n  LayoutDashboard,\n  Sparkles,\n  Layers,\n  FileText,\n  Mail,\n  Send,\n  Sliders,\n  Bell,\n  CheckCircle2,\n  Bot,\n  Flame,\n  Clock,\n  ExternalLink,\n  ChevronRight\n} from \'lucide-react\';\nimport { NotificationMessage, TelegramConfig } from \'../types\';\n\ninterface NavbarProps {\n  activeTab: string;\n  setActiveTab: (tab: string) => void;\n  notifications: NotificationMessage[];\n  unreadCount: number;\n  telegramConfig: TelegramConfig;\n  onMarkNotificationRead: (id: string) => void;\n  onClearNotifications: () => void;\n  onOpenApplication?: (appId: string) => void;\n  isAgentRunning?: boolean;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({\n  activeTab,\n  setActiveTab,\n  notifications,\n  unreadCount,\n  telegramConfig,\n  onMarkNotificationRead,\n  onClearNotifications,\n  onOpenApplication,\n  isAgentRunning,\n}) => {\n  const [showNotifPopover, setShowNotifPopover] = useState(false);\n\n  const navItems = [\n    { id: \'dashboard\', label: \'Dashboard\', icon: LayoutDashboard },\n    { id: \'jobs\', label: \'Jobs & Matching\', icon: Briefcase },\n    { id: \'applications\', label: \'Application Board\', icon: Layers },\n    { id: \'agent\', label: \'AI Agent Console\', icon: Bot, badge: isAgentRunning ? \'Running\' : undefined },\n    { id: \'profile\', label: \'Resume & Profile\', icon: FileText },\n    { id: \'cover-letters\', label: \'Cover Letters\', icon: Sparkles },\n    { id: \'email-monitor\', label: \'Email Monitor\', icon: Mail },\n    { id: \'settings\', label: \'Scheduler & Telegram\', icon: Sliders },\n  ];\n\n  return (\n    <header className=\"sticky top-0 z-40 w-full border-b border-slate-800 bg-slate-950/80 backdrop-blur-md\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between h-16\">\n          {/* Logo & Brand */}\n          <div className=\"flex items-center gap-3\">\n            <div\n              id=\"jobagent-brand\"\n              onClick={() => setActiveTab(\'dashboard\')}\n              className=\"flex items-center gap-2.5 cursor-pointer group\"\n            >\n              <div className=\"w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 via-blue-600 to-violet-600 flex items-center justify-center shadow-lg shadow-indigo-500/20 group-hover:scale-105 transition-transform duration-200\">\n                <Bot className=\"w-5 h-5 text-white\" />\n              </div>\n              <div>\n                <div className=\"flex items-center gap-1.5\">\n                  <span className=\"font-bold text-lg text-white tracking-tight\">JobAgent</span>\n                  <span className=\"text-[10px] uppercase font-bold tracking-widest px-1.5 py-0.5 rounded bg-indigo-500/20 text-indigo-300 border border-indigo-500/30\">\n                    AI PRO\n                  </span>\n                </div>\n                <p className=\"text-[11px] text-slate-400 font-medium\">Autonomous Job Engine</p>\n              </div>\n            </div>\n\n            {/* Live Agent Status Pill */}\n            <div className=\"hidden lg:flex items-center gap-2 pl-4 ml-4 border-l border-slate-800\">\n              <div className=\"flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-900 border border-slate-800 text-xs\">\n                <span\n                  className={`w-2 h-2 rounded-full ${\n                    isAgentRunning ? \'bg-amber-400 animate-pulse\' : \'bg-emerald-400\'\n                  }`}\n                />\n                <span className=\"text-slate-300 font-medium\">\n                  {isAgentRunning ? \'Agent Active\' : \'Autonomous Engine Idle\'}\n                </span>\n              </div>\n\n              {/* Telegram Status indicator */}\n              <button\n                onClick={() => setActiveTab(\'settings\')}\n                className={`flex items-center gap-1 px-2.5 py-1 rounded-full text-xs transition-colors ${\n                  telegramConfig.enabled && telegramConfig.botToken\n                    ? \'bg-blue-950/60 text-blue-300 border border-blue-800/60 hover:bg-blue-900/60\'\n                    : \'bg-slate-900 text-slate-400 border border-slate-800 hover:text-slate-200\'\n                }`}\n              >\n                <Send className=\"w-3 h-3\" />\n                <span>{telegramConfig.enabled && telegramConfig.botToken ? \'Telegram Synced\' : \'Connect Telegram\'}</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Center Navigation Tabs */}\n          <nav className=\"hidden md:flex items-center gap-1 overflow-x-auto py-1\">\n            {navItems.map((item) => {\n              const Icon = item.icon;\n              const isActive = activeTab === item.id;\n              return (\n                <button\n                  key={item.id}\n                  id={`nav-tab-${item.id}`}\n                  onClick={() => setActiveTab(item.id)}\n                  className={`relative flex items-center gap-2 px-3 py-2 rounded-lg text-xs font-semibold tracking-wide transition-all whitespace-nowrap ${\n                    isActive\n                      ? \'bg-indigo-600/20 text-indigo-300 border border-indigo-500/40 shadow-sm shadow-indigo-500/10\'\n                      : \'text-slate-400 hover:text-slate-200 hover:bg-slate-900\'\n                  }`}\n                >\n                  <Icon className={`w-4 h-4 ${isActive ? \'text-indigo-400\' : \'text-slate-400\'}`} />\n                  <span>{item.label}</span>\n                  {item.badge && (\n                    <span className=\"px-1.5 py-0.5 rounded-full text-[9px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30 animate-pulse\">\n                      {item.badge}\n                    </span>\n                  )}\n                </button>\n              );\n            })}\n          </nav>\n\n          {/* Right Action: Notifications & Trigger Agent */}\n          <div className=\"flex items-center gap-2.5\">\n            {/* Quick Agent Run Button */}\n            <button\n              id=\"header-quick-run-agent\"\n              onClick={() => setActiveTab(\'agent\')}\n              className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-500 hover:to-blue-500 text-white text-xs font-semibold shadow-md shadow-indigo-600/20 transition-all hover:scale-[1.02] active:scale-95\"\n            >\n              <Bot className=\"w-3.5 h-3.5\" />\n              <span className=\"hidden sm:inline\">Run AI Agent</span>\n            </button>\n\n            {/* Notifications Bell */}\n            <div className=\"relative\">\n              <button\n                id=\"notifications-bell-button\"\n                onClick={() => setShowNotifPopover(!showNotifPopover)}\n                className=\"relative p-2 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:text-white hover:bg-slate-800 transition-colors\"\n                aria-label=\"Notifications\"\n              >\n                <Bell className=\"w-4 h-4\" />\n                {unreadCount > 0 && (\n                  <span className=\"absolute -top-1 -right-1 w-4 h-4 rounded-full bg-rose-500 text-[10px] font-bold text-white flex items-center justify-center shadow-md animate-bounce\">\n                    {unreadCount > 9 ? \'9+\' : unreadCount}\n                  </span>\n                )}\n              </button>\n\n              {/* Notification Popover Dropdown */}\n              {showNotifPopover && (\n                <div className=\"absolute right-0 mt-2 w-80 sm:w-96 rounded-xl bg-slate-900 border border-slate-800 shadow-2xl shadow-black/80 py-2 z-50 animate-in fade-in slide-in-from-top-2 duration-150\">\n                  <div className=\"flex items-center justify-between px-4 py-2 border-b border-slate-800\">\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"text-sm font-bold text-slate-200\">Alerts & Telegram Stream</span>\n                      {unreadCount > 0 && (\n                        <span className=\"px-1.5 py-0.5 rounded text-[10px] font-semibold bg-indigo-500/20 text-indigo-300\">\n                          {unreadCount} new\n                        </span>\n                      )}\n                    </div>\n                    {notifications.length > 0 && (\n                      <button\n                        onClick={onClearNotifications}\n                        className=\"text-[11px] text-slate-400 hover:text-slate-200 transition-colors\"\n                      >\n                        Clear all\n                      </button>\n                    )}\n                  </div>\n\n                  <div className=\"max-h-80 overflow-y-auto divide-y divide-slate-800/60\">\n                    {notifications.length === 0 ? (\n                      <div className=\"p-6 text-center text-slate-500 text-xs\">\n                        No notifications yet. Jobs and application updates will stream here.\n                      </div>\n                    ) : (\n                      notifications.map((n) => (\n                        <div\n                          key={n.id}\n                          onClick={() => {\n                            onMarkNotificationRead(n.id);\n                            if (n.data?.applicationId && onOpenApplication) {\n                              onOpenApplication(n.data.applicationId);\n                              setShowNotifPopover(false);\n                            }\n                          }}\n                          className={`p-3.5 hover:bg-slate-800/60 transition-colors cursor-pointer ${\n                            !n.read ? \'bg-indigo-950/20\' : \'\'\n                          }`}\n                        >\n                          <div className=\"flex items-start gap-2.5\">\n                            <div className=\"mt-0.5\">\n                              {n.type === \'high_match\' && <Flame className=\"w-4 h-4 text-amber-400\" />}\n                              {n.type === \'application_prepared\' && (\n                                <FileText className=\"w-4 h-4 text-blue-400\" />\n                              )}\n                              {n.type === \'submission_success\' && (\n                                <CheckCircle2 className=\"w-4 h-4 text-emerald-400\" />\n                              )}\n                              {n.type === \'interview_detected\' && (\n                                <Sparkles className=\"w-4 h-4 text-purple-400\" />\n                              )}\n                              {n.type === \'rejection_detected\' && (\n                                <Clock className=\"w-4 h-4 text-rose-400\" />\n                              )}\n                              {n.type === \'system_alert\' && <Bot className=\"w-4 h-4 text-indigo-400\" />}\n                            </div>\n                            <div className=\"flex-1\">\n                              <div className=\"flex items-center justify-between\">\n                                <span className=\"text-xs font-semibold text-slate-200\">{n.title}</span>\n                                <span className=\"text-[10px] text-slate-500\">\n                                  {new Date(n.timestamp).toLocaleTimeString([], {\n                                    hour: \'2-digit\',\n                                    minute: \'2-digit\',\n                                  })}\n                                </span>\n                              </div>\n                              <p className=\"text-xs text-slate-400 mt-1 line-clamp-2 leading-relaxed\">\n                                {n.body}\n                              </p>\n                              {n.data?.applicationId && (\n                                <div className=\"mt-1.5 flex items-center gap-1 text-[11px] text-indigo-400 font-medium hover:underline\">\n                                  <span>Review Application</span>\n                                  <ChevronRight className=\"w-3 h-3\" />\n                                </div>\n                              )}\n                            </div>\n                          </div>\n                        </div>\n                      ))\n                    )}\n                  </div>\n                </div>\n              )}\n            </div>\n          </div>\n        </div>\n\n        {/* Mobile Navigation Row */}\n        <div className=\"md:hidden flex items-center gap-1 overflow-x-auto py-2 border-t border-slate-800/80 -mx-4 px-4 scrollbar-none\">\n          {navItems.map((item) => {\n            const Icon = item.icon;\n            const isActive = activeTab === item.id;\n            return (\n              <button\n                key={item.id}\n                onClick={() => setActiveTab(item.id)}\n                className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-colors ${\n                  isActive\n                    ? \'bg-indigo-600 text-white\'\n                    : \'text-slate-400 hover:text-slate-200 bg-slate-900\'\n                }`}\n              >\n                <Icon className=\"w-3.5 h-3.5\" />\n                <span>{item.label}</span>\n              </button>\n            );\n          })}\n        </div>\n      </div>\n    </header>\n  );\n};\n"
    }
