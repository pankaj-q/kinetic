  file_change {
    absolute_path_uri: "file:///src/components/AgentConsoleView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  Bot,\n  Play,\n  RotateCw,\n  Sparkles,\n  CheckCircle2,\n  AlertCircle,\n  Clock,\n  Code2,\n  Terminal,\n  ShieldCheck,\n  ChevronDown,\n  ChevronRight,\n  Send,\n  Layers,\n  FileText,\n  Flame,\n  ArrowRight\n} from \'lucide-react\';\nimport { AgentRunSession, AgentActionLog } from \'../types\';\n\ninterface AgentConsoleViewProps {\n  sessions: AgentRunSession[];\n  activeSession: AgentRunSession | null;\n  onRunAgent: (goal: string, minMatchScore: number) => Promise<void>;\n  isAgentRunning: boolean;\n  onNavigateTab: (tab: string) => void;\n  onOpenApplication?: (appId: string) => void;\n}\n\nexport const AgentConsoleView: React.FC<AgentConsoleViewProps> = ({\n  sessions,\n  activeSession,\n  onRunAgent,\n  isAgentRunning,\n  onNavigateTab,\n  onOpenApplication,\n}) => {\n  const [goal, setGoal] = useState(\n    \'Find high-match remote TypeScript & Node.js positions, evaluate fit scores, draft tailored cover letters, and prepare applications for human approval.\'\n  );\n  const [minMatchScore, setMinMatchScore] = useState<number>(85);\n  const [expandedLogIds, setExpandedLogIds] = useState<Record<string, boolean>>({});\n\n  const toggleLogExpand = (logId: string) => {\n    setExpandedLogIds((prev) => ({ ...prev, [logId]: !prev[logId] }));\n  };\n\n  const handleLaunch = () => {\n    if (!isAgentRunning) {\n      onRunAgent(goal, minMatchScore);\n    }\n  };\n\n  const currentSession = activeSession || (sessions.length > 0 ? sessions[0] : null);\n\n  const presets = [\n    {\n      label: \'\360\237\232\200 Full Pipeline (Backend & Distributed Systems)\',\n      prompt: \'Search remote senior backend & distributed systems jobs, calculate deep match scores, generate tailored cover letters, and prepare applications awaiting human approval.\',\n      score: 85,\n    },\n    {\n      label: \'\360\237\244\226 AI & Full Stack Roles\',\n      prompt: \'Discover full stack React, Node.js and AI agent tooling positions, evaluate technical match with candidate profile, draft customized cover letters, and notify via Telegram.\',\n      score: 80,\n    },\n    {\n      label: \'\342\232\241 Rapid Scan & Ingest Only\',\n      prompt: \'Execute multi-source job ingestion across RemoteOK, Greenhouse, and Lever, deduplicate listings, and compute match scores for all new jobs.\',\n      score: 75,\n    },\n  ];\n\n  return (\n    <div className=\"space-y-6 animate-in fade-in duration-300\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <Bot className=\"w-5 h-5 text-indigo-400\" />\n            <h1 className=\"text-xl sm:text-2xl font-bold text-white tracking-tight\">AI Agent Live Console</h1>\n          </div>\n          <p className=\"text-xs text-slate-400 mt-0.5\">\n            Autonomous multi-step ReAct reasoning loop. Executes tool calling with strict human-in-the-loop safety boundaries.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2\">\n          <span\n            className={`px-3 py-1 rounded-full text-xs font-bold flex items-center gap-1.5 ${\n              isAgentRunning\n                ? \'bg-amber-500/20 text-amber-300 border border-amber-500/40 animate-pulse\'\n                : \'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40\'\n            }`}\n          >\n            <span className={`w-2 h-2 rounded-full ${isAgentRunning ? \'bg-amber-400\' : \'bg-emerald-400\'}`} />\n            <span>{isAgentRunning ? \'Agent Loop Running\' : \'Agent Ready\'}</span>\n          </span>\n        </div>\n      </div>\n\n      {/* Agent Goal Input & Controls Box */}\n      <div className=\"p-5 sm:p-6 rounded-2xl bg-slate-900 border border-slate-800 space-y-4 shadow-md\">\n        <div className=\"space-y-2\">\n          <label className=\"text-xs font-bold text-slate-300 flex items-center justify-between\">\n            <span className=\"flex items-center gap-1.5\">\n              <Sparkles className=\"w-3.5 h-3.5 text-indigo-400\" />\n              Autonomous Agent Goal Prompt\n            </span>\n            <span className=\"text-[11px] text-slate-400\">Natural language task instruction</span>\n          </label>\n          <textarea\n            id=\"agent-goal-textarea\"\n            rows={2}\n            value={goal}\n            onChange={(e) => setGoal(e.target.value)}\n            placeholder=\"Describe the agent objective...\"\n            className=\"w-full text-xs sm:text-sm text-slate-100 bg-slate-950 border border-slate-700 rounded-xl p-3.5 focus:outline-none focus:border-indigo-500 font-sans leading-relaxed\"\n          />\n        </div>\n\n        {/* Presets */}\n        <div className=\"flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none\">\n          <span className=\"text-[11px] text-slate-500 font-semibold whitespace-nowrap\">Presets:</span>\n          {presets.map((p, i) => (\n            <button\n              key={i}\n              onClick={() => {\n                setGoal(p.prompt);\n                setMinMatchScore(p.score);\n              }}\n              className=\"px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-[11px] font-medium whitespace-nowrap transition-colors border border-slate-700/60\"\n            >\n              {p.label}\n            </button>\n          ))}\n        </div>\n\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-3 border-t border-slate-800\">\n          <div className=\"flex items-center gap-3\">\n            <label className=\"text-xs text-slate-400 font-medium\">Min Match Score:</label>\n            <div className=\"flex items-center gap-2\">\n              <input\n                type=\"range\"\n                min={60}\n                max={95}\n                step={5}\n                value={minMatchScore}\n                onChange={(e) => setMinMatchScore(Number(e.target.value))}\n                className=\"w-32 accent-indigo-500\"\n              />\n              <span className=\"text-xs font-bold text-indigo-300 w-10\">{minMatchScore}%</span>\n            </div>\n          </div>\n\n          <button\n            id=\"execute-agent-loop-btn\"\n            onClick={handleLaunch}\n            disabled={isAgentRunning || !goal.trim()}\n            className=\"flex items-center justify-center gap-2 px-6 py-2.5 rounded-xl bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-500 hover:to-blue-500 text-white font-bold text-xs shadow-lg shadow-indigo-600/30 transition-all hover:scale-[1.02] active:scale-95 disabled:opacity-50\"\n          >\n            {isAgentRunning ? (\n              <RotateCw className=\"w-4 h-4 animate-spin\" />\n            ) : (\n              <Play className=\"w-4 h-4 fill-current\" />\n            )}\n            <span>{isAgentRunning ? \'Reasoning & Executing Tools...\' : \'Execute Autonomous Agent\'}</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Metrics Banner */}\n      {currentSession && (\n        <div className=\"grid grid-cols-2 sm:grid-cols-5 gap-3 p-4 rounded-xl bg-slate-900/90 border border-slate-800\">\n          <div className=\"space-y-0.5\">\n            <span className=\"text-[11px] text-slate-400\">Jobs Discovered</span>\n            <div className=\"text-lg font-bold text-white\">{currentSession.metrics.jobsScanned}</div>\n          </div>\n          <div className=\"space-y-0.5\">\n            <span className=\"text-[11px] text-slate-400\">AI Matches Evaluated</span>\n            <div className=\"text-lg font-bold text-indigo-400\">{currentSession.metrics.jobsMatched}</div>\n          </div>\n          <div className=\"space-y-0.5\">\n            <span className=\"text-[11px] text-slate-400\">Cover Letters Written</span>\n            <div className=\"text-lg font-bold text-purple-400\">{currentSession.metrics.coverLettersGenerated}</div>\n          </div>\n          <div className=\"space-y-0.5\">\n            <span className=\"text-[11px] text-slate-400\">Applications Prepared</span>\n            <div className=\"text-lg font-bold text-amber-400\">{currentSession.metrics.applicationsPrepared}</div>\n          </div>\n          <div className=\"space-y-0.5\">\n            <span className=\"text-[11px] text-slate-400\">Telegram Notifications</span>\n            <div className=\"text-lg font-bold text-blue-400\">{currentSession.metrics.notificationsSent}</div>\n          </div>\n        </div>\n      )}\n\n      {/* Live ReAct Execution Trace / Console Logs */}\n      <div className=\"p-5 sm:p-6 rounded-2xl bg-slate-900 border border-slate-800 space-y-4\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <Terminal className=\"w-4 h-4 text-indigo-400\" />\n            <h2 className=\"text-sm font-bold text-white\">ReAct Execution Trace & Reasoning Log</h2>\n          </div>\n\n          {currentSession?.status === \'completed\' && currentSession.metrics.applicationsPrepared > 0 && (\n            <button\n              onClick={() => onNavigateTab(\'applications\')}\n              className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs transition-colors\"\n            >\n              <span>Review Prepared Applications</span>\n              <ArrowRight className=\"w-3.5 h-3.5\" />\n            </button>\n          )}\n        </div>\n\n        {!currentSession || currentSession.logs.length === 0 ? (\n          <div className=\"p-12 text-center text-slate-500 text-xs border border-dashed border-slate-800 rounded-xl space-y-2\">\n            <Bot className=\"w-8 h-8 text-slate-600 mx-auto\" />\n            <p>Click \"Execute Autonomous Agent\" above to watch the step-by-step reasoning loop live.</p>\n          </div>\n        ) : (\n          <div className=\"space-y-3.5\">\n            {currentSession.logs.map((log) => {\n              const isExpanded = expandedLogIds[log.id];\n              return (\n                <div\n                  key={log.id}\n                  className={`p-4 rounded-xl border transition-all ${\n                    log.status === \'waiting_approval\'\n                      ? \'bg-amber-950/20 border-amber-500/40\'\n                      : log.status === \'failed\'\n                      ? \'bg-rose-950/20 border-rose-500/40\'\n                      : \'bg-slate-950 border-slate-800/90\'\n                  }`}\n                >\n                  {/* Step Header */}\n                  <div className=\"flex items-start justify-between gap-2\">\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"px-2 py-0.5 rounded text-[11px] font-mono font-bold bg-slate-800 text-indigo-300\">\n                        STEP {log.step}\n                      </span>\n                      <span className=\"text-xs font-bold text-slate-200\">{log.action}</span>\n                    </div>\n\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"px-2 py-0.5 rounded text-[10px] font-mono bg-indigo-950 text-indigo-400 border border-indigo-800/60\">\n                        tool: {log.tool}\n                      </span>\n                      <span className=\"text-[10px] text-slate-500\">\n                        {new Date(log.timestamp).toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\', second: \'2-digit\' })}\n                      </span>\n                    </div>\n                  </div>\n\n                  {/* Thought / Reasoning Bubble */}\n                  <div className=\"mt-2.5 p-3 rounded-lg bg-slate-900/80 border border-slate-800 text-xs text-slate-300 leading-relaxed font-sans\">\n                    <div className=\"flex items-center gap-1.5 text-indigo-400 font-bold text-[11px] mb-1\">\n                      <Sparkles className=\"w-3 h-3\" />\n                      <span>Agent Thought / Observation</span>\n                    </div>\n                    {log.thought}\n                  </div>\n\n                  {/* Expandable Tool Input & Output payload */}\n                  <div className=\"mt-2.5 flex items-center justify-between\">\n                    <button\n                      onClick={() => toggleLogExpand(log.id)}\n                      className=\"text-[11px] text-slate-400 hover:text-slate-200 flex items-center gap-1 font-mono transition-colors\"\n                    >\n                      <Code2 className=\"w-3 h-3\" />\n                      <span>{isExpanded ? \'Hide Payload\' : \'View Tool I/O Data\'}</span>\n                      {isExpanded ? <ChevronDown className=\"w-3 h-3\" /> : <ChevronRight className=\"w-3 h-3\" />}\n                    </button>\n\n                    {log.status === \'waiting_approval\' && (\n                      <span className=\"px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40 flex items-center gap-1\">\n                        <ShieldCheck className=\"w-3 h-3\" />\n                        Human-In-The-Loop Guard\n                      </span>\n                    )}\n                  </div>\n\n                  {isExpanded && (\n                    <div className=\"mt-2 grid grid-cols-1 md:grid-cols-2 gap-2 text-[11px] font-mono pt-2 border-t border-slate-800\">\n                      <div className=\"bg-slate-900 p-2.5 rounded-lg overflow-x-auto\">\n                        <span className=\"text-slate-500 font-bold block mb-1\">Input Arguments:</span>\n                        <pre className=\"text-slate-300\">{JSON.stringify(log.input, null, 2)}</pre>\n                      </div>\n                      <div className=\"bg-slate-900 p-2.5 rounded-lg overflow-x-auto\">\n                        <span className=\"text-slate-500 font-bold block mb-1\">Execution Output:</span>\n                        <pre className=\"text-slate-300\">{JSON.stringify(log.output, null, 2)}</pre>\n                      </div>\n                    </div>\n                  )}\n                </div>\n              );\n            })}\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
    }
