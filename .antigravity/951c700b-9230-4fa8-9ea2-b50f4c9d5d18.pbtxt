  file_change {
    absolute_path_uri: "file:///src/components/CoverLettersView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  Sparkles,\n  FileText,\n  Copy,\n  Check,\n  Building,\n  RotateCw,\n  Edit3,\n  Flame,\n  Download,\n  CheckCircle2\n} from \'lucide-react\';\nimport { CoverLetter, Job } from \'../types\';\n\ninterface CoverLettersViewProps {\n  coverLetters: CoverLetter[];\n  jobs: Job[];\n  onGenerate: (jobId: string, tone: any) => Promise<void>;\n}\n\nexport const CoverLettersView: React.FC<CoverLettersViewProps> = ({\n  coverLetters,\n  jobs,\n  onGenerate,\n}) => {\n  const [selectedLetter, setSelectedLetter] = useState<CoverLetter | null>(\n    coverLetters.length > 0 ? coverLetters[0] : null\n  );\n  const [selectedTone, setSelectedTone] = useState<\'professional\' | \'conversational\' | \'technical\' | \'enthusiastic\'>(\'professional\');\n  const [selectedJobId, setSelectedJobId] = useState<string>(jobs[0]?.id || \'\');\n  const [isGenerating, setIsGenerating] = useState(false);\n  const [copied, setCopied] = useState(false);\n\n  const handleCopy = () => {\n    if (selectedLetter) {\n      navigator.clipboard.writeText(selectedLetter.content);\n      setCopied(true);\n      setTimeout(() => setCopied(false), 2000);\n    }\n  };\n\n  const handleGenerate = async () => {\n    if (!selectedJobId) return;\n    setIsGenerating(true);\n    try {\n      await onGenerate(selectedJobId, selectedTone);\n    } finally {\n      setIsGenerating(false);\n    }\n  };\n\n  return (\n    <div className=\"space-y-6 animate-in fade-in duration-300\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <Sparkles className=\"w-5 h-5 text-indigo-400\" />\n            <h1 className=\"text-xl sm:text-2xl font-bold text-white tracking-tight\">\n              Bespoke Cover Letter Studio\n            </h1>\n          </div>\n          <p className=\"text-xs text-slate-400 mt-0.5\">\n            Generates truthful, role-tailored cover letters that cite real verified accomplishments without hallucination.\n          </p>\n        </div>\n      </div>\n\n      {/* Generator Tool Bar */}\n      <div className=\"p-4 rounded-xl bg-slate-900 border border-slate-800 space-y-3\">\n        <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n          <div>\n            <label className=\"text-xs font-bold text-slate-300 block mb-1\">Target Job</label>\n            <select\n              value={selectedJobId}\n              onChange={(e) => setSelectedJobId(e.target.value)}\n              className=\"w-full py-2 px-3 rounded-lg bg-slate-950 border border-slate-700 text-xs text-slate-200 focus:outline-none focus:border-indigo-500\"\n            >\n              {jobs.map((j) => (\n                <option key={j.id} value={j.id}>\n                  {j.company} - {j.title}\n                </option>\n              ))}\n            </select>\n          </div>\n\n          <div>\n            <label className=\"text-xs font-bold text-slate-300 block mb-1\">Tone & Voice</label>\n            <select\n              value={selectedTone}\n              onChange={(e) => setSelectedTone(e.target.value as any)}\n              className=\"w-full py-2 px-3 rounded-lg bg-slate-950 border border-slate-700 text-xs text-slate-200 focus:outline-none focus:border-indigo-500\"\n            >\n              <option value=\"professional\">Professional & Direct</option>\n              <option value=\"technical\">Technical & Metrics-Driven</option>\n              <option value=\"conversational\">Warm & Conversational</option>\n              <option value=\"enthusiastic\">Enthusiastic & High Energy</option>\n            </select>\n          </div>\n\n          <div className=\"flex items-end\">\n            <button\n              onClick={handleGenerate}\n              disabled={isGenerating || !selectedJobId}\n              className=\"w-full flex items-center justify-center gap-1.5 py-2 px-4 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-md shadow-indigo-600/20 transition-all disabled:opacity-50\"\n            >\n              {isGenerating ? (\n                <RotateCw className=\"w-3.5 h-3.5 animate-spin\" />\n              ) : (\n                <Sparkles className=\"w-3.5 h-3.5\" />\n              )}\n              <span>{isGenerating ? \'Synthesizing Letter...\' : \'Generate Bespoke Letter\'}</span>\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Main Split: Saved Letters List + Full Preview */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        {/* Left Col: Letters List */}\n        <div className=\"space-y-3\">\n          <h3 className=\"text-xs font-bold text-slate-400 uppercase tracking-wider\">\n            Generated Library ({coverLetters.length})\n          </h3>\n\n          <div className=\"space-y-2.5 max-h-[65vh] overflow-y-auto\">\n            {coverLetters.length === 0 ? (\n              <div className=\"p-8 text-center text-slate-500 text-xs bg-slate-900/60 rounded-xl border border-slate-800\">\n                No cover letters generated yet. Choose a job above to create one.\n              </div>\n            ) : (\n              coverLetters.map((cl) => {\n                const isSelected = selectedLetter?.id === cl.id;\n                return (\n                  <div\n                    key={cl.id}\n                    onClick={() => setSelectedLetter(cl)}\n                    className={`p-3.5 rounded-xl border cursor-pointer transition-all space-y-1.5 ${\n                      isSelected\n                        ? \'bg-indigo-950/30 border-indigo-500 shadow-md\'\n                        : \'bg-slate-900 border-slate-800 hover:border-slate-700\'\n                    }`}\n                  >\n                    <div className=\"flex items-center justify-between\">\n                      <span className=\"font-bold text-xs text-white\">{cl.company}</span>\n                      <span className=\"text-[10px] text-slate-500 capitalize\">{cl.tone}</span>\n                    </div>\n                    <p className=\"text-xs text-slate-300 line-clamp-1\">{cl.jobTitle}</p>\n                    <p className=\"text-[11px] text-slate-500 line-clamp-2\">{cl.content.slice(0, 100)}...</p>\n                  </div>\n                );\n              })\n            )}\n          </div>\n        </div>\n\n        {/* Right 2 Cols: Editor & Full Text Preview */}\n        <div className=\"lg:col-span-2 space-y-3\">\n          {selectedLetter ? (\n            <div className=\"p-6 rounded-2xl bg-slate-900 border border-slate-800 space-y-4 shadow-sm\">\n              <div className=\"flex items-center justify-between border-b border-slate-800 pb-3\">\n                <div>\n                  <h2 className=\"text-base font-bold text-white\">{selectedLetter.jobTitle}</h2>\n                  <p className=\"text-xs text-slate-400 flex items-center gap-1.5 mt-0.5\">\n                    <Building className=\"w-3.5 h-3.5 text-slate-500\" />\n                    <span>{selectedLetter.company}</span>\n                    <span>\342\200\242</span>\n                    <span className=\"text-indigo-400 capitalize\">{selectedLetter.tone} tone</span>\n                  </p>\n                </div>\n\n                <div className=\"flex items-center gap-2\">\n                  <button\n                    onClick={handleCopy}\n                    className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold transition-colors\"\n                  >\n                    {copied ? <Check className=\"w-3.5 h-3.5 text-emerald-400\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                    <span>{copied ? \'Copied\' : \'Copy Text\'}</span>\n                  </button>\n                </div>\n              </div>\n\n              {selectedLetter.tailoredHighlights && selectedLetter.tailoredHighlights.length > 0 && (\n                <div className=\"p-3 rounded-xl bg-indigo-950/20 border border-indigo-500/20 space-y-1 text-xs\">\n                  <span className=\"font-bold text-indigo-300\">Custom Role Alignment Points:</span>\n                  <ul className=\"list-disc list-inside text-slate-300 space-y-0.5\">\n                    {selectedLetter.tailoredHighlights.map((h, i) => (\n                      <li key={i}>{h}</li>\n                    ))}\n                  </ul>\n                </div>\n              )}\n\n              <div className=\"space-y-1\">\n                <label className=\"text-xs font-semibold text-slate-400\">Letter Body (Editable):</label>\n                <textarea\n                  rows={14}\n                  value={selectedLetter.content}\n                  onChange={(e) =>\n                    setSelectedLetter({ ...selectedLetter, content: e.target.value })\n                  }\n                  className=\"w-full text-xs text-slate-100 bg-slate-950 border border-slate-700 rounded-xl p-4 focus:outline-none focus:border-indigo-500 font-mono leading-relaxed\"\n                />\n              </div>\n            </div>\n          ) : (\n            <div className=\"p-12 text-center text-slate-500 text-xs bg-slate-900 rounded-2xl border border-slate-800\">\n              Select a cover letter on the left to preview and edit.\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
