  file_change {
    absolute_path_uri: "file:///server/services/emailService.ts"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import { db } from \'../db\';\nimport { AIService } from \'./aiService\';\nimport { TelegramService } from \'./telegramService\';\nimport { EmailEvent } from \'../../src/types\';\n\nexport class EmailService {\n  /**\n   * Ingest and classify incoming recruiter email text\n   */\n  static async processEmail(emailData: {\n    sender: string;\n    recipient: string;\n    subject: string;\n    body: string;\n  }): Promise<{ event: EmailEvent; classification: any }> {\n    const classification = await AIService.classifyEmail(emailData.subject, emailData.body);\n\n    const event: EmailEvent = {\n      id: `email_${Date.now()}_${Math.random().toString(36).substring(2, 6)}`,\n      sender: emailData.sender,\n      recipient: emailData.recipient,\n      subject: emailData.subject,\n      snippet: emailData.body.slice(0, 140) + \'...\',\n      fullBody: emailData.body,\n      receivedAt: new Date().toISOString(),\n      classification: classification.classification,\n      confidenceScore: classification.confidenceScore,\n      detectedCompany: classification.detectedCompany,\n      processed: true,\n    };\n\n    // Auto-update matched application status if found\n    if (classification.detectedCompany) {\n      const apps = db.getApplications();\n      const matchedApp = apps.find(\n        (a) =>\n          a.company.toLowerCase().includes(classification.detectedCompany.toLowerCase()) ||\n          classification.detectedCompany.toLowerCase().includes(a.company.toLowerCase())\n      );\n\n      if (matchedApp) {\n        event.matchedApplicationId = matchedApp.id;\n\n        if (classification.classification === \'INTERVIEW\') {\n          db.updateApplication(matchedApp.id, {\n            status: \'INTERVIEW\',\n            interviewDate: classification.suggestedAction?.includes(\'schedule\')\n              ? \'To be scheduled\'\n              : undefined,\n          });\n          event.actionTaken = `Updated ${matchedApp.company} application status to INTERVIEW`;\n\n          // Trigger Telegram Notification\n          await TelegramService.notifyInterviewDetected(\n            matchedApp.company,\n            matchedApp.jobTitle,\n            emailData.body\n          );\n        } else if (classification.classification === \'OFFER\') {\n          db.updateApplication(matchedApp.id, {\n            status: \'OFFER\',\n          });\n          event.actionTaken = `Updated ${matchedApp.company} application status to OFFER \360\237\216\211`;\n        } else if (classification.classification === \'REJECTION\') {\n          db.updateApplication(matchedApp.id, {\n            status: \'REJECTED\',\n            rejectionReason: classification.summary,\n          });\n          event.actionTaken = `Marked ${matchedApp.company} application as REJECTED`;\n\n          await TelegramService.notifyRejectionDetected(\n            matchedApp.company,\n            matchedApp.jobTitle\n          );\n        }\n      }\n    }\n\n    db.addEmail(event);\n    return { event, classification };\n  }\n\n  /**\n   * Helper simulator for recruiter replies\n   */\n  static async simulateRecruiterEmail(\n    type: \'interview\' | \'rejection\' | \'offer\' | \'status_update\',\n    customCompany?: string\n  ) {\n    const company = customCompany || \'StripeStack Technologies\';\n    const role = \'Senior Backend Engineer\';\n    let subject = \'\';\n    let body = \'\';\n\n    if (type === \'interview\') {\n      subject = `Interview Invitation: ${role} at ${company}`;\n      body = `Hi Alex,\n\nThank you for applying to the ${role} position at ${company}. \n\nWe were very impressed by your extensive experience with high-concurrency Node.js microservices and Redis distributed caching. We would love to invite you to a 45-minute technical screening call with our engineering team.\n\nPlease let us know your availability over the next few days:\n- Tuesday at 2:00 PM EST\n- Wednesday at 11:00 AM EST\n- Thursday at 4:00 PM EST\n\nLooking forward to speaking with you!\n\nBest regards,\nSarah Jenkins\nTechnical Talent Partner | ${company}`;\n    } else if (type === \'rejection\') {\n      subject = `Update on your application for ${role} at ${company}`;\n      body = `Dear Alex,\n\nThank you for your interest in ${company} and for taking the time to apply for the ${role} position.\n\nAfter careful consideration of your background and our current team requirements, we have decided to move forward with other candidates whose experience more closely aligns with our immediate domain needs.\n\nWe will keep your profile in our candidate pool for future opportunities that match your strong technical skills.\n\nWe wish you the best in your job search.\n\nSincerely,\n${company} Recruiting Team`;\n    } else if (type === \'offer\') {\n      subject = `Formal Offer of Employment: ${role} at ${company}!`;\n      body = `Dear Alex,\n\nOn behalf of ${company}, we are thrilled to offer you the position of ${role}!\n\nYour technical evaluation was stellar, and the team unanimously agreed you would be a fantastic addition to our engineering organization.\n\nOffer Summary:\n- Base Salary: $165,000 / year\n- Equity: Standard Stock Option Grant\n- Health & Wellness: Full Coverage\n- Remote Stipend: $1,500\n\nPlease let us know your planned start date by Friday.\n\nWarm congratulations!\nVP of Engineering | ${company}`;\n    } else {\n      subject = `Application Received: ${role} at ${company}`;\n      body = `Hello Alex,\n\nWe have received your application for the ${role} position. Our hiring team is currently reviewing your profile and will be in touch with next steps shortly.\n\nBest regards,\n${company} Careers`;\n    }\n\n    return this.processEmail({\n      sender: `careers@${company.toLowerCase().replace(/[^a-z0-9]/g, \'\')}.com`,\n      recipient: \'alex.morgan.dev@example.com\',\n      subject,\n      body,\n    });\n  }\n}"
      replacement_content: "import nodemailer from \'nodemailer\';\nimport { db } from \'../db\';\nimport { AIService } from \'./aiService\';\nimport { TelegramService } from \'./telegramService\';\nimport { EmailEvent, PreparedApplication } from \'../../src/types\';\n\nexport class EmailService {\n  /**\n   * Helper to send an outbound email via SMTP if configured, and always record in database\n   */\n  static async sendOutboundEmail(params: {\n    to: string;\n    subject: string;\n    text: string;\n    html?: string;\n  }): Promise<{ success: boolean; deliveredViaSmtp: boolean; message: string; event: EmailEvent }> {\n    const emailConfig = db.getEmailDispatchConfig();\n    const profile = db.getProfile();\n    let deliveredViaSmtp = false;\n    let transportError = \'\';\n\n    // Check if SMTP is configured\n    if (emailConfig.smtpUser && emailConfig.smtpPassword) {\n      try {\n        const transporter = nodemailer.createTransport({\n          host: emailConfig.smtpHost || \'smtp.gmail.com\',\n          port: emailConfig.smtpPort || 587,\n          secure: emailConfig.smtpPort === 465,\n          auth: {\n            user: emailConfig.smtpUser,\n            pass: emailConfig.smtpPassword,\n          },\n        });\n\n        await transporter.sendMail({\n          from: `\"${emailConfig.senderName || \'JobAgent AI\'}\" <${emailConfig.smtpUser}>`,\n          to: params.to,\n          subject: params.subject,\n          text: params.text,\n          html: params.html || params.text.replace(/\\n/g, \'<br/>\'),\n        });\n        deliveredViaSmtp = true;\n      } catch (err: any) {\n        console.warn(\'SMTP Send Failed, falling back to in-app stream:\', err.message);\n        transportError = err.message;\n      }\n    }\n\n    // Always create an EmailEvent in the local DB so it\'s visible in Email Monitor\n    const event: EmailEvent = {\n      id: `email_out_${Date.now()}_${Math.random().toString(36).substring(2, 6)}`,\n      sender: emailConfig.smtpUser || \'agent@jobagent.ai\',\n      recipient: params.to,\n      subject: params.subject,\n      snippet: params.text.slice(0, 150),\n      fullBody: params.html || params.text,\n      receivedAt: new Date().toISOString(),\n      classification: \'STATUS_UPDATE\',\n      confidenceScore: 100,\n      processed: true,\n      actionTaken: deliveredViaSmtp\n        ? \'Delivered directly to inbox via SMTP\'\n        : transportError\n        ? `Queued in-app (SMTP notice: ${transportError})`\n        : \'Dispatched via in-app email stream to \' + params.to,\n    };\n\n    db.addEmail(event);\n\n    return {\n      success: true,\n      deliveredViaSmtp,\n      message: deliveredViaSmtp\n        ? `Email successfully delivered to ${params.to} via Gmail SMTP!`\n        : `Email dispatched to ${params.to} and recorded in in-app stream. (To enable direct Gmail delivery, provide your Gmail App Password in Settings).`,\n      event,\n    };\n  }\n\n  /**\n   * Dispatches the 10:00 AM Morning Job Application Digest email to user\'s inbox\n   */\n  static async sendMorningEmailDigest(appliedApps: PreparedApplication[], targetRecipient?: string) {\n    const emailConfig = db.getEmailDispatchConfig();\n    const recipient = targetRecipient || emailConfig.recipientEmail || \'codepankaj84@gmail.com\';\n    const profile = db.getProfile();\n\n    const jobsHtmlList = appliedApps\n      .map(\n        (app, idx) => `\n        <tr style=\"border-bottom: 1px solid #334155;\">\n          <td style=\"padding: 12px; font-weight: bold; color: #f8fafc;\">${idx + 1}. ${app.company}</td>\n          <td style=\"padding: 12px; color: #cbd5e1;\">${app.jobTitle}</td>\n          <td style=\"padding: 12px; text-align: center;\">\n            <span style=\"background-color: #312e81; color: #a5b4fc; padding: 4px 8px; border-radius: 6px; font-weight: bold;\">\n              ${app.matchScore}%\n            </span>\n          </td>\n          <td style=\"padding: 12px; text-align: center;\">\n            <span style=\"background-color: #064e3b; color: #6ee7b7; padding: 4px 8px; border-radius: 6px; font-weight: bold;\">\n              ${app.status}\n            </span>\n          </td>\n          <td style=\"padding: 12px; text-align: center;\">\n            <a href=\"${app.applicationUrl}\" style=\"color: #6366f1; text-decoration: underline;\">View Role</a>\n          </td>\n        </tr>\n      `\n      )\n      .join(\'\');\n\n    const plainText = `\360\237\214\205 10:00 AM DAILY JOB APPLICATION DIGEST\nHello ${profile.name},\n\nHere is your morning report. The AI Job Search Agent has scanned live boards and applied to ${appliedApps.length} high-matching roles on your behalf:\n\n${appliedApps\n  .map(\n    (app, i) =>\n      `${i + 1}. ${app.company} - ${app.jobTitle} | Match: ${app.matchScore}% | Status: ${app.status}\\n   Apply URL: ${app.applicationUrl}`\n  )\n  .join(\'\\n\\n\')}\n\nNext scheduled scan: Tomorrow at 10:00 AM.\nBest regards,\nJobAgent AI`;\n\n    const html = `\n      <div style=\"font-family: Arial, sans-serif; max-width: 680px; margin: 0 auto; background-color: #0f172a; color: #e2e8f0; border-radius: 12px; padding: 24px; border: 1px solid #1e293b;\">\n        <div style=\"border-bottom: 1px solid #334155; padding-bottom: 16px; margin-bottom: 20px;\">\n          <h1 style=\"color: #6366f1; margin: 0 0 8px 0; font-size: 22px;\">\360\237\214\205 10:00 AM Job Application Digest</h1>\n          <p style=\"color: #94a3b8; margin: 0; font-size: 14px;\">Autonomous Daily Dispatch for <strong>${profile.name}</strong> (${recipient})</p>\n        </div>\n\n        <p style=\"font-size: 14px; line-height: 1.5; color: #cbd5e1;\">\n          Good morning! Your Autonomous Job Agent has completed today\'s morning cycle. Below are the <strong>${appliedApps.length} positions</strong> processed, verified against your candidate profile, and submitted:\n        </p>\n\n        <table style=\"width: 100%; border-collapse: collapse; margin: 20px 0; font-size: 13px; text-align: left;\">\n          <thead>\n            <tr style=\"background-color: #1e293b; color: #94a3b8;\">\n              <th style=\"padding: 10px 12px;\">Company</th>\n              <th style=\"padding: 10px 12px;\">Role</th>\n              <th style=\"padding: 10px 12px; text-align: center;\">Match</th>\n              <th style=\"padding: 10px 12px; text-align: center;\">Status</th>\n              <th style=\"padding: 10px 12px; text-align: center;\">Link</th>\n            </tr>\n          </thead>\n          <tbody>\n            ${jobsHtmlList}\n          </tbody>\n        </table>\n\n        <div style=\"background-color: #1e293b; padding: 14px; border-radius: 8px; margin-top: 20px;\">\n          <h3 style=\"margin: 0 0 6px 0; font-size: 14px; color: #f8fafc;\">\360\237\223\212 What Happens Next?</h3>\n          <p style=\"margin: 0; font-size: 12px; color: #94a3b8; line-height: 1.4;\">\n            \342\200\242 Recruiter replies will be automatically monitored and classified by the Email Monitor.<br/>\n            \342\200\242 Interview invitations will trigger instant push alerts to your linked Telegram chat.<br/>\n            \342\200\242 Next scheduled morning routine will run tomorrow at 10:00 AM.\n          </p>\n        </div>\n\n        <div style=\"margin-top: 24px; font-size: 11px; color: #64748b; text-align: center; border-top: 1px solid #334155; padding-top: 16px;\">\n          Sent by JobAgent Autonomous AI Engine \342\200\242 <a href=\"mailto:${recipient}\" style=\"color: #6366f1;\">${recipient}</a>\n        </div>\n      </div>\n    `;\n\n    return this.sendOutboundEmail({\n      to: recipient,\n      subject: `\360\237\214\205 10:00 AM Morning Job Digest: ${appliedApps.length} Applications Applied`,\n      text: plainText,\n      html,\n    });\n  }\n\n  /**\n   * Dispatches a quick test email to verify user\'s email configuration\n   */\n  static async sendTestEmail(recipientEmail: string) {\n    const profile = db.getProfile();\n    const text = `\360\237\232\200 JobAgent Email System Verified!\\n\\nHello ${profile.name},\\n\\nThis is a test notification confirming your email dispatch system is operational.\\nYour 10:00 AM daily job digest with at least 5 applied positions will be delivered to this address.\\n\\nTime: ${new Date().toLocaleString()}`;\n    const html = `\n      <div style=\"font-family: Arial, sans-serif; max-width: 550px; margin: 0 auto; background-color: #0f172a; color: #e2e8f0; border-radius: 12px; padding: 24px; border: 1px solid #1e293b;\">\n        <h2 style=\"color: #10b981; margin-top: 0;\">\360\237\232\200 Email System Test Verified!</h2>\n        <p style=\"color: #cbd5e1; font-size: 14px;\">\n          Hello <strong>${profile.name}</strong>,\n        </p>\n        <p style=\"color: #cbd5e1; font-size: 14px;\">\n          This test confirms that your JobAgent email dispatch pipeline is connected and operational for <strong>${recipientEmail}</strong>.\n        </p>\n        <div style=\"background-color: #1e293b; padding: 12px; border-radius: 8px; font-size: 13px; color: #94a3b8;\">\n          \342\217\260 <strong>Scheduled Routine:</strong> Every morning at 10:00 AM<br/>\n          \360\237\216\257 <strong>Batch Target:</strong> At least 5 high-match job applications<br/>\n          \360\237\223\261 <strong>Telegram Alerts:</strong> Active\n        </div>\n      </div>\n    `;\n\n    return this.sendOutboundEmail({\n      to: recipientEmail,\n      subject: \'\360\237\232\200 JobAgent AI: Email Dispatch Connection Test\',\n      text,\n      html,\n    });\n  }\n\n  /**\n   * Ingest and classify incoming recruiter email text\n   */\n  static async processEmail(emailData: {\n    sender: string;\n    recipient: string;\n    subject: string;\n    body: string;\n  }): Promise<{ event: EmailEvent; classification: any }> {\n    const classification = await AIService.classifyEmail(emailData.subject, emailData.body);\n\n    const event: EmailEvent = {\n      id: `email_${Date.now()}_${Math.random().toString(36).substring(2, 6)}`,\n      sender: emailData.sender,\n      recipient: emailData.recipient,\n      subject: emailData.subject,\n      snippet: emailData.body.slice(0, 140) + \'...\',\n      fullBody: emailData.body,\n      receivedAt: new Date().toISOString(),\n      classification: classification.classification,\n      confidenceScore: classification.confidenceScore,\n      detectedCompany: classification.detectedCompany,\n      processed: true,\n    };\n\n    // Auto-update matched application status if found\n    if (classification.detectedCompany) {\n      const apps = db.getApplications();\n      const matchedApp = apps.find(\n        (a) =>\n          a.company.toLowerCase().includes(classification.detectedCompany.toLowerCase()) ||\n          classification.detectedCompany.toLowerCase().includes(a.company.toLowerCase())\n      );\n\n      if (matchedApp) {\n        event.matchedApplicationId = matchedApp.id;\n\n        if (classification.classification === \'INTERVIEW\') {\n          db.updateApplication(matchedApp.id, {\n            status: \'INTERVIEW\',\n            interviewDate: classification.suggestedAction?.includes(\'schedule\')\n              ? \'To be scheduled\'\n              : undefined,\n          });\n          event.actionTaken = `Updated ${matchedApp.company} application status to INTERVIEW`;\n\n          // Trigger Telegram Notification\n          await TelegramService.notifyInterviewDetected(\n            matchedApp.company,\n            matchedApp.jobTitle,\n            emailData.body\n          );\n        } else if (classification.classification === \'OFFER\') {\n          db.updateApplication(matchedApp.id, {\n            status: \'OFFER\',\n          });\n          event.actionTaken = `Updated ${matchedApp.company} application status to OFFER \360\237\216\211`;\n        } else if (classification.classification === \'REJECTION\') {\n          db.updateApplication(matchedApp.id, {\n            status: \'REJECTED\',\n            rejectionReason: classification.summary,\n          });\n          event.actionTaken = `Marked ${matchedApp.company} application as REJECTED`;\n\n          await TelegramService.notifyRejectionDetected(\n            matchedApp.company,\n            matchedApp.jobTitle\n          );\n        }\n      }\n    }\n\n    db.addEmail(event);\n    return { event, classification };\n  }\n\n  /**\n   * Helper simulator for recruiter replies\n   */\n  static async simulateRecruiterEmail(\n    type: \'interview\' | \'rejection\' | \'offer\' | \'status_update\',\n    customCompany?: string\n  ) {\n    const company = customCompany || \'StripeStack Technologies\';\n    const role = \'Senior Backend Engineer\';\n    let subject = \'\';\n    let body = \'\';\n\n    if (type === \'interview\') {\n      subject = `Interview Invitation: ${role} at ${company}`;\n      body = `Hi Alex,\n\nThank you for applying to the ${role} position at ${company}. \n\nWe were very impressed by your extensive experience with high-concurrency Node.js microservices and Redis distributed caching. We would love to invite you to a 45-minute technical screening call with our engineering team.\n\nPlease let us know your availability over the next few days:\n- Tuesday at 2:00 PM EST\n- Wednesday at 11:00 AM EST\n- Thursday at 4:00 PM EST\n\nLooking forward to speaking with you!\n\nBest regards,\nSarah Jenkins\nTechnical Talent Partner | ${company}`;\n    } else if (type === \'rejection\') {\n      subject = `Update on your application for ${role} at ${company}`;\n      body = `Dear Alex,\n\nThank you for your interest in ${company} and for taking the time to apply for the ${role} position.\n\nAfter careful consideration of your background and our current team requirements, we have decided to move forward with other candidates whose experience more closely aligns with our immediate domain needs.\n\nWe will keep your profile in our candidate pool for future opportunities that match your strong technical skills.\n\nWe wish you the best in your job search.\n\nSincerely,\n${company} Recruiting Team`;\n    } else if (type === \'offer\') {\n      subject = `Formal Offer of Employment: ${role} at ${company}!`;\n      body = `Dear Alex,\n\nOn behalf of ${company}, we are thrilled to offer you the position of ${role}!\n\nYour technical evaluation was stellar, and the team unanimously agreed you would be a fantastic addition to our engineering organization.\n\nOffer Summary:\n- Base Salary: $165,000 / year\n- Equity: Standard Stock Option Grant\n- Health & Wellness: Full Coverage\n- Remote Stipend: $1,500\n\nPlease let us know your planned start date by Friday.\n\nWarm congratulations!\nVP of Engineering | ${company}`;\n    } else {\n      subject = `Application Received: ${role} at ${company}`;\n      body = `Hello Alex,\n\nWe have received your application for the ${role} position. Our hiring team is currently reviewing your profile and will be in touch with next steps shortly.\n\nBest regards,\n${company} Careers`;\n    }\n\n    return this.processEmail({\n      sender: `careers@${company.toLowerCase().replace(/[^a-z0-9]/g, \'\')}.com`,\n      recipient: \'codepankaj84@gmail.com\',\n      subject,\n      body,\n    });\n  }\n}"
    }
    instruction: "Enhance EmailService with sendMorningEmailDigest, sendTestEmail and SMTP dispatch"
  }
}
