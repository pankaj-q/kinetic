  file_change {
    absolute_path_uri: "file:///src/components/ProfileView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  FileText,\n  Upload,\n  Sparkles,\n  Save,\n  Plus,\n  Trash2,\n  CheckCircle2,\n  Building,\n  GraduationCap,\n  Briefcase,\n  DollarSign,\n  MapPin,\n  Shield,\n  Loader2\n} from \'lucide-react\';\nimport { CandidateProfile, WorkExperience, Education } from \'../types\';\n\ninterface ProfileViewProps {\n  profile: CandidateProfile;\n  onSaveProfile: (profile: CandidateProfile) => Promise<void>;\n  onParseResume: (resumeText: string) => Promise<void>;\n}\n\nexport const ProfileView: React.FC<ProfileViewProps> = ({\n  profile,\n  onSaveProfile,\n  onParseResume,\n}) => {\n  const [formData, setFormData] = useState<CandidateProfile>(profile);\n  const [resumeText, setResumeText] = useState(\'\');\n  const [isParsing, setIsParsing] = useState(false);\n  const [isSaving, setIsSaving] = useState(false);\n  const [saveSuccess, setSaveSuccess] = useState(false);\n  const [activeTab, setActiveTab] = useState<\'profile\' | \'experience\' | \'skills\' | \'preferences\'>(\'profile\');\n  const [newSkill, setNewSkill] = useState(\'\');\n  const [newRole, setNewRole] = useState(\'\');\n  const [newExcludedCompany, setNewExcludedCompany] = useState(\'\');\n\n  const handleSave = async () => {\n    setIsSaving(true);\n    try {\n      await onSaveProfile(formData);\n      setSaveSuccess(true);\n      setTimeout(() => setSaveSuccess(false), 3000);\n    } finally {\n      setIsSaving(false);\n    }\n  };\n\n  const handleParse = async () => {\n    if (!resumeText.trim()) return;\n    setIsParsing(true);\n    try {\n      await onParseResume(resumeText);\n    } finally {\n      setIsParsing(false);\n    }\n  };\n\n  const addSkill = () => {\n    if (newSkill.trim() && !formData.skills.includes(newSkill.trim())) {\n      setFormData((prev) => ({ ...prev, skills: [...prev.skills, newSkill.trim()] }));\n      setNewSkill(\'\');\n    }\n  };\n\n  const removeSkill = (skill: string) => {\n    setFormData((prev) => ({ ...prev, skills: prev.skills.filter((s) => s !== skill) }));\n  };\n\n  const addRole = () => {\n    if (newRole.trim() && !formData.preferredRoles.includes(newRole.trim())) {\n      setFormData((prev) => ({ ...prev, preferredRoles: [...prev.preferredRoles, newRole.trim()] }));\n      setNewRole(\'\');\n    }\n  };\n\n  const removeRole = (role: string) => {\n    setFormData((prev) => ({ ...prev, preferredRoles: prev.preferredRoles.filter((r) => r !== role) }));\n  };\n\n  const addExcludedCompany = () => {\n    if (newExcludedCompany.trim() && !formData.excludedCompanies?.includes(newExcludedCompany.trim())) {\n      setFormData((prev) => ({\n        ...prev,\n        excludedCompanies: [...(prev.excludedCompanies || []), newExcludedCompany.trim()],\n      }));\n      setNewExcludedCompany(\'\');\n    }\n  };\n\n  const removeExcludedCompany = (comp: string) => {\n    setFormData((prev) => ({\n      ...prev,\n      excludedCompanies: (prev.excludedCompanies || []).filter((c) => c !== comp),\n    }));\n  };\n\n  return (\n    <div className=\"space-y-6 animate-in fade-in duration-300\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <FileText className=\"w-5 h-5 text-indigo-400\" />\n            <h1 className=\"text-xl sm:text-2xl font-bold text-white tracking-tight\">\n              Candidate Profile & Resume Studio\n            </h1>\n          </div>\n          <p className=\"text-xs text-slate-400 mt-0.5\">\n            Your single source of truth for AI match evaluation and truthful cover letter synthesis.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          {saveSuccess && (\n            <span className=\"text-xs font-semibold text-emerald-400 flex items-center gap-1\">\n              <CheckCircle2 className=\"w-4 h-4\" />\n              Saved successfully\n            </span>\n          )}\n          <button\n            id=\"save-profile-btn\"\n            onClick={handleSave}\n            disabled={isSaving}\n            className=\"flex items-center gap-1.5 px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-md shadow-indigo-600/20 transition-all hover:scale-[1.02] active:scale-95 disabled:opacity-50\"\n          >\n            {isSaving ? <Loader2 className=\"w-3.5 h-3.5 animate-spin\" /> : <Save className=\"w-3.5 h-3.5\" />}\n            <span>{isSaving ? \'Saving Profile...\' : \'Save Profile Changes\'}</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Resume AI Parser Box */}\n      <div className=\"p-5 rounded-2xl bg-gradient-to-r from-slate-900 via-indigo-950/40 to-slate-900 border border-indigo-500/20 space-y-4\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <Sparkles className=\"w-4 h-4 text-indigo-400\" />\n            <h2 className=\"text-sm font-bold text-white\">AI Resume Extraction Engine</h2>\n          </div>\n          <span className=\"text-[11px] text-indigo-300\">Gemini 3.7 Structured Parser</span>\n        </div>\n\n        <p className=\"text-xs text-slate-300\">\n          Paste your raw resume text below. The AI will automatically extract work history, metrics, tech stack skills,\n          and career timelines into structured candidate fields.\n        </p>\n\n        <textarea\n          rows={3}\n          value={resumeText}\n          onChange={(e) => setResumeText(e.target.value)}\n          placeholder=\"Paste raw resume or LinkedIn text here (e.g. Alex Morgan, Senior Backend Engineer, 7+ years in Go/Node.js, AWS, Postgres, Kafka...)\"\n          className=\"w-full text-xs text-slate-200 bg-slate-950/80 border border-slate-700 rounded-xl p-3 focus:outline-none focus:border-indigo-500 font-mono\"\n        />\n\n        <div className=\"flex items-center justify-between\">\n          <span className=\"text-[11px] text-slate-500\">Extracts skills, titles, metrics, and experience automatically</span>\n          <button\n            onClick={handleParse}\n            disabled={isParsing || !resumeText.trim()}\n            className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold transition-colors disabled:opacity-50\"\n          >\n            {isParsing ? <Loader2 className=\"w-3.5 h-3.5 animate-spin\" /> : <Sparkles className=\"w-3.5 h-3.5\" />}\n            <span>{isParsing ? \'Parsing Resume...\' : \'Parse & Update Profile\'}</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Tabs */}\n      <div className=\"flex items-center gap-2 border-b border-slate-800 pb-1 overflow-x-auto\">\n        <button\n          onClick={() => setActiveTab(\'profile\')}\n          className={`py-2 px-3 text-xs font-bold rounded-lg transition-colors ${\n            activeTab === \'profile\'\n              ? \'bg-indigo-600/20 text-indigo-300 border border-indigo-500/30\'\n              : \'text-slate-400 hover:text-slate-200\'\n          }`}\n        >\n          Personal & Bio\n        </button>\n        <button\n          onClick={() => setActiveTab(\'experience\')}\n          className={`py-2 px-3 text-xs font-bold rounded-lg transition-colors ${\n            activeTab === \'experience\'\n              ? \'bg-indigo-600/20 text-indigo-300 border border-indigo-500/30\'\n              : \'text-slate-400 hover:text-slate-200\'\n          }`}\n        >\n          Work History ({formData.experience.length})\n        </button>\n        <button\n          onClick={() => setActiveTab(\'skills\')}\n          className={`py-2 px-3 text-xs font-bold rounded-lg transition-colors ${\n            activeTab === \'skills\'\n              ? \'bg-indigo-600/20 text-indigo-300 border border-indigo-500/30\'\n              : \'text-slate-400 hover:text-slate-200\'\n          }`}\n        >\n          Skills & Tech Stack ({formData.skills.length})\n        </button>\n        <button\n          onClick={() => setActiveTab(\'preferences\')}\n          className={`py-2 px-3 text-xs font-bold rounded-lg transition-colors ${\n            activeTab === \'preferences\'\n              ? \'bg-indigo-600/20 text-indigo-300 border border-indigo-500/30\'\n              : \'text-slate-400 hover:text-slate-200\'\n          }`}\n        >\n          Search Preferences & Salary\n        </button>\n      </div>\n\n      {/* Tab Contents */}\n      <div className=\"p-6 rounded-2xl bg-slate-900 border border-slate-800 space-y-6\">\n        {activeTab === \'profile\' && (\n          <div className=\"space-y-4\">\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n              <div>\n                <label className=\"text-xs font-bold text-slate-300 block mb-1\">Full Legal Name</label>\n                <input\n                  type=\"text\"\n                  value={formData.name}\n                  onChange={(e) => setFormData({ ...formData, name: e.target.value })}\n                  className=\"w-full text-xs text-slate-200 bg-slate-950 border border-slate-700 rounded-lg p-2.5 focus:outline-none focus:border-indigo-500\"\n                />\n              </div>\n\n              <div>\n                <label className=\"text-xs font-bold text-slate-300 block mb-1\">Email Address</label>\n                <input\n                  type=\"email\"\n                  value={formData.email}\n                  onChange={(e) => setFormData({ ...formData, email: e.target.value })}\n                  className=\"w-full text-xs text-slate-200 bg-slate-950 border border-slate-700 rounded-lg p-2.5 focus:outline-none focus:border-indigo-500\"\n                />\n              </div>\n\n              <div>\n                <label className=\"text-xs font-bold text-slate-300 block mb-1\">Phone Number</label>\n                <input\n                  type=\"tel\"\n                  value={formData.phone}\n                  onChange={(e) => setFormData({ ...formData, phone: e.target.value })}\n                  className=\"w-full text-xs text-slate-200 bg-slate-950 border border-slate-700 rounded-lg p-2.5 focus:outline-none focus:border-indigo-500\"\n                />\n              </div>\n\n              <div>\n                <label className=\"text-xs font-bold text-slate-300 block mb-1\">Current Location</label>\n                <input\n                  type=\"text\"\n                  value={formData.location}\n                  onChange={(e) => setFormData({ ...formData, location: e.target.value })}\n                  className=\"w-full text-xs text-slate-200 bg-slate-950 border border-slate-700 rounded-lg p-2.5 focus:outline-none focus:border-indigo-500\"\n                />\n              </div>\n\n              <div>\n                <label className=\"text-xs font-bold text-slate-300 block mb-1\">LinkedIn Profile URL</label>\n                <input\n                  type=\"text\"\n                  value={formData.linkedinUrl || \'\'}\n                  onChange={(e) => setFormData({ ...formData, linkedinUrl: e.target.value })}\n                  className=\"w-full text-xs text-slate-200 bg-slate-950 border border-slate-700 rounded-lg p-2.5 focus:outline-none focus:border-indigo-500\"\n                />\n              </div>\n\n              <div>\n                <label className=\"text-xs font-bold text-slate-300 block mb-1\">GitHub / Portfolio URL</label>\n                <input\n                  type=\"text\"\n                  value={formData.githubUrl || formData.portfolioUrl || \'\'}\n                  onChange={(e) => setFormData({ ...formData, githubUrl: e.target.value })}\n                  className=\"w-full text-xs text-slate-200 bg-slate-950 border border-slate-700 rounded-lg p-2.5 focus:outline-none focus:border-indigo-500\"\n                />\n              </div>\n            </div>\n\n            <div>\n              <label className=\"text-xs font-bold text-slate-300 block mb-1\">Professional Summary</label>\n              <textarea\n                rows={3}\n                value={formData.summary}\n                onChange={(e) => setFormData({ ...formData, summary: e.target.value })}\n                className=\"w-full text-xs text-slate-200 bg-slate-950 border border-slate-700 rounded-lg p-2.5 focus:outline-none focus:border-indigo-500 leading-relaxed\"\n              />\n            </div>\n          </div>\n        )}\n\n        {activeTab === \'experience\' && (\n          <div className=\"space-y-4\">\n            <div className=\"flex items-center justify-between\">\n              <h3 className=\"text-sm font-bold text-white\">Work History & Technical Milestones</h3>\n              <span className=\"text-xs text-slate-400\">{formData.yearsOfExperience} Years Experience</span>\n            </div>\n\n            <div className=\"space-y-4\">\n              {formData.experience.map((exp, idx) => (\n                <div key={exp.id || idx} className=\"p-4 rounded-xl bg-slate-950 border border-slate-800 space-y-2\">\n                  <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-1\">\n                    <div className=\"font-bold text-sm text-white\">{exp.role}</div>\n                    <span className=\"text-xs text-indigo-400 font-mono\">\n                      {exp.startDate} - {exp.current ? \'Present\' : exp.endDate}\n                    </span>\n                  </div>\n                  <div className=\"text-xs font-semibold text-slate-300 flex items-center gap-1\">\n                    <Building className=\"w-3.5 h-3.5 text-slate-500\" />\n                    <span>{exp.company}</span>\n                  </div>\n\n                  <ul className=\"list-disc list-inside text-xs text-slate-400 space-y-1 pt-1\">\n                    {exp.highlights.map((h, i) => (\n                      <li key={i} className=\"leading-relaxed\">\n                        {h}\n                      </li>\n                    ))}\n                  </ul>\n\n                  {exp.technologies && (\n                    <div className=\"flex items-center gap-1.5 flex-wrap pt-2 border-t border-slate-800/80\">\n                      {exp.technologies.map((t, i) => (\n                        <span key={i} className=\"px-2 py-0.5 rounded text-[10px] bg-slate-900 text-slate-300 border border-slate-800\">\n                          {t}\n                        </span>\n                      ))}\n                    </div>\n                  )}\n                </div>\n              ))}\n            </div>\n          </div>\n        )}\n\n        {activeTab === \'skills\' && (\n          <div className=\"space-y-4\">\n            <div className=\"flex items-center justify-between\">\n              <h3 className=\"text-sm font-bold text-white\">Verified Technical Skills & Tools</h3>\n              <span className=\"text-xs text-slate-400\">Used for AI job scoring</span>\n            </div>\n\n            <div className=\"flex items-center gap-2\">\n              <input\n                type=\"text\"\n                placeholder=\"Add skill (e.g. Rust, Kubernetes, GraphQL)...\"\n                value={newSkill}\n                onChange={(e) => setNewSkill(e.target.value)}\n                onKeyDown={(e) => e.key === \'Enter\' && addSkill()}\n                className=\"text-xs text-slate-200 bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 focus:outline-none focus:border-indigo-500 flex-1\"\n              />\n              <button\n                onClick={addSkill}\n                className=\"px-3 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold flex items-center gap-1\"\n              >\n                <Plus className=\"w-3.5 h-3.5\" />\n                <span>Add Skill</span>\n              </button>\n            </div>\n\n            <div className=\"flex items-center gap-2 flex-wrap pt-2\">\n              {formData.skills.map((skill, idx) => (\n                <span\n                  key={idx}\n                  className=\"px-3 py-1 rounded-lg text-xs font-semibold bg-slate-950 text-indigo-300 border border-indigo-500/30 flex items-center gap-1.5 shadow-sm\"\n                >\n                  <span>{skill}</span>\n                  <button\n                    onClick={() => removeSkill(skill)}\n                    className=\"text-slate-500 hover:text-rose-400 transition-colors\"\n                  >\n                    \303\227\n                  </button>\n                </span>\n              ))}\n            </div>\n          </div>\n        )}\n\n        {activeTab === \'preferences\' && (\n          <div className=\"space-y-6\">\n            {/* Preferred Target Roles */}\n            <div className=\"space-y-2\">\n              <label className=\"text-xs font-bold text-slate-300 block\">Target Job Titles</label>\n              <div className=\"flex items-center gap-2\">\n                <input\n                  type=\"text\"\n                  placeholder=\"Add target role (e.g. Senior Backend Engineer)...\"\n                  value={newRole}\n                  onChange={(e) => setNewRole(e.target.value)}\n                  onKeyDown={(e) => e.key === \'Enter\' && addRole()}\n                  className=\"text-xs text-slate-200 bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 focus:outline-none focus:border-indigo-500 flex-1\"\n                />\n                <button\n                  onClick={addRole}\n                  className=\"px-3 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold flex items-center gap-1\"\n                >\n                  <Plus className=\"w-3.5 h-3.5\" />\n                  <span>Add Role</span>\n                </button>\n              </div>\n\n              <div className=\"flex items-center gap-2 flex-wrap pt-1\">\n                {formData.preferredRoles.map((role, idx) => (\n                  <span\n                    key={idx}\n                    className=\"px-3 py-1 rounded-lg text-xs font-medium bg-slate-950 text-slate-200 border border-slate-800 flex items-center gap-1.5\"\n                  >\n                    <span>{role}</span>\n                    <button\n                      onClick={() => removeRole(role)}\n                      className=\"text-slate-500 hover:text-rose-400\"\n                    >\n                      \303\227\n                    </button>\n                  </span>\n                ))}\n              </div>\n            </div>\n\n            {/* Salary Preferences */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-slate-800\">\n              <div>\n                <label className=\"text-xs font-bold text-slate-300 block mb-1\">Target Minimum Salary (USD)</label>\n                <input\n                  type=\"number\"\n                  value={formData.salaryPreference.min || 135000}\n                  onChange={(e) =>\n                    setFormData({\n                      ...formData,\n                      salaryPreference: { ...formData.salaryPreference, min: Number(e.target.value) },\n                    })\n                  }\n                  className=\"w-full text-xs text-slate-200 bg-slate-950 border border-slate-700 rounded-lg p-2.5 focus:outline-none focus:border-indigo-500\"\n                />\n              </div>\n\n              <div>\n                <label className=\"text-xs font-bold text-slate-300 block mb-1\">Remote Preference</label>\n                <select\n                  value={formData.remotePreference}\n                  onChange={(e) => setFormData({ ...formData, remotePreference: e.target.value as any })}\n                  className=\"w-full text-xs text-slate-200 bg-slate-950 border border-slate-700 rounded-lg p-2.5 focus:outline-none focus:border-indigo-500\"\n                >\n                  <option value=\"remote_only\">Remote Only</option>\n                  <option value=\"hybrid\">Hybrid</option>\n                  <option value=\"onsite\">On-Site</option>\n                  <option value=\"flexible\">Flexible</option>\n                </select>\n              </div>\n            </div>\n\n            {/* Excluded Companies */}\n            <div className=\"space-y-2 pt-4 border-t border-slate-800\">\n              <label className=\"text-xs font-bold text-slate-300 block\">Excluded Companies (Blacklist)</label>\n              <div className=\"flex items-center gap-2\">\n                <input\n                  type=\"text\"\n                  placeholder=\"Add company to skip...\"\n                  value={newExcludedCompany}\n                  onChange={(e) => setNewExcludedCompany(e.target.value)}\n                  onKeyDown={(e) => e.key === \'Enter\' && addExcludedCompany()}\n                  className=\"text-xs text-slate-200 bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 focus:outline-none focus:border-indigo-500 flex-1\"\n                />\n                <button\n                  onClick={addExcludedCompany}\n                  className=\"px-3 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold flex items-center gap-1\"\n                >\n                  <Plus className=\"w-3.5 h-3.5\" />\n                  <span>Exclude</span>\n                </button>\n              </div>\n\n              <div className=\"flex items-center gap-2 flex-wrap pt-1\">\n                {(formData.excludedCompanies || []).map((comp, idx) => (\n                  <span\n                    key={idx}\n                    className=\"px-3 py-1 rounded-lg text-xs font-medium bg-rose-950/30 text-rose-300 border border-rose-800/40 flex items-center gap-1.5\"\n                  >\n                    <span>{comp}</span>\n                    <button\n                      onClick={() => removeExcludedCompany(comp)}\n                      className=\"text-rose-400 hover:text-rose-200\"\n                    >\n                      \303\227\n                    </button>\n                  </span>\n                ))}\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
