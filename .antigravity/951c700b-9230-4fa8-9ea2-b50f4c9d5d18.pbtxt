    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  Layers,\n  LayoutGrid,\n  List,\n  Search,\n  Filter,\n  Flame,\n  Building,\n  MapPin,\n  Clock,\n  CheckCircle2,\n  AlertCircle,\n  ExternalLink,\n  ChevronRight,\n  Sparkles,\n  Trash2\n} from \'lucide-react\';\nimport { PreparedApplication, ApplicationStatus } from \'../types\';\n\ninterface ApplicationsViewProps {\n  applications: PreparedApplication[];\n  onOpenApplication: (appId: string) => void;\n  onUpdateStatus: (appId: string, status: ApplicationStatus) => void;\n  onDeleteApplication: (appId: string) => void;\n  onNavigateTab: (tab: string) => void;\n}\n\nconst STAGES: { key: ApplicationStatus; label: string; color: string }[] = [\n  { key: \'WAITING_FOR_APPROVAL\', label: \'Waiting Approval\', color: \'border-amber-500/50 bg-amber-500/5 text-amber-400\' },\n  { key: \'APPLIED\', label: \'Applied\', color: \'border-blue-500/50 bg-blue-500/5 text-blue-400\' },\n  { key: \'SCREENING\', label: \'Screening\', color: \'border-cyan-500/50 bg-cyan-500/5 text-cyan-400\' },\n  { key: \'INTERVIEW\', label: \'Interview\', color: \'border-purple-500/50 bg-purple-500/5 text-purple-400\' },\n  { key: \'OFFER\', label: \'Offer\', color: \'border-emerald-500/50 bg-emerald-500/5 text-emerald-400\' },\n  { key: \'REJECTED\', label: \'Rejected\', color: \'border-rose-500/50 bg-rose-500/5 text-rose-400\' },\n];\n\nexport const ApplicationsView: React.FC<ApplicationsViewProps> = ({\n  applications,\n  onOpenApplication,\n  onUpdateStatus,\n  onDeleteApplication,\n  onNavigateTab,\n}) => {\n  const [viewMode, setViewMode] = useState<\'kanban\' | \'table\'>(\'kanban\');\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [statusFilter, setStatusFilter] = useState<string>(\'all\');\n\n  const filteredApps = applications.filter((app) => {\n    const matchesSearch =\n      app.company.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      app.jobTitle.toLowerCase().includes(searchQuery.toLowerCase());\n    const matchesStatus = statusFilter === \'all\' || app.status === statusFilter;\n    return matchesSearch && matchesStatus;\n  });\n\n  return (\n    <div className=\"space-y-6 animate-in fade-in duration-300\">\n      {/* Header & Controls */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <Layers className=\"w-5 h-5 text-indigo-400\" />\n            <h1 className=\"text-xl sm:text-2xl font-bold text-white tracking-tight\">Application Pipeline</h1>\n          </div>\n          <p className=\"text-xs text-slate-400 mt-0.5\">\n            Track applications from AI preparation through approval, interview stages, and offers.\n          </p>\n        </div>\n\n        {/* View Toggle & Search */}\n        <div className=\"flex items-center gap-2.5 flex-wrap\">\n          <div className=\"relative\">\n            <Search className=\"w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400\" />\n            <input\n              type=\"text\"\n              placeholder=\"Search company or title...\"\n              value={searchQuery}\n              onChange={(e) => setSearchQuery(e.target.value)}\n              className=\"pl-8 pr-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-indigo-500 w-48 sm:w-56\"\n            />\n          </div>\n\n          <div className=\"flex items-center bg-slate-900 border border-slate-800 rounded-lg p-0.5\">\n            <button\n              onClick={() => setViewMode(\'kanban\')}\n              className={`p-1.5 rounded-md text-xs font-semibold flex items-center gap-1 transition-colors ${\n                viewMode === \'kanban\' ? \'bg-indigo-600 text-white\' : \'text-slate-400 hover:text-slate-200\'\n              }`}\n              title=\"Kanban Board View\"\n            >\n              <LayoutGrid className=\"w-3.5 h-3.5\" />\n            </button>\n            <button\n              onClick={() => setViewMode(\'table\')}\n              className={`p-1.5 rounded-md text-xs font-semibold flex items-center gap-1 transition-colors ${\n                viewMode === \'table\' ? \'bg-indigo-600 text-white\' : \'text-slate-400 hover:text-slate-200\'\n              }`}\n              title=\"Table View\"\n            >\n              <List className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n\n          <button\n            onClick={() => onNavigateTab(\'jobs\')}\n            className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold shadow-sm transition-all\"\n          >\n            <Sparkles className=\"w-3.5 h-3.5\" />\n            <span>Discover More Jobs</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Kanban Board View */}\n      {viewMode === \'kanban\' ? (\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-3.5 overflow-x-auto pb-4\">\n          {STAGES.map((stage) => {\n            const stageApps = filteredApps.filter((a) => a.status === stage.key);\n            return (\n              <div\n                key={stage.key}\n                className=\"flex flex-col rounded-xl bg-slate-900/60 border border-slate-800/80 p-3 min-w-[240px] space-y-3\"\n              >\n                <div className=\"flex items-center justify-between pb-2 border-b border-slate-800\">\n                  <div className=\"flex items-center gap-1.5\">\n                    <span className={`text-xs font-bold ${stage.color.split(\' \')[2]}`}>{stage.label}</span>\n                  </div>\n                  <span className=\"px-1.5 py-0.5 rounded text-[10px] font-bold bg-slate-800 text-slate-300\">\n                    {stageApps.length}\n                  </span>\n                </div>\n\n                <div className=\"space-y-2.5 flex-1 overflow-y-auto max-h-[70vh]\">\n                  {stageApps.length === 0 ? (\n                    <div className=\"py-8 text-center text-slate-600 text-[11px]\">No applications</div>\n                  ) : (\n                    stageApps.map((app) => (\n                      <div\n                        key={app.id}\n                        onClick={() => onOpenApplication(app.id)}\n                        className={`p-3 rounded-xl border bg-slate-900 hover:border-indigo-500/50 cursor-pointer transition-all space-y-2 group shadow-sm ${\n                          app.status === \'WAITING_FOR_APPROVAL\'\n                            ? \'border-amber-500/40 bg-amber-950/10\'\n                            : \'border-slate-800\'\n                        }`}\n                      >\n                        <div className=\"flex items-start justify-between gap-1\">\n                          <h4 className=\"font-bold text-xs text-white group-hover:text-indigo-300 transition-colors line-clamp-1\">\n                            {app.jobTitle}\n                          </h4>\n                          <span\n                            className={`text-[10px] font-bold px-1.5 py-0.5 rounded ${\n                              app.matchScore >= 90\n                                ? \'bg-emerald-500/20 text-emerald-300\'\n                                : \'bg-indigo-500/20 text-indigo-300\'\n                            }`}\n                          >\n                            {app.matchScore}%\n                          </span>\n                        </div>\n\n                        <p className=\"text-[11px] text-slate-400 flex items-center gap-1\">\n                          <Building className=\"w-3 h-3 text-slate-500\" />\n                          <span>{app.company}</span>\n                        </p>\n\n                        {app.status === \'WAITING_FOR_APPROVAL\' && (\n                          <div className=\"pt-1\">\n                            <span className=\"block text-center py-1 rounded bg-amber-500/20 text-amber-300 text-[10px] font-bold border border-amber-500/30\">\n                              \342\232\240\357\270\217 Click to Approve & Submit\n                            </span>\n                          </div>\n                        )}\n\n                        {app.status === \'INTERVIEW\' && app.interviewDate && (\n                          <div className=\"pt-1 text-[10px] text-purple-300 font-mono flex items-center gap-1\">\n                            <Clock className=\"w-3 h-3\" />\n                            <span>{new Date(app.interviewDate).toLocaleDateString()}</span>\n                          </div>\n                        )}\n\n                        <div className=\"flex items-center justify-between pt-1 text-[10px] text-slate-500 border-t border-slate-800/80\">\n                          <span>{app.formFields.length} fields</span>\n                          <span>{new Date(app.updatedAt).toLocaleDateString([], { month: \'short\', day: \'numeric\' })}</span>\n                        </div>\n                      </div>\n                    ))\n                  )}\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      ) : (\n        /* Table View */\n        <div className=\"rounded-xl bg-slate-900 border border-slate-800 overflow-hidden shadow-sm\">\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-left text-xs text-slate-300\">\n              <thead className=\"bg-slate-950/80 border-b border-slate-800 text-[11px] text-slate-400 font-bold uppercase tracking-wider\">\n                <tr>\n                  <th className=\"py-3 px-4\">Role & Company</th>\n                  <th className=\"py-3 px-4\">Match Score</th>\n                  <th className=\"py-3 px-4\">Status</th>\n                  <th className=\"py-3 px-4\">Form Fields</th>\n                  <th className=\"py-3 px-4\">Updated</th>\n                  <th className=\"py-3 px-4 text-right\">Actions</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-slate-800\">\n                {filteredApps.map((app) => (\n                  <tr key={app.id} className=\"hover:bg-slate-800/50 transition-colors\">\n                    <td className=\"py-3 px-4\">\n                      <div className=\"font-bold text-white\">{app.jobTitle}</div>\n                      <div className=\"text-slate-400 text-[11px]\">{app.company}</div>\n                    </td>\n                    <td className=\"py-3 px-4\">\n                      <span className=\"px-2 py-0.5 rounded text-[11px] font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30\">\n                        {app.matchScore}%\n                      </span>\n                    </td>\n                    <td className=\"py-3 px-4\">\n                      <span\n                        className={`px-2.5 py-1 rounded-full text-[11px] font-bold ${\n                          app.status === \'APPLIED\'\n                            ? \'bg-blue-500/20 text-blue-300\'\n                            : app.status === \'WAITING_FOR_APPROVAL\'\n                            ? \'bg-amber-500/20 text-amber-300\'\n                            : app.status === \'INTERVIEW\'\n                            ? \'bg-purple-500/20 text-purple-300\'\n                            : app.status === \'OFFER\'\n                            ? \'bg-emerald-500/20 text-emerald-300\'\n                            : \'bg-slate-800 text-slate-300\'\n                        }`}\n                      >\n                        {app.status.replace(/_/g, \' \')}\n                      </span>\n                    </td>\n                    <td className=\"py-3 px-4 text-slate-400\">{app.formFields.length} inputs prepared</td>\n                    <td className=\"py-3 px-4 text-slate-400\">\n                      {new Date(app.updatedAt).toLocaleDateString()}\n                    </td>\n                    <td className=\"py-3 px-4 text-right\">\n                      <div className=\"flex items-center justify-end gap-2\">\n                        <button\n                          onClick={() => onOpenApplication(app.id)}\n                          className=\"px-2.5 py-1 rounded bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs transition-colors\"\n                        >\n                          Review\n                        </button>\n                        <button\n                          onClick={() => onDeleteApplication(app.id)}\n                          className=\"p-1 rounded text-slate-500 hover:text-rose-400 hover:bg-slate-800 transition-colors\"\n                          title=\"Delete Application\"\n                        >\n                          <Trash2 className=\"w-3.5 h-3.5\" />\n                        </button>\n                      </div>\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
