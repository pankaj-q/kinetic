          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const jobSkills = job.skillsRequired.map((s) => s.toLowerCase());"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const candidateSkills = profile.skills.map((s) => s.toLowerCase());"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const matching = job.skillsRequired.filter((s) => candidateSkills.includes(s.toLowerCase()));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const missing = job.skillsRequired.filter((s) => !candidateSkills.includes(s.toLowerCase()));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    let score = Math.round((matching.length / Math.max(1, job.skillsRequired.length)) * 70);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (job.remote && profile.remotePreference === \'remote\') score += 20;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (profile.yearsOfExperience >= (job.experienceRequiredYears || 2)) score += 10;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    score = Math.min(96, Math.max(20, score));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    let recommendation: MatchRecommendation = \'possible_match\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (score >= 90) recommendation = \'strong_match\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    else if (score >= 75) recommendation = \'good_match\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    else if (score >= 60) recommendation = \'possible_match\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    else recommendation = \'skip\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
