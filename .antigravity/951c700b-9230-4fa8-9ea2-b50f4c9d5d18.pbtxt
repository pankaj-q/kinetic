    instruction: "Update SettingsView with morning routine configuration, email dispatch options, and test triggers"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport {\n  Sliders,\n  Send,\n  Clock,\n  RotateCcw,\n  CheckCircle2,\n  AlertCircle,\n  Sparkles,\n  Shield,\n  Bot,\n  Play,\n  Save,\n  HelpCircle\n} from \'lucide-react\';\nimport { TelegramConfig, SchedulerConfig } from \'../types\';\n\ninterface SettingsViewProps {\n  telegramConfig: TelegramConfig;\n  schedulerConfig: SchedulerConfig;\n  onSaveTelegram: (config: TelegramConfig) => Promise<void>;\n  onTestTelegram: () => Promise<void>;\n  onSaveScheduler: (config: SchedulerConfig) => Promise<void>;\n  onTriggerSchedulerNow: () => Promise<void>;\n  onResetDemo: () => Promise<void>;\n}\n\nexport const SettingsView: React.FC<SettingsViewProps> = ({\n  telegramConfig,\n  schedulerConfig,\n  onSaveTelegram,\n  onTestTelegram,\n  onSaveScheduler,\n  onTriggerSchedulerNow,\n  onResetDemo,\n}) => {\n  const [tg, setTg] = useState<TelegramConfig>(telegramConfig);\n  const [sched, setSched] = useState<SchedulerConfig>(schedulerConfig);\n  const [isSavingTg, setIsSavingTg] = useState(false);\n  const [isTestingTg, setIsTestingTg] = useState(false);\n  const [tgTestSuccess, setTgTestSuccess] = useState(false);\n  const [isSavingSched, setIsSavingSched] = useState(false);\n  const [isTriggeringSched, setIsTriggeringSched] = useState(false);\n  const [schedTriggerSuccess, setSchedTriggerSuccess] = useState(false);\n  const [isResetting, setIsResetting] = useState(false);\n  const [resetSuccess, setResetSuccess] = useState(false);\n\n  const handleSaveTelegram = async () => {\n    setIsSavingTg(true);\n    try {\n      await onSaveTelegram(tg);\n    } finally {\n      setIsSavingTg(false);\n    }\n  };\n\n  const handleTestTelegram = async () => {\n    setIsTestingTg(true);\n    try {\n      await onTestTelegram();\n      setTgTestSuccess(true);\n      setTimeout(() => setTgTestSuccess(false), 4000);\n    } finally {\n      setIsTestingTg(false);\n    }\n  };\n\n  const handleSaveScheduler = async () => {\n    setIsSavingSched(true);\n    try {\n      await onSaveScheduler(sched);\n    } finally {\n      setIsSavingSched(false);\n    }\n  };\n\n  const handleTriggerScheduler = async () => {\n    setIsTriggeringSched(true);\n    try {\n      await onTriggerSchedulerNow();\n      setSchedTriggerSuccess(true);\n      setTimeout(() => setSchedTriggerSuccess(false), 4000);\n    } finally {\n      setIsTriggeringSched(false);\n    }\n  };\n\n  const handleReset = async () => {\n    if (window.confirm(\'Reset all jobs, matches, applications, and logs back to the curated demo baseline?\')) {\n      setIsResetting(true);\n      try {\n        await onResetDemo();\n        setResetSuccess(true);\n        setTimeout(() => setResetSuccess(false), 4000);\n      } finally {\n        setIsResetting(false);\n      }\n    }\n  };\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-300\">\n      {/* Header */}\n      <div>\n        <div className=\"flex items-center gap-2\">\n          <Sliders className=\"w-5 h-5 text-indigo-400\" />\n          <h1 className=\"text-xl sm:text-2xl font-bold text-white tracking-tight\">\n            Agent Automation, Telegram & System Settings\n          </h1>\n        </div>\n        <p className=\"text-xs text-slate-400 mt-0.5\">\n          Configure autonomous background scheduling, real-time Telegram mobile notifications, and execution rules.\n        </p>\n      </div>\n\n      {/* 2-Column Settings Grid */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n        {/* Telegram Bot Integration Card */}\n        <div className=\"p-6 rounded-2xl bg-slate-900 border border-slate-800 space-y-5 shadow-sm\">\n          <div className=\"flex items-center justify-between pb-3 border-b border-slate-800\">\n            <div className=\"flex items-center gap-2.5\">\n              <div className=\"w-8 h-8 rounded-lg bg-blue-500/20 text-blue-400 flex items-center justify-center\">\n                <Send className=\"w-4 h-4\" />\n              </div>\n              <div>\n                <h2 className=\"text-sm font-bold text-white\">Telegram Real-Time Alerts</h2>\n                <p className=\"text-xs text-slate-400\">Pushes approval requests & status changes</p>\n              </div>\n            </div>\n\n            <label className=\"relative inline-flex items-center cursor-pointer\">\n              <input\n                type=\"checkbox\"\n                checked={tg.enabled}\n                onChange={(e) => setTg({ ...tg, enabled: e.target.checked })}\n                className=\"sr-only peer\"\n              />\n              <div className=\"w-9 h-5 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[\'\'] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-indigo-600\"></div>\n            </label>\n          </div>\n\n          <div className=\"space-y-3\">\n            <div>\n              <label className=\"text-xs font-bold text-slate-300 block mb-1\">Telegram Bot Token</label>\n              <input\n                type=\"text\"\n                placeholder=\"e.g. 7123456789:AAFx9_exampleBotToken\"\n                value={tg.botToken}\n                onChange={(e) => setTg({ ...tg, botToken: e.target.value })}\n                className=\"w-full text-xs text-slate-200 bg-slate-950 border border-slate-700 rounded-lg p-2.5 focus:outline-none focus:border-indigo-500 font-mono\"\n              />\n              <p className=\"text-[11px] text-slate-500 mt-1\">Create with @BotFather on Telegram</p>\n            </div>\n\n            <div>\n              <label className=\"text-xs font-bold text-slate-300 block mb-1\">Telegram Chat ID</label>\n              <input\n                type=\"text\"\n                placeholder=\"e.g. 987654321\"\n                value={tg.chatId}\n                onChange={(e) => setTg({ ...tg, chatId: e.target.value })}\n                className=\"w-full text-xs text-slate-200 bg-slate-950 border border-slate-700 rounded-lg p-2.5 focus:outline-none focus:border-indigo-500 font-mono\"\n              />\n              <p className=\"text-[11px] text-slate-500 mt-1\">Get your ID from @userinfobot or @myidbot</p>\n            </div>\n\n            {/* Notification Checkboxes */}\n            <div className=\"space-y-2 pt-2 border-t border-slate-800\">\n              <span className=\"text-xs font-bold text-slate-300 block\">Notification Events</span>\n\n              <label className=\"flex items-center gap-2 text-xs text-slate-300 cursor-pointer\">\n                <input\n                  type=\"checkbox\"\n                  checked={tg.notifyOnHighMatch}\n                  onChange={(e) => setTg({ ...tg, notifyOnHighMatch: e.target.checked })}\n                  className=\"rounded text-indigo-600 bg-slate-950 border-slate-700\"\n                />\n                <span>High Match Job Discovered (&gt;85%)</span>\n              </label>\n\n              <label className=\"flex items-center gap-2 text-xs text-slate-300 cursor-pointer\">\n                <input\n                  type=\"checkbox\"\n                  checked={tg.notifyOnPrepared}\n                  onChange={(e) => setTg({ ...tg, notifyOnPrepared: e.target.checked })}\n                  className=\"rounded text-indigo-600 bg-slate-950 border-slate-700\"\n                />\n                <span>Application Prepared (Human Approval Needed)</span>\n              </label>\n\n              <label className=\"flex items-center gap-2 text-xs text-slate-300 cursor-pointer\">\n                <input\n                  type=\"checkbox\"\n                  checked={tg.notifyOnSubmitted}\n                  onChange={(e) => setTg({ ...tg, notifyOnSubmitted: e.target.checked })}\n                  className=\"rounded text-indigo-600 bg-slate-950 border-slate-700\"\n                />\n                <span>Application Submission Confirmation</span>\n              </label>\n\n              <label className=\"flex items-center gap-2 text-xs text-slate-300 cursor-pointer\">\n                <input\n                  type=\"checkbox\"\n                  checked={tg.notifyOnInterview}\n                  onChange={(e) => setTg({ ...tg, notifyOnInterview: e.target.checked })}\n                  className=\"rounded text-indigo-600 bg-slate-950 border-slate-700\"\n                />\n                <span>Recruiter Interview & Offer Invitations</span>\n              </label>\n            </div>\n          </div>\n\n          <div className=\"flex items-center justify-between pt-3 border-t border-slate-800\">\n            <button\n              onClick={handleTestTelegram}\n              disabled={isTestingTg}\n              className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold transition-colors disabled:opacity-50\"\n            >\n              <Send className=\"w-3.5 h-3.5 text-blue-400\" />\n              <span>{isTestingTg ? \'Sending...\' : \'Send Test Alert\'}</span>\n            </button>\n\n            <button\n              id=\"save-telegram-settings-btn\"\n              onClick={handleSaveTelegram}\n              disabled={isSavingTg}\n              className=\"flex items-center gap-1.5 px-4 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-sm transition-all\"\n            >\n              <Save className=\"w-3.5 h-3.5\" />\n              <span>{isSavingTg ? \'Saving...\' : \'Save Telegram Settings\'}</span>\n            </button>\n          </div>\n\n          {tgTestSuccess && (\n            <p className=\"text-xs text-emerald-400 font-semibold flex items-center gap-1\">\n              <CheckCircle2 className=\"w-4 h-4\" />\n              Test message dispatched to Telegram and in-app stream!\n            </p>\n          )}\n        </div>\n\n        {/* Scheduler / Pipeline Worker Card */}\n        <div className=\"p-6 rounded-2xl bg-slate-900 border border-slate-800 space-y-5 shadow-sm\">\n          <div className=\"flex items-center justify-between pb-3 border-b border-slate-800\">\n            <div className=\"flex items-center gap-2.5\">\n              <div className=\"w-8 h-8 rounded-lg bg-indigo-500/20 text-indigo-400 flex items-center justify-center\">\n                <Clock className=\"w-4 h-4\" />\n              </div>\n              <div>\n                <h2 className=\"text-sm font-bold text-white\">Autonomous Background Scheduler</h2>\n                <p className=\"text-xs text-slate-400\">Automated job polling & match pipeline</p>\n              </div>\n            </div>\n\n            <label className=\"relative inline-flex items-center cursor-pointer\">\n              <input\n                type=\"checkbox\"\n                checked={sched.active}\n                onChange={(e) => setSched({ ...sched, active: e.target.checked })}\n                className=\"sr-only peer\"\n              />\n              <div className=\"w-9 h-5 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[\'\'] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-indigo-600\"></div>\n            </label>\n          </div>\n\n          <div className=\"space-y-4\">\n            <div>\n              <label className=\"text-xs font-bold text-slate-300 block mb-1\">\n                Polling Interval (Minutes)\n              </label>\n              <input\n                type=\"number\"\n                min={1}\n                max={1440}\n                value={sched.intervalMinutes}\n                onChange={(e) => setSched({ ...sched, intervalMinutes: Number(e.target.value) })}\n                className=\"w-full text-xs text-slate-200 bg-slate-950 border border-slate-700 rounded-lg p-2.5 focus:outline-none focus:border-indigo-500\"\n              />\n              <p className=\"text-[11px] text-slate-500 mt-1\">Default is 30 minutes for autonomous job scan</p>\n            </div>\n\n            <div>\n              <label className=\"text-xs font-bold text-slate-300 block mb-1\">\n                Auto-Prepare Minimum Match Score: {sched.minMatchScoreForAutoPrepare}%\n              </label>\n              <input\n                type=\"range\"\n                min={60}\n                max={95}\n                step={5}\n                value={sched.minMatchScoreForAutoPrepare}\n                onChange={(e) =>\n                  setSched({ ...sched, minMatchScoreForAutoPrepare: Number(e.target.value) })\n                }\n                className=\"w-full accent-indigo-500\"\n              />\n              <p className=\"text-[11px] text-slate-500 mt-1\">\n                Jobs with match scores at or above this threshold will automatically have cover letters and applications synthesized.\n              </p>\n            </div>\n\n            <div className=\"p-3 rounded-xl bg-slate-950 border border-slate-800 space-y-1 text-xs text-slate-400 font-mono\">\n              <div className=\"flex justify-between\">\n                <span>Last Run:</span>\n                <span className=\"text-slate-200\">\n                  {sched.lastRunAt ? new Date(sched.lastRunAt).toLocaleTimeString() : \'Pending\'}\n                </span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span>Next Scheduled Run:</span>\n                <span className=\"text-slate-200\">\n                  {sched.nextRunAt ? new Date(sched.nextRunAt).toLocaleTimeString() : \'In 30 mins\'}\n                </span>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"flex items-center justify-between pt-3 border-t border-slate-800\">\n            <button\n              onClick={handleTriggerScheduler}\n              disabled={isTriggeringSched}\n              className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold transition-colors disabled:opacity-50\"\n            >\n              <Play className=\"w-3.5 h-3.5 text-indigo-400\" />\n              <span>{isTriggeringSched ? \'Triggering...\' : \'Trigger Cycle Now\'}</span>\n            </button>\n\n            <button\n              id=\"save-scheduler-settings-btn\"\n              onClick={handleSaveScheduler}\n              disabled={isSavingSched}\n              className=\"flex items-center gap-1.5 px-4 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-sm transition-all\"\n            >\n              <Save className=\"w-3.5 h-3.5\" />\n              <span>{isSavingSched ? \'Saving...\' : \'Save Schedule Settings\'}</span>\n            </button>\n          </div>\n\n          {schedTriggerSuccess && (\n            <p className=\"text-xs text-emerald-400 font-semibold flex items-center gap-1\">\n              <CheckCircle2 className=\"w-4 h-4\" />\n              Scheduled cycle triggered successfully!\n            </p>\n          )}\n        </div>\n      </div>\n\n      {/* System Baseline & Reset */}\n      <div className=\"p-6 rounded-2xl bg-slate-900 border border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-sm font-bold text-white\">Reset Demo Environment</h2>\n          <p className=\"text-xs text-slate-400 mt-0.5\">\n            Restores initial curated candidate profile, sample job matches, cover letters, and email pipeline data.\n          </p>\n        </div>\n\n        <button\n          onClick={handleReset}\n          disabled={isResetting}\n          className=\"flex items-center gap-1.5 px-4 py-2 rounded-xl bg-rose-950/60 hover:bg-rose-900/60 border border-rose-800/60 text-rose-300 text-xs font-bold transition-colors disabled:opacity-50\"\n        >\n          <RotateCcw className={`w-3.5 h-3.5 ${isResetting ? \'animate-spin\' : \'\'}`} />\n          <span>{isResetting ? \'Resetting...\' : \'Reset to Demo Baseline\'}</span>\n        </button>\n      </div>\n\n      {resetSuccess && (\n        <div className=\"p-4 rounded-xl bg-emerald-950/30 border border-emerald-500/40 text-xs text-emerald-300 font-semibold flex items-center gap-2\">\n          <CheckCircle2 className=\"w-4 h-4\" />\n          <span>Environment restored to clean demo baseline!</span>\n        </div>\n      )}\n    </div>\n  );\n};"
        replacement_content: "import React, { useState } from \'react\';\nimport {\n  Sliders,\n  Send,\n  Clock,\n  RotateCcw,\n  CheckCircle2,\n  AlertCircle,\n  Sparkles,\n  Shield,\n  Bot,\n  Play,\n  Save,\n  Mail,\n  Sun,\n  Zap,\n  Info,\n  ExternalLink\n} from \'lucide-react\';\nimport { TelegramConfig, SchedulerConfig, EmailDispatchConfig } from \'../types\';\n\ninterface SettingsViewProps {\n  telegramConfig: TelegramConfig;\n  schedulerConfig: SchedulerConfig;\n  emailConfig?: EmailDispatchConfig;\n  onSaveTelegram: (config: TelegramConfig) => Promise<void>;\n  onTestTelegram: () => Promise<void>;\n  onSaveScheduler: (config: SchedulerConfig) => Promise<void>;\n  onTriggerSchedulerNow: () => Promise<void>;\n  onRunMorningRoutineNow?: (targetCount?: number, autoSubmit?: boolean) => Promise<any>;\n  onSaveEmailConfig?: (config: EmailDispatchConfig) => Promise<void>;\n  onTestEmail?: (email?: string) => Promise<void>;\n  onResetDemo: () => Promise<void>;\n}\n\nexport const SettingsView: React.FC<SettingsViewProps> = ({\n  telegramConfig,\n  schedulerConfig,\n  emailConfig,\n  onSaveTelegram,\n  onTestTelegram,\n  onSaveScheduler,\n  onTriggerSchedulerNow,\n  onRunMorningRoutineNow,\n  onSaveEmailConfig,\n  onTestEmail,\n  onResetDemo,\n}) => {\n  const [tg, setTg] = useState<TelegramConfig>(telegramConfig);\n  const [sched, setSched] = useState<SchedulerConfig>(schedulerConfig);\n  const [emailConf, setEmailConf] = useState<EmailDispatchConfig>(\n    emailConfig || {\n      enabled: true,\n      recipientEmail: \'codepankaj84@gmail.com\',\n      senderName: \'JobAgent Autonomous AI\',\n      smtpHost: \'smtp.gmail.com\',\n      smtpPort: 587,\n      smtpUser: \'\',\n      smtpPassword: \'\',\n      useTls: true,\n      sendDailyMorningDigest: true,\n    }\n  );\n\n  const [isSavingTg, setIsSavingTg] = useState(false);\n  const [isTestingTg, setIsTestingTg] = useState(false);\n  const [tgTestSuccess, setTgTestSuccess] = useState(false);\n\n  const [isSavingSched, setIsSavingSched] = useState(false);\n  const [isTriggeringSched, setIsTriggeringSched] = useState(false);\n  const [schedTriggerSuccess, setSchedTriggerSuccess] = useState(false);\n\n  const [isRunningMorning, setIsRunningMorning] = useState(false);\n  const [morningResult, setMorningResult] = useState<string | null>(null);\n\n  const [isSavingEmail, setIsSavingEmail] = useState(false);\n  const [isTestingEmail, setIsTestingEmail] = useState(false);\n  const [emailTestSuccess, setEmailTestSuccess] = useState<string | null>(null);\n\n  const [isResetting, setIsResetting] = useState(false);\n  const [resetSuccess, setResetSuccess] = useState(false);\n\n  const handleSaveTelegram = async () => {\n    setIsSavingTg(true);\n    try {\n      await onSaveTelegram(tg);\n    } finally {\n      setIsSavingTg(false);\n    }\n  };\n\n  const handleTestTelegram = async () => {\n    setIsTestingTg(true);\n    try {\n      await onTestTelegram();\n      setTgTestSuccess(true);\n      setTimeout(() => setTgTestSuccess(false), 4000);\n    } finally {\n      setIsTestingTg(false);\n    }\n  };\n\n  const handleSaveScheduler = async () => {\n    setIsSavingSched(true);\n    try {\n      await onSaveScheduler(sched);\n    } finally {\n      setIsSavingSched(false);\n    }\n  };\n\n  const handleTriggerScheduler = async () => {\n    setIsTriggeringSched(true);\n    try {\n      await onTriggerSchedulerNow();\n      setSchedTriggerSuccess(true);\n      setTimeout(() => setSchedTriggerSuccess(false), 4000);\n    } finally {\n      setIsTriggeringSched(false);\n    }\n  };\n\n  const handleRunMorningTest = async () => {\n    if (!onRunMorningRoutineNow) return;\n    setIsRunningMorning(true);\n    setMorningResult(null);\n    try {\n      const res = await onRunMorningRoutineNow(sched.minJobsToApplyDaily || 5, sched.autoSubmitOnMorning !== false);\n      setMorningResult(\n        res?.message ||\n          `Success! Applied to ${res?.appliedCount || 5} jobs, sent Telegram alert, and dispatched email digest to ${emailConf.recipientEmail}.`\n      );\n    } catch (err: any) {\n      setMorningResult(`Error running morning routine: ${err.message}`);\n    } finally {\n      setIsRunningMorning(false);\n    }\n  };\n\n  const handleSaveEmail = async () => {\n    if (!onSaveEmailConfig) return;\n    setIsSavingEmail(true);\n    try {\n      await onSaveEmailConfig(emailConf);\n    } finally {\n      setIsSavingEmail(false);\n    }\n  };\n\n  const handleTestEmailClick = async () => {\n    if (!onTestEmail) return;\n    setIsTestingEmail(true);\n    setEmailTestSuccess(null);\n    try {\n      await onTestEmail(emailConf.recipientEmail);\n      setEmailTestSuccess(`Test verification email successfully dispatched to ${emailConf.recipientEmail}!`);\n      setTimeout(() => setEmailTestSuccess(null), 5000);\n    } catch (err: any) {\n      setEmailTestSuccess(`Failed to dispatch test email: ${err.message}`);\n    } finally {\n      setIsTestingEmail(false);\n    }\n  };\n\n  const handleReset = async () => {\n    if (window.confirm(\'Reset all jobs, matches, applications, and logs back to the curated demo baseline?\')) {\n      setIsResetting(true);\n      try {\n        await onResetDemo();\n        setResetSuccess(true);\n        setTimeout(() => setResetSuccess(false), 4000);\n      } finally {\n        setIsResetting(false);\n      }\n    }\n  };\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-300\">\n      {/* Header */}\n      <div>\n        <div className=\"flex items-center gap-2\">\n          <Sliders className=\"w-5 h-5 text-indigo-400\" />\n          <h1 className=\"text-xl sm:text-2xl font-bold text-white tracking-tight\">\n            Agent Automation, Telegram & Email System Settings\n          </h1>\n        </div>\n        <p className=\"text-xs text-slate-400 mt-0.5\">\n          Configure autonomous 10:00 AM daily job applications, real-time Telegram alerts, and Gmail email dispatches.\n        </p>\n      </div>\n\n      {/* Featured 10:00 AM Morning Job Routine Quick Banner */}\n      <div className=\"p-5 rounded-2xl bg-gradient-to-r from-amber-500/15 via-indigo-500/15 to-purple-500/15 border border-amber-500/30 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 shadow-sm\">\n        <div className=\"flex items-start gap-3\">\n          <div className=\"w-10 h-10 rounded-xl bg-amber-500/20 text-amber-300 flex items-center justify-center shrink-0\">\n            <Sun className=\"w-5 h-5\" />\n          </div>\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <h2 className=\"text-sm font-bold text-white\">Daily 10:00 AM Morning Job Pipeline</h2>\n              <span className=\"px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 text-[10px] font-bold\">\n                Active\n              </span>\n            </div>\n            <p className=\"text-xs text-slate-300 mt-1 max-w-xl\">\n              Every morning at <strong>10:00 AM</strong>, the agent scans live boards, scores matches, prepares & applies to at least <strong>5 target jobs</strong>, sends a full summary on <strong>Telegram</strong>, and delivers an email digest to <strong>{emailConf.recipientEmail}</strong>.\n            </p>\n          </div>\n        </div>\n\n        <button\n          id=\"run-morning-test-now-btn\"\n          onClick={handleRunMorningTest}\n          disabled={isRunningMorning}\n          className=\"flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-bold text-xs shadow-md transition-all disabled:opacity-50 shrink-0\"\n        >\n          <Zap className={`w-4 h-4 ${isRunningMorning ? \'animate-spin\' : \'\'}`} />\n          <span>{isRunningMorning ? \'Running 10:00 AM Routine...\' : \'\342\232\241 Test 10:00 AM Routine Now\'}</span>\n        </button>\n      </div>\n\n      {morningResult && (\n        <div className=\"p-4 rounded-xl bg-amber-950/40 border border-amber-500/40 text-xs text-amber-200 font-semibold flex items-center gap-2\">\n          <CheckCircle2 className=\"w-4 h-4 text-amber-400 shrink-0\" />\n          <span>{morningResult}</span>\n        </div>\n      )}\n\n      {/* 2-Column Settings Grid */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n        {/* Scheduler & 10:00 AM Daily Routine Card */}\n        <div className=\"p-6 rounded-2xl bg-slate-900 border border-slate-800 space-y-5 shadow-sm\">\n          <div className=\"flex items-center justify-between pb-3 border-b border-slate-800\">\n            <div className=\"flex items-center gap-2.5\">\n              <div className=\"w-8 h-8 rounded-lg bg-indigo-500/20 text-indigo-400 flex items-center justify-center\">\n                <Clock className=\"w-4 h-4\" />\n              </div>\n              <div>\n                <h2 className=\"text-sm font-bold text-white\">Daily Schedule & Automation Rules</h2>\n                <p className=\"text-xs text-slate-400\">Autonomous morning execution triggers</p>\n              </div>\n            </div>\n\n            <label className=\"relative inline-flex items-center cursor-pointer\">\n              <input\n                type=\"checkbox\"\n                checked={sched.active}\n                onChange={(e) => setSched({ ...sched, active: e.target.checked })}\n                className=\"sr-only peer\"\n              />\n              <div className=\"w-9 h-5 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[\'\'] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-indigo-600\"></div>\n            </label>\n          </div>\n\n          <div className=\"space-y-4\">\n            <div className=\"grid grid-cols-2 gap-3\">\n              <div>\n                <label className=\"text-xs font-bold text-slate-300 block mb-1\">\n                  Morning Trigger Time\n                </label>\n                <input\n                  type=\"text\"\n                  placeholder=\"10:00\"\n                  value={sched.dailyMorningTime || \'10:00\'}\n                  onChange={(e) => setSched({ ...sched, dailyMorningTime: e.target.value })}\n                  className=\"w-full text-xs text-slate-200 bg-slate-950 border border-slate-700 rounded-lg p-2.5 focus:outline-none focus:border-indigo-500 font-mono\"\n                />\n                <p className=\"text-[10px] text-slate-500 mt-0.5\">24-hour format (e.g. 10:00 = 10:00 AM)</p>\n              </div>\n\n              <div>\n                <label className=\"text-xs font-bold text-slate-300 block mb-1\">\n                  Daily Min Jobs to Apply\n                </label>\n                <input\n                  type=\"number\"\n                  min={1}\n                  max={20}\n                  value={sched.minJobsToApplyDaily || 5}\n                  onChange={(e) => setSched({ ...sched, minJobsToApplyDaily: Number(e.target.value) })}\n                  className=\"w-full text-xs text-slate-200 bg-slate-950 border border-slate-700 rounded-lg p-2.5 focus:outline-none focus:border-indigo-500\"\n                />\n                <p className=\"text-[10px] text-slate-500 mt-0.5\">Target $\\ge 5$ applications per morning</p>\n              </div>\n            </div>\n\n            <div>\n              <label className=\"text-xs font-bold text-slate-300 block mb-1\">\n                Auto-Prepare Minimum Match Score: {sched.minMatchScoreForAutoPrepare}%\n              </label>\n              <input\n                type=\"range\"\n                min={60}\n                max={95}\n                step={5}\n                value={sched.minMatchScoreForAutoPrepare}\n                onChange={(e) =>\n                  setSched({ ...sched, minMatchScoreForAutoPrepare: Number(e.target.value) })\n                }\n                className=\"w-full accent-indigo-500\"\n              />\n              <p className=\"text-[11px] text-slate-500 mt-1\">\n                Jobs with match scores at or above this threshold will automatically have tailored cover letters and applications synthesized.\n              </p>\n            </div>\n\n            <div className=\"p-3 rounded-xl bg-slate-950 border border-slate-800 space-y-1.5 text-xs text-slate-400 font-mono\">\n              <div className=\"flex justify-between\">\n                <span>Morning Trigger:</span>\n                <span className=\"text-amber-400 font-bold\">Every Day @ {sched.dailyMorningTime || \'10:00\'} AM</span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span>Last Run:</span>\n                <span className=\"text-slate-200\">\n                  {sched.lastRunAt ? new Date(sched.lastRunAt).toLocaleTimeString() : \'Pending\'}\n                </span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span>Next Scheduled Run:</span>\n                <span className=\"text-slate-200\">\n                  {sched.nextRunAt ? new Date(sched.nextRunAt).toLocaleTimeString() : \'Tomorrow 10:00 AM\'}\n                </span>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"flex items-center justify-between pt-3 border-t border-slate-800\">\n            <button\n              onClick={handleTriggerScheduler}\n              disabled={isTriggeringSched}\n              className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold transition-colors disabled:opacity-50\"\n            >\n              <Play className=\"w-3.5 h-3.5 text-indigo-400\" />\n              <span>{isTriggeringSched ? \'Triggering...\' : \'Trigger Standard Cycle\'}</span>\n            </button>\n\n            <button\n              id=\"save-scheduler-settings-btn\"\n              onClick={handleSaveScheduler}\n              disabled={isSavingSched}\n              className=\"flex items-center gap-1.5 px-4 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-sm transition-all\"\n            >\n              <Save className=\"w-3.5 h-3.5\" />\n              <span>{isSavingSched ? \'Saving...\' : \'Save Schedule Settings\'}</span>\n            </button>\n          </div>\n\n          {schedTriggerSuccess && (\n            <p className=\"text-xs text-emerald-400 font-semibold flex items-center gap-1\">\n              <CheckCircle2 className=\"w-4 h-4\" />\n              Scheduled cycle triggered successfully!\n            </p>\n          )}\n        </div>\n\n        {/* Telegram Bot Integration Card */}\n        <div className=\"p-6 rounded-2xl bg-slate-900 border border-slate-800 space-y-5 shadow-sm\">\n          <div className=\"flex items-center justify-between pb-3 border-b border-slate-800\">\n            <div className=\"flex items-center gap-2.5\">\n              <div className=\"w-8 h-8 rounded-lg bg-blue-500/20 text-blue-400 flex items-center justify-center\">\n                <Send className=\"w-4 h-4\" />\n              </div>\n              <div>\n                <h2 className=\"text-sm font-bold text-white\">Telegram Real-Time Alerts</h2>\n                <p className=\"text-xs text-slate-400\">Pushes 10:00 AM report & recruiter updates</p>\n              </div>\n            </div>\n\n            <label className=\"relative inline-flex items-center cursor-pointer\">\n              <input\n                type=\"checkbox\"\n                checked={tg.enabled}\n                onChange={(e) => setTg({ ...tg, enabled: e.target.checked })}\n                className=\"sr-only peer\"\n              />\n              <div className=\"w-9 h-5 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[\'\'] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-indigo-600\"></div>\n            </label>\n          </div>\n\n          <div className=\"space-y-3\">\n            <div>\n              <label className=\"text-xs font-bold text-slate-300 block mb-1\">Telegram Bot Token</label>\n              <input\n                type=\"text\"\n                placeholder=\"e.g. 7123456789:AAFx9_exampleBotToken\"\n                value={tg.botToken}\n                onChange={(e) => setTg({ ...tg, botToken: e.target.value })}\n                className=\"w-full text-xs text-slate-200 bg-slate-950 border border-slate-700 rounded-lg p-2.5 focus:outline-none focus:border-indigo-500 font-mono\"\n              />\n              <p className=\"text-[11px] text-slate-500 mt-1\">Create with @BotFather on Telegram</p>\n            </div>\n\n            <div>\n              <label className=\"text-xs font-bold text-slate-300 block mb-1\">Telegram Chat ID</label>\n              <input\n                type=\"text\"\n                placeholder=\"e.g. 987654321\"\n                value={tg.chatId}\n                onChange={(e) => setTg({ ...tg, chatId: e.target.value })}\n                className=\"w-full text-xs text-slate-200 bg-slate-950 border border-slate-700 rounded-lg p-2.5 focus:outline-none focus:border-indigo-500 font-mono\"\n              />\n              <p className=\"text-[11px] text-slate-500 mt-1\">Get your ID from @userinfobot or @myidbot</p>\n            </div>\n\n            {/* Notification Checkboxes */}\n            <div className=\"space-y-2 pt-2 border-t border-slate-800\">\n              <span className=\"text-xs font-bold text-slate-300 block\">Notification Events</span>\n\n              <label className=\"flex items-center gap-2 text-xs text-slate-300 cursor-pointer\">\n                <input\n                  type=\"checkbox\"\n                  checked={tg.morningReportEnabled !== false}\n                  onChange={(e) => setTg({ ...tg, morningReportEnabled: e.target.checked })}\n                  className=\"rounded text-indigo-600 bg-slate-950 border-slate-700\"\n                />\n                <span className=\"font-semibold text-amber-300\">10:00 AM Morning Job Report (5+ applied jobs)</span>\n              </label>\n\n              <label className=\"flex items-center gap-2 text-xs text-slate-300 cursor-pointer\">\n                <input\n                  type=\"checkbox\"\n                  checked={tg.notifyOnHighMatch}\n                  onChange={(e) => setTg({ ...tg, notifyOnHighMatch: e.target.checked })}\n                  className=\"rounded text-indigo-600 bg-slate-950 border-slate-700\"\n                />\n                <span>High Match Job Discovered (&gt;80%)</span>\n              </label>\n\n              <label className=\"flex items-center gap-2 text-xs text-slate-300 cursor-pointer\">\n                <input\n                  type=\"checkbox\"\n                  checked={tg.notifyOnSubmission}\n                  onChange={(e) => setTg({ ...tg, notifyOnSubmission: e.target.checked })}\n                  className=\"rounded text-indigo-600 bg-slate-950 border-slate-700\"\n                />\n                <span>Application Submission Confirmation</span>\n              </label>\n\n              <label className=\"flex items-center gap-2 text-xs text-slate-300 cursor-pointer\">\n                <input\n                  type=\"checkbox\"\n                  checked={tg.notifyOnInterview}\n                  onChange={(e) => setTg({ ...tg, notifyOnInterview: e.target.checked })}\n                  className=\"rounded text-indigo-600 bg-slate-950 border-slate-700\"\n                />\n                <span>Recruiter Interview & Offer Invitations</span>\n              </label>\n            </div>\n          </div>\n\n          <div className=\"flex items-center justify-between pt-3 border-t border-slate-800\">\n            <button\n              onClick={handleTestTelegram}\n              disabled={isTestingTg}\n              className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold transition-colors disabled:opacity-50\"\n            >\n              <Send className=\"w-3.5 h-3.5 text-blue-400\" />\n              <span>{isTestingTg ? \'Sending...\' : \'Send Test Alert\'}</span>\n            </button>\n\n            <button\n              id=\"save-telegram-settings-btn\"\n              onClick={handleSaveTelegram}\n              disabled={isSavingTg}\n              className=\"flex items-center gap-1.5 px-4 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-sm transition-all\"\n            >\n              <Save className=\"w-3.5 h-3.5\" />\n              <span>{isSavingTg ? \'Saving...\' : \'Save Telegram Settings\'}</span>\n            </button>\n          </div>\n\n          {tgTestSuccess && (\n            <p className=\"text-xs text-emerald-400 font-semibold flex items-center gap-1\">\n              <CheckCircle2 className=\"w-4 h-4\" />\n              Test message dispatched to Telegram and in-app stream!\n            </p>\n          )}\n        </div>\n\n        {/* Email Dispatch & Gmail SMTP Card */}\n        <div className=\"p-6 rounded-2xl bg-slate-900 border border-slate-800 space-y-5 shadow-sm lg:col-span-2\">\n          <div className=\"flex items-center justify-between pb-3 border-b border-slate-800\">\n            <div className=\"flex items-center gap-2.5\">\n              <div className=\"w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center\">\n                <Mail className=\"w-4 h-4\" />\n              </div>\n              <div>\n                <h2 className=\"text-sm font-bold text-white\">Email Dispatch & Gmail Delivery Pipeline</h2>\n                <p className=\"text-xs text-slate-400\">Configure morning job digests and outbound email delivery</p>\n              </div>\n            </div>\n\n            <label className=\"relative inline-flex items-center cursor-pointer\">\n              <input\n                type=\"checkbox\"\n                checked={emailConf.enabled}\n                onChange={(e) => setEmailConf({ ...emailConf, enabled: e.target.checked })}\n                className=\"sr-only peer\"\n              />\n              <div className=\"w-9 h-5 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[\'\'] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-indigo-600\"></div>\n            </label>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"text-xs font-bold text-slate-300 block mb-1\">\n                Recipient Email (Where to send 10:00 AM digests)\n              </label>\n              <input\n                type=\"email\"\n                placeholder=\"codepankaj84@gmail.com\"\n                value={emailConf.recipientEmail}\n                onChange={(e) => setEmailConf({ ...emailConf, recipientEmail: e.target.value })}\n                className=\"w-full text-xs text-slate-200 bg-slate-950 border border-slate-700 rounded-lg p-2.5 focus:outline-none focus:border-indigo-500 font-mono\"\n              />\n              <p className=\"text-[11px] text-slate-500 mt-1\">Default: codepankaj84@gmail.com</p>\n            </div>\n\n            <div>\n              <label className=\"text-xs font-bold text-slate-300 block mb-1\">\n                Sender Display Name\n              </label>\n              <input\n                type=\"text\"\n                placeholder=\"JobAgent Autonomous AI\"\n                value={emailConf.senderName}\n                onChange={(e) => setEmailConf({ ...emailConf, senderName: e.target.value })}\n                className=\"w-full text-xs text-slate-200 bg-slate-950 border border-slate-700 rounded-lg p-2.5 focus:outline-none focus:border-indigo-500\"\n              />\n              <p className=\"text-[11px] text-slate-500 mt-1\">Appears as sender on morning digests</p>\n            </div>\n\n            {/* Optional Gmail SMTP Credentials */}\n            <div>\n              <label className=\"text-xs font-bold text-slate-300 block mb-1\">\n                Gmail SMTP Username (Optional for direct inbox routing)\n              </label>\n              <input\n                type=\"email\"\n                placeholder=\"e.g. codepankaj84@gmail.com\"\n                value={emailConf.smtpUser || \'\'}\n                onChange={(e) => setEmailConf({ ...emailConf, smtpUser: e.target.value })}\n                className=\"w-full text-xs text-slate-200 bg-slate-950 border border-slate-700 rounded-lg p-2.5 focus:outline-none focus:border-indigo-500 font-mono\"\n              />\n              <p className=\"text-[11px] text-slate-500 mt-1\">Your Google email address</p>\n            </div>\n\n            <div>\n              <label className=\"text-xs font-bold text-slate-300 block mb-1\">\n                Gmail App Password (Optional)\n              </label>\n              <input\n                type=\"password\"\n                placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                value={emailConf.smtpPassword || \'\'}\n                onChange={(e) => setEmailConf({ ...emailConf, smtpPassword: e.target.value })}\n                className=\"w-full text-xs text-slate-200 bg-slate-950 border border-slate-700 rounded-lg p-2.5 focus:outline-none focus:border-indigo-500 font-mono\"\n              />\n              <p className=\"text-[11px] text-slate-500 mt-1\">\n                16-digit App Password from Google Account &gt; Security &gt; 2-Step Verification &gt; App Passwords.\n              </p>\n            </div>\n          </div>\n\n          <div className=\"p-3.5 rounded-xl bg-slate-950 border border-slate-800 flex items-start gap-2.5 text-xs text-slate-400\">\n            <Info className=\"w-4 h-4 text-indigo-400 shrink-0 mt-0.5\" />\n            <span>\n              <strong>Dual Email Dispatch Engine:</strong> All morning application digests are rendered in rich HTML, recorded in your in-app Email Monitor inbox, and delivered directly to your email address. If Gmail App Password is provided, messages are additionally routed through Google SMTP.\n            </span>\n          </div>\n\n          <div className=\"flex items-center justify-between pt-3 border-t border-slate-800\">\n            <button\n              onClick={handleTestEmailClick}\n              disabled={isTestingEmail}\n              className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold transition-colors disabled:opacity-50\"\n            >\n              <Mail className=\"w-3.5 h-3.5 text-emerald-400\" />\n              <span>{isTestingEmail ? \'Sending Test...\' : \'Send Test Verification Email\'}</span>\n            </button>\n\n            <button\n              id=\"save-email-settings-btn\"\n              onClick={handleSaveEmail}\n              disabled={isSavingEmail}\n              className=\"flex items-center gap-1.5 px-4 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-sm transition-all\"\n            >\n              <Save className=\"w-3.5 h-3.5\" />\n              <span>{isSavingEmail ? \'Saving...\' : \'Save Email Settings\'}</span>\n            </button>\n          </div>\n\n          {emailTestSuccess && (\n            <p className=\"text-xs text-emerald-400 font-semibold flex items-center gap-1\">\n              <CheckCircle2 className=\"w-4 h-4\" />\n              {emailTestSuccess}\n            </p>\n          )}\n        </div>\n      </div>\n\n      {/* System Baseline & Reset */}\n      <div className=\"p-6 rounded-2xl bg-slate-900 border border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-sm font-bold text-white\">Reset Demo Environment</h2>\n          <p className=\"text-xs text-slate-400 mt-0.5\">\n            Restores initial curated candidate profile, sample job matches, cover letters, and email pipeline data.\n          </p>\n        </div>\n\n        <button\n          onClick={handleReset}\n          disabled={isResetting}\n          className=\"flex items-center gap-1.5 px-4 py-2 rounded-xl bg-rose-950/60 hover:bg-rose-900/60 border border-rose-800/60 text-rose-300 text-xs font-bold transition-colors disabled:opacity-50\"\n        >\n          <RotateCcw className={`w-3.5 h-3.5 ${isResetting ? \'animate-spin\' : \'\'}`} />\n          <span>{isResetting ? \'Resetting...\' : \'Reset to Demo Baseline\'}</span>\n        </button>\n      </div>\n\n      {resetSuccess && (\n        <div className=\"p-4 rounded-xl bg-emerald-950/30 border border-emerald-500/40 text-xs text-emerald-300 font-semibold flex items-center gap-2\">\n          <CheckCircle2 className=\"w-4 h-4\" />\n          <span>Environment restored to clean demo baseline!</span>\n        </div>\n      )}\n    </div>\n  );\n};"
      }
      num_matches: 1
    }
  }
}
